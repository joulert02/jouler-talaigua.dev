---
// A case not built yet (HU-03): its route answers with this short page instead of a 404, until the case's own HU
// replaces it. The title shares `case-title-<slug>` with its row on Work (WorkList), so it morphs on the way in.
import Base from "@/layouts/Base.astro";
import WorkTag from "@/components/projects/WorkList/WorkTag/WorkTag.astro";
import CaseTop from "@/components/projects/case/CaseTop/CaseTop.astro";
import type { CollectionEntry } from "astro:content";
import { slugOf } from "@/lib/content";
import { useTranslations, type Lang } from "@/i18n/ui";
interface Props {
  lang: Lang;
  project: CollectionEntry<"projects">;
}
const { lang, project } = Astro.props;
const { data } = project;
const t = useTranslations(lang);
const slug = slugOf(project.id);
const tags = [
  ...(data.kind === "personal" ? [{ label: t("work.personal"), tone: "accent" as const }] : []),
  { label: data.label ?? t("work.coming"), tone: "muted" as const },
];
---

<Base
  title={`${data.title} | Jouler Talaigua`}
  description={data.summary}
  lang={lang}
  ogSlug="work"
  altPath={`/work/${slug}/`}
  dockHidden
>
  <CaseTop slot="top" slug={slug} />
  <article class="case-coming">
    <p class="case-coming__company" translate="no">
      {data.company}
    </p>
    <h1 class="case-coming__title" style={`view-transition-name: case-title-${slug}`}>
      {data.title}
    </h1>
    <p class="case-coming__tags">
      {tags.map((tag) => (
        <WorkTag tag={tag} />
      ))}
    </p>
    <p class="case-coming__summary">{data.summary}</p>
    <p class="case-coming__note">{t("work.comingNote")}</p>
  </article>
</Base>

<style>
  .case-coming {
    /* The case header's top space (v11 `.case-head`), less `.wrap`'s own padding above it. */
    padding-block: calc(clamp(28px, 6vw, 64px) - var(--wrap-padding-block)) 120px;
  }
  .case-coming__company {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
  }
  .case-coming__title {
    margin: 10px 0 var(--space-4);
    font: 500 clamp(36px, 5vw, 56px) / 1.08 var(--font-sans);
    letter-spacing: -0.04em;
  }
  .case-coming__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-6);
  }
  .case-coming__summary {
    max-width: var(--measure-prose);
    margin: 0 0 var(--space-4);
    color: var(--color-text-secondary);
    font-size: 18px;
    line-height: 1.6;
  }
  .case-coming__note {
    margin: 0;
    color: var(--color-text-muted);
  }
</style>
