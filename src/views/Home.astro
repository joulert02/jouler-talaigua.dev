---
import Base from "@/layouts/Base.astro";
import Board from "@/components/board/Board/Board.astro";
import { identity } from "@/config/profile";
import { useTranslations, type Lang } from "@/i18n/ui";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Base title={t("home.title")} description={identity.sentence[lang]} lang={lang}>
  <div class="home">
    <Board />
  </div>
  <!--
    The Home is the desk: it always opens at its top, on a first visit, a reload or Back from a page, never part way
    down to the footer where the browser last left it. Inline, so it runs before the first render.
  -->
  <script is:inline>
    (() => {
      history.scrollRestoration = "manual";
      const toTop = () => scrollY && scrollTo(0, 0);
      toTop();
      // Also once the slide back from a page ends, in case anything moved the page under it.
      addEventListener("pagereveal", (event) => {
        toTop();
        event.viewTransition?.finished.finally(toTop);
      });
      addEventListener("pageshow", toTop);
    })();
  </script>
</Base>
<style>
  /*
   * Mobile first: the card and the desk's way in (DeskEntry) center together in the screen above the Dock (80px); on a
   * short screen, taller than that space, they start at the top.
   */
  .home {
    display: grid;
    justify-items: center;
    align-items: start;
    align-content: safe center;
    padding-block: var(--space-4) 80px;
    /* Temporary, until the Work section lands: keeps the footer below the first screen, so the Dock shows on load. */
    /* Compensate for `.wrap`'s 1.5rem block padding. */
    min-height: calc(100svh - 3rem);
  }
  /* Tablet (561px to 900px): no top padding, as before. */
  @media (min-width: 561px) {
    .home {
      padding-top: 0;
    }
  }
  /* Desktop (901px and up): the desk fills the first screen, edge to edge (v11). */
  @media (min-width: 901px) {
    :global(html:has(.home)) {
      /* 100vw counts the scrollbar; clip the sliver it would add instead of scrolling sideways. */
      overflow-x: clip;
    }
    .home {
      display: block;
      /* The mobile grid's centering would shrink the board to nothing: newer browsers apply justify-items to block
         layout too, and the board's content is absolutely positioned. */
      place-items: normal;
      width: 100vw;
      height: 100svh;
      min-height: 0;
      padding: 0;
      /* Out of `.wrap`'s 44rem column and its 1.5rem top padding. */
      margin-inline: calc(50% - 50vw);
      margin-top: -1.5rem;
    }
  }
</style>
