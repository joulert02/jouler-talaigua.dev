---
import Base from "@/layouts/Base.astro";
import IdentityCard from "@/components/profile/IdentityCard/IdentityCard.astro";
import { identity } from "@/config/profile";
import { useTranslations, type Lang } from "@/i18n/ui";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Base title={t("home.title")} description={identity.sentence[lang]} lang={lang}>
  <div class="home">
    <IdentityCard />
  </div>
</Base>
<style>
  .home {
    display: grid;
    justify-items: center;
    padding-top: var(--space-4);
  }
</style>
