---
import Base from "@/layouts/Base.astro";
import { localePath, useTranslations, type Lang } from "@/i18n/ui";
import { getProjects, slugOf } from "@/lib/content";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const featured = (await getProjects(lang)).filter((p) => p.data.featured);
---

<Base title={t("home.title")} description={t("home.lead")} lang={lang}>
  <h1>{t("home.title")}</h1>
  <p class="muted">{t("home.lead")}</p>
  <ul>
    {featured.map((p) => (
      <li>
        <a href={localePath(lang, `/projects/${slugOf(p.id)}/`)}>{p.data.title}</a> —{" "}
        <span class="muted">{p.data.summary}</span>
      </li>
    ))}
  </ul>
</Base>
