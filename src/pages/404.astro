---
import Base from "@/layouts/Base.astro";
import NotFound from "@/components/layout/NotFound/NotFound.astro";
import { useTranslations } from "@/i18n/ui";

const t = useTranslations("en");
---

<Base
  robots="noindex"
  title={t("404.title")}
  description={t("404.message")}
  lang="en"
  altPath="/404/"
  dockHidden
>
  <NotFound lang="en" />
</Base>
