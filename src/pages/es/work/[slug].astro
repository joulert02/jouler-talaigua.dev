---
// Every case on Work answers at /work/<slug>/: a built case renders its MDX (WorkCase); one not built yet answers
// with a short "coming soon" page (WorkCaseComing) until its HU ships.
import WorkCase from "@/views/WorkCase.astro";
import WorkCaseComing from "@/views/WorkCaseComing.astro";
import { getProjects, slugOf } from "@/lib/content";
export async function getStaticPaths() {
  const projects = await getProjects("es");
  return projects.map((project) => ({ params: { slug: slugOf(project.id) }, props: { project } }));
}
const { project } = Astro.props;
---

{project.data.case === "live" ? (
  <WorkCase project={project} />
) : (
  <WorkCaseComing lang="es" project={project} />
)}
