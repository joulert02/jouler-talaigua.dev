---
import "@/styles/global.css";
import "@/styles/fonts.css";
import SkipLink from "@/components/layout/SkipLink/SkipLink.astro";
import Dock from "@/components/layout/Dock/Dock.astro";
import DockSeparator from "@/components/layout/Dock/DockSeparator/DockSeparator.astro";
import CopyEmail from "@/components/layout/CopyEmail/CopyEmail.astro";
import ThemeToggle from "@/components/layout/ThemeToggle/ThemeToggle.astro";
import Footer from "@/components/layout/Footer/Footer.astro";
import { navigation, type NavigationItem } from "@/config/navigation";
import { localePath, type Lang } from "@/i18n/ui";

interface Props {
  title: string;
  description: string;
  lang: Lang;
  ogSlug?: string;
  altPath?: string; // same page in the other language, without locale prefix
}
const { title, description, lang, ogSlug = "home", altPath = "/" } = Astro.props;
// The page language every component reads with getLang(Astro).
Astro.locals.lang = lang;
// Dock item of this page: home only on "/", the others on their section and its subpages.
const current = navigation.find((item: NavigationItem) =>
  item.href === "/" ? altPath === "/" : altPath.startsWith(item.href),
)?.id;
const other: Lang = lang === "en" ? "es" : "en";
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`/og/${lang}/${ogSlug}.png`, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={other} href={new URL(localePath(other, altPath), Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(localePath("en", altPath), Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "es_ES"} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>
      try {
        const s = localStorage.getItem("theme");
        const t = s ?? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.dataset.theme = t;
      } catch {
        /* no storage */
      }
    </script>
  </head>
  <body>
    <SkipLink />
    <div class="wrap">
      <main id="main" tabindex="-1">
        <slot />
      </main>
    </div>
    <Footer>
      <CopyEmail variant="text" slot="copy-email" />
    </Footer>
    <Dock items={navigation} {current} variant="labels" mobileVariant="active-label">
      <Fragment slot="actions">
        <DockSeparator />
        <CopyEmail />
        <ThemeToggle />
      </Fragment>
    </Dock>
  </body>
</html>
