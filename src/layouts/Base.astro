---
import "@/styles/global.css";
import "@/styles/fonts.css";
import SkipLink from "@/components/layout/SkipLink/SkipLink.astro";
import Dock from "@/components/layout/Dock/Dock.astro";
import DockSeparator from "@/components/layout/Dock/DockSeparator/DockSeparator.astro";
import CopyEmail from "@/components/layout/CopyEmail/CopyEmail.astro";
import ThemeToggle from "@/components/layout/ThemeToggle/ThemeToggle.astro";
import DockSettings from "@/components/layout/DockSettings/DockSettings.astro";
import Footer from "@/components/layout/Footer/Footer.astro";
import LanguageSwitch from "@/components/layout/LanguageSwitch/LanguageSwitch.astro";
import { navigation } from "@/config/navigation";
import { languageItems } from "@/config/profile";
import { localePath, type Lang } from "@/i18n/ui";
import { THEME_COOKIE } from "@/lib/theme.js";

interface Props {
  title: string;
  description: string;
  lang: Lang;
  ogSlug?: string;
  altPath?: string; // same page in the other language, without locale prefix
}
const { title, description, lang, ogSlug = "home", altPath = "/" } = Astro.props;
Astro.locals.lang = lang;
const current = navigation.find((item) =>
  item.href === "/" ? altPath === "/" : altPath.startsWith(item.href),
)?.id;
const languages = languageItems.map((item) => ({ ...item, href: localePath(item.lang, altPath) }));
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`/og/${lang}/${ogSlug}.png`, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {languages.map((item) => (
      <link rel="alternate" hreflang={item.lang} href={new URL(item.href, Astro.site)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(localePath("en", altPath), Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "es_ES"} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline define:vars={{ name: THEME_COOKIE }}>
      const theme = document.cookie.match(new RegExp(`(?:^|; )${name}=([^;]*)`))?.[1];
      if (theme) document.documentElement.dataset.theme = theme;
    </script>
  </head>
  <body>
    <SkipLink />
    <!-- Trial placement, to validate: the language pill at the top right, besides the Dock and the footer. -->
    <div class="top-language">
      <LanguageSwitch items={languages} />
    </div>
    <div class="wrap">
      <main id="main" tabindex="-1">
        <slot />
      </main>
    </div>
    <Footer>
      <CopyEmail variant="text" slot="copy-email" />
    </Footer>
    <Dock items={navigation} {current} variant="labels" mobileVariant="active-label">
      <Fragment slot="actions">
        <DockSeparator />
        <CopyEmail />
        <!-- Up to 560px the theme and the language move into the settings panel; above it, the toggle and the top pill. -->
        <span class="wide-only">
          <ThemeToggle />
        </span>
        <span class="narrow-only">
          <DockSettings languages={languages} />
        </span>
      </Fragment>
    </Dock>
  </body>
</html>
<style>
  /* Mobile first: phones get the settings gear; from 561px, the theme toggle and the top language pill. */
  .narrow-only {
    display: contents;
  }
  .wide-only,
  .top-language {
    display: none;
  }
  .top-language {
    position: absolute;
    top: var(--space-4);
    right: clamp(16px, 3vw, 40px);
    z-index: 20;
  }
  @media (min-width: 561px) {
    .narrow-only {
      display: none;
    }
    .wide-only {
      display: contents;
    }
    .top-language {
      display: block;
    }
  }
</style>
