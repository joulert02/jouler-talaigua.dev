---
import "@/styles/global.css";
import { Font } from "astro:assets";
import SkipLink from "@/components/layout/SkipLink/SkipLink.astro";
import Dock from "@/components/layout/Dock/Dock.astro";
import DockSeparator from "@/components/layout/Dock/DockSeparator/DockSeparator.astro";
import CopyEmail from "@/components/layout/CopyEmail/CopyEmail.astro";
import ThemeToggle from "@/components/layout/ThemeToggle/ThemeToggle.astro";
import DockSettings from "@/components/layout/DockSettings/DockSettings.astro";
import Footer from "@/components/layout/Footer/Footer.astro";
import ReturnHint from "@/components/layout/ReturnHint/ReturnHint.astro";
import LanguageSwitch from "@/components/layout/LanguageSwitch/LanguageSwitch.astro";
import { navigation } from "@/config/navigation";
import { identity, identityLinks, languageItems } from "@/config/profile";
import { localePath, useTranslations, type Lang } from "@/i18n/ui";
import { THEME_COOKIE } from "@/lib/theme.js";

interface Props {
  robots?: "noindex";
  title: string;
  description: string;
  lang: Lang;
  ogSlug?: string;
  altPath?: string; // same page in the other language, without locale prefix
  /** The page starts with the Dock away (a reading view such as "More about me"). */
  dockHidden?: boolean;
}
const { robots, title, description, lang, ogSlug = "home", altPath = "/", dockHidden = false } = Astro.props;
Astro.locals.lang = lang;
const current = navigation.find((item) =>
  item.href === "/" ? altPath === "/" : altPath.startsWith(item.href),
)?.id;
const t = useTranslations(lang);
// The Dock takes its links ready to show: label in this language, href with the locale prefix.
const dockItems = navigation.map(({ id, labelKey, href, icon }) => ({
  id,
  label: t(labelKey),
  href: localePath(lang, href),
  icon,
}));
const languages = languageItems.map((item) => ({ ...item, href: localePath(item.lang, altPath) }));
const canonical = new URL(Astro.url.pathname, Astro.site);
// Page transitions (the pagereveal script below): the Home in every language, and the pages the identity card morphs into.
const homePaths = languageItems.map((item) => localePath(item.lang, "/"));
const about = identityLinks.find((link) => link.label === "layout.about")?.href;
const morphPaths = about && typeof about === "object" ? Object.values(about) : [];
// A Cloudflare Pages preview (any branch but main) points its share image at its own deployment, so a pull request's
// images can be checked in LinkedIn's Post Inspector before they reach production. Canonical URLs stay on the site.
const { CF_PAGES_BRANCH, CF_PAGES_URL } = process.env;
const ogOrigin = CF_PAGES_URL && CF_PAGES_BRANCH !== "main" ? CF_PAGES_URL : Astro.site;
const ogImage = new URL(`/og/${lang}/${ogSlug}.png`, ogOrigin);
const ogLocale: Record<Lang, string> = { en: "en_US", es: "es_ES" };
---

<!doctype html>
<html lang={lang} data-dock-hidden={dockHidden ? "" : undefined}>
  <head>
    <meta charset="utf-8" />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" preload />
    <Font cssVariable="--font-hand" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    {!robots && (
      <>
        <link rel="canonical" href={canonical} />
        {languages.map((item) => (
          <link rel="alternate" hreflang={item.lang} href={new URL(item.href, Astro.site)} />
        ))}
        <link rel="alternate" hreflang="x-default" href={new URL(localePath("en", altPath), Astro.site)} />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={identity.brand.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!robots && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {languageItems
      .filter((item) => item.lang !== lang)
      .map((item) => (
        <meta property="og:locale:alternate" content={ogLocale[item.lang]} />
      ))}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline define:vars={{ name: THEME_COOKIE }}>
      const theme = document.cookie.match(new RegExp(`(?:^|; )${name}=([^;]*)`))?.[1];
      if (theme) document.documentElement.dataset.theme = theme;
    </script>
    <!--
      The page transitions' opt-in. Inline because Chromium can settle it before an external stylesheet is ready: with
      the rule there, a stylesheet that has to be revalidated cancels the transition ("ViewTransition opt-in disabled").
    -->
    <style is:inline>
      @media (prefers-reduced-motion: no-preference) {
        @view-transition {
          navigation: auto;
        }
      }
    </style>
    <!--
      Home ↔ pages (HU-02, v11): every page sits "below" the Home. Going from the Home to a page (the board's hand-off,
      the Dock, any link, Forward) slides the page in from below, as if the Home scrolled down to it; coming back to the
      Home slides it in from above. Between two other pages, or from the Home to itself, the default crossfade stays.
      "More about me" keeps its own transition: the identity card morphs into its card (global.css, profile-card).
      Inline in the head because `pagereveal` fires before deferred scripts run. The styles live in global.css. The
      paths are shared with the way back at the end of this layout.
    -->
    <script
      is:inline
      type="application/json"
      id="page-transitions"
      set:html={JSON.stringify({ homePaths, morphPaths })}
    />
    <script is:inline>
      addEventListener("pagereveal", (event) => {
        const { homePaths, morphPaths } = JSON.parse(document.getElementById("page-transitions").textContent);
        const transition = event.viewTransition;
        if (!transition) return;
        // Where the visitor comes from: the Navigation API knows for links, Back and Forward; without it, the referrer
        // covers links only (on Back and Forward it names an older page).
        const activation = window.navigation?.activation;
        const traversed = performance.getEntriesByType("navigation")[0]?.type === "back_forward";
        const from = activation ? activation.from?.url : traversed ? null : document.referrer;
        if (!from) return;
        const source = new URL(from);
        if (source.origin !== location.origin) return;
        const before = source.pathname;
        const after = location.pathname;
        if (before === after || morphPaths.includes(before) || morphPaths.includes(after)) return;
        const isHome = (path) => homePaths.includes(path);
        if (isHome(before) && !isHome(after)) transition.types.add("home-to-page");
        else if (!isHome(before) && isHome(after)) transition.types.add("page-to-home");
        else return;
        // While the slide plays, its overlay covers the page and takes the wheel, so a scroll (or the inertia of the
        // one that changed page) would move the page underneath: on the Home, part way down to the footer. The page
        // holds still until the slide ends and a moment after, for trackpad inertia.
        const hold = (wheel) => wheel.cancelable && !wheel.ctrlKey && wheel.preventDefault();
        addEventListener("wheel", hold, { passive: false });
        transition.finished.finally(() => setTimeout(() => removeEventListener("wheel", hold), 700));
      });
    </script>
  </head>
  <body>
    <SkipLink />
    {Astro.slots.has("top") ? (
      // A page with its own top bar (a case: back pill and language switch) replaces the language pill.
      <slot name="top" />
    ) : (
      // Trial placement, to validate: the language pill at the top right, besides the Dock and the footer.
      <div class="top-language">
        <LanguageSwitch items={languages} />
      </div>
    )}
    <ReturnHint />
    <div class="wrap">
      <main id="main" tabindex="-1">
        <slot />
      </main>
    </div>
    <!-- The Dock before the footer: it is fixed on screen, so only the Tab order follows, and after the footer the
         page ends. -->
    <Dock items={dockItems} label={t("dock.main")} {current} variant="labels" mobileVariant="active-label">
      <Fragment slot="actions">
        <DockSeparator />
        <CopyEmail />
        <!-- Up to 560px the theme and the language move into the settings panel; above it, the toggle and the top pill. -->
        <span class="wide-only">
          <ThemeToggle />
        </span>
        <span class="narrow-only">
          <DockSettings languages={languages} />
        </span>
      </Fragment>
    </Dock>
    <Footer>
      <CopyEmail variant="text" slot="copy-email" />
    </Footer>
  </body>
</html>
<script>
  // Way back to the Home (HU-02): on a page opened from the Home, scrolling up past the top pulls the ReturnHint pill
  // in and fills it, with the same resistance as the way down from the desk (src/lib/handoff.js); a full pull waits
  // for the Home to answer, then goes back, and the pagereveal script in the head plays the slide in reverse. Other
  // pages scroll as usual.
  import { followWheel, PULL_HOLD, returnsToHome, type Gesture } from "@/lib/handoff.js";

  const paths = JSON.parse(document.getElementById("page-transitions")?.textContent ?? "{}") as {
    homePaths?: string[];
    morphPaths?: string[];
  };
  const hint = document.querySelector<HTMLElement>(".return-hint");
  let gesture: Gesture | null = null;
  let leaving = false;
  let emptyLater = 0;

  /** Fills the pill to `progress` (0 to 1); it slides away once the pull pauses longer than PULL_HOLD. */
  function showPull(progress: number) {
    if (!hint) return;
    hint.style.setProperty("--return-hint-pull", String(progress));
    hint.toggleAttribute("data-visible", progress > 0);
    clearTimeout(emptyLater);
    emptyLater = window.setTimeout(() => {
      hint.removeAttribute("data-visible");
      hint.style.setProperty("--return-hint-pull", "0");
    }, PULL_HOLD);
  }

  /** Goes back once the Home answers (or after 2s at most), so the slide starts with the page ready. */
  async function goBack(home: string) {
    clearTimeout(emptyLater);
    hint?.setAttribute("data-visible", "");
    hint?.setAttribute("data-loading", "");
    await Promise.race([
      fetch(home, { priority: "high" }).catch(() => undefined),
      new Promise((resolve) => setTimeout(resolve, 2000)),
    ]);
    // Still leaving: a link followed meanwhile, then Back to this page, restarts it clean (arrive) without going back.
    if (leaving) history.back();
  }

  /**
   * The Home this page was opened from, if scrolling up goes back to it. Needs the Navigation API to see the previous
   * entry, as the reverse slide does; without it, pages scroll as usual.
   */
  function homeToReturnTo() {
    const nav = window.navigation;
    const index = nav?.currentEntry?.index ?? -1;
    const previous = index > 0 ? nav?.entries()[index - 1]?.url : null;
    const back = returnsToHome({
      previous: previous ? new URL(previous).pathname : undefined,
      current: location.pathname,
      homePaths: paths.homePaths ?? [],
      morphPaths: paths.morphPaths ?? [],
    });
    return back && previous ? previous : null;
  }

  /** A fresh arrival: no pull in progress. (The head script holds the page still while the slide plays.) */
  function arrive() {
    gesture = null;
    leaving = false;
    hint?.removeAttribute("data-visible");
    hint?.removeAttribute("data-loading");
    hint?.style.setProperty("--return-hint-pull", "0");
  }
  arrive();
  // Forward from the Home can restore this page from the back/forward cache: start clean.
  addEventListener("pageshow", (event) => event.persisted && arrive());

  addEventListener(
    "wheel",
    (event) => {
      // Pinch-zoom and sideways scrolls are not a way back.
      if (leaving || event.ctrlKey || Math.abs(event.deltaX) > Math.abs(event.deltaY)) return;
      const home = homeToReturnTo();
      if (!home) return;
      const unit =
        event.deltaMode === WheelEvent.DOM_DELTA_LINE
          ? 16
          : event.deltaMode === WheelEvent.DOM_DELTA_PAGE
            ? innerHeight
            : 1;
      const result = followWheel(gesture, {
        time: event.timeStamp,
        deltaY: event.deltaY * unit,
        atTop: scrollY <= 0,
      });
      gesture = result.gesture;
      if (!result.back) {
        // Scrolling back down at the top answers "no": the pill leaves at once.
        if (result.progress > 0 || hint?.hasAttribute("data-visible")) showPull(result.progress);
        return;
      }
      leaving = true;
      void goBack(home);
    },
    { passive: true },
  );
</script>
<style>
  /* Mobile first: phones get the settings gear; from 561px, the theme toggle and the top language pill. */
  .narrow-only {
    display: contents;
  }
  .wide-only,
  .top-language {
    display: none;
  }
  .top-language {
    position: absolute;
    top: var(--space-4);
    right: var(--page-gutter);
    z-index: 20;
  }
  @media (min-width: 561px) {
    .narrow-only {
      display: none;
    }
    .wide-only {
      display: contents;
    }
    .top-language {
      display: block;
    }
  }
</style>
