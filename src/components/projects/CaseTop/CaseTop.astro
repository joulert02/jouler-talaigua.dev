---
import BackPill from "../../layout/BackPill/BackPill.astro";
import LanguageSwitch from "../../layout/LanguageSwitch/LanguageSwitch.astro";
import { languageItems } from "../../../config/profile";
import { getLang, localePath, useTranslations } from "../../../i18n/ui";
interface Props {
  /** The case's slug: the pill goes back to its row on Work, the switch to the same case in the other language. */
  slug: string;
}
const { slug } = Astro.props;
const lang = getLang(Astro);
const t = useTranslations(lang);
const languages = languageItems.map((item) => ({ ...item, href: localePath(item.lang, `/work/${slug}/`) }));
---

<!--
  The case top bar (v11): sticky below 1320px (it scrolls away on wider screens), the back pill to the row the reader came from and the language switch; no Dock. Once
  the page scrolls, its hairline becomes a reading progress bar, and the case index (the default slot, CaseNav) shows
  as a pill between the two on screens too narrow for the index's margin rail. On phones the bar slides away while the
  reader scrolls down and comes back, with the index pill instead of the language switch, when they scroll up.
-->
<header class="case-top">
  <BackPill
    href={localePath(lang, `/work/#row-${slug}`)}
    label={t("work.back")}
    shortLabel={t("work.backShort")}
    caption={t("work.backCaption")}
  />
  <div class="case-top__end">
    <div class="case-top__index">
      <slot />
    </div>
    <div class="case-top__lang">
      <LanguageSwitch items={languages} />
    </div>
  </div>
</header>

<style>
  /*
   * Sticky over the page, as wide as the case. No side padding of its own: the body's already sets the page margin, so
   * the pill lines up with the content (v11). The blurred backdrop and the hairline reach the screen edges through that
   * margin.
   */
  .case-top {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    width: min(var(--layout-container), 100%);
    margin-inline: auto;
    padding: var(--space-4) 0 12px;
    /* Hiding and showing on phones: a smooth slide, gentle at both ends. */
    transition: translate 350ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .case-top::before {
    content: "";
    position: absolute;
    inset: 0 calc(-1 * var(--page-gutter));
    z-index: -1;
    background: color-mix(in srgb, var(--color-bg) 82%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-fast) var(--ease-out);
  }
  .case-top[data-stuck]::before {
    border-bottom-color: var(--color-border);
  }
  /* The reading progress: it fills the hairline from the left as the page scrolls, 0 at the top and 1 at the end. */
  .case-top::after {
    content: "";
    position: absolute;
    right: calc(-1 * var(--page-gutter));
    bottom: -1px;
    left: calc(-1 * var(--page-gutter));
    height: 2px;
    background: var(--color-accent);
    opacity: 0;
    scale: var(--case-top-progress, 0) 1;
    transform-origin: left center;
    transition:
      opacity var(--duration-fast) var(--ease-out),
      translate 350ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .case-top[data-stuck]::after {
    opacity: 1;
  }
  @supports (animation-timeline: scroll()) {
    .case-top::after {
      animation: case-top-progress linear both;
      animation-timeline: scroll(root block);
    }
  }
  @keyframes case-top-progress {
    from {
      scale: 0 1;
    }
    to {
      scale: 1 1;
    }
  }

  /*
   * The index pill and the language switch. Phones: both in the same place at the right edge, and the compact bar
   * crossfades from the switch to the pill (a slight scale and lift), so nothing in the layout moves. From 720px both
   * fit: the switch stays and the pill fades in centred in the space before it.
   */
  .case-top__end {
    display: grid;
    flex: 1;
    align-items: center;
    justify-items: end;
  }
  .case-top__index,
  .case-top__lang {
    grid-area: 1 / 1;
    transition:
      opacity var(--duration-medium) cubic-bezier(0.4, 0, 0.2, 1),
      scale var(--duration-medium) cubic-bezier(0.4, 0, 0.2, 1),
      translate var(--duration-medium) cubic-bezier(0.4, 0, 0.2, 1),
      visibility 0s linear var(--duration-medium);
  }
  /* Out of view: faded, a touch smaller and lower. In view: no transform at all, so the index's list can anchor to the bar. */
  .case-top__index,
  .case-top[data-compact] .case-top__lang {
    visibility: hidden;
    opacity: 0;
    scale: 0.94;
    translate: 0 4px;
  }
  .case-top[data-compact] .case-top__index,
  .case-top__lang {
    visibility: visible;
    opacity: 1;
    scale: none;
    translate: none;
    transition-delay: 0s;
  }
  @media (min-width: 720px) {
    .case-top__end {
      display: flex;
      justify-content: flex-end;
    }
    .case-top__index {
      margin-inline: auto;
    }
    .case-top[data-compact] .case-top__lang {
      visibility: visible;
      opacity: 1;
      scale: none;
      translate: none;
    }
  }
  /*
   * Wide screens (trial): the index is the rail in the margin, fixed on its own, so the bar keeps no place for it and
   * stops being sticky: it scrolls away with the page, without backdrop or hairline. Only the reading progress stays,
   * fixed to the top edge of the screen.
   */
  @media (min-width: 1320px) {
    .case-top__index,
    .case-top[data-compact] .case-top__index {
      display: contents;
    }
    .case-top__end {
      flex: none;
    }
    .case-top__index {
      visibility: visible;
      opacity: 1;
      scale: none;
      translate: none;
    }
    .case-top {
      position: relative;
    }
    .case-top::before {
      content: none;
    }
    .case-top::after {
      position: fixed;
      z-index: 30;
      top: 0;
      right: 0;
      bottom: auto;
      left: 0;
    }
  }

  /*
   * Phones: the bar slides away while scrolling down. The progress line slides the other way by the same easing, so it
   * travels up with the bar and docks at the top edge of the screen, and comes back down with it.
   */
  .case-top[data-hidden] {
    translate: 0 calc(-100% - 8px);
  }
  .case-top[data-hidden]::after {
    translate: 0 9px;
  }
  @media (prefers-reduced-motion: reduce) {
    .case-top,
    .case-top::before,
    .case-top::after,
    .case-top__index,
    .case-top__lang {
      transition: none;
    }
  }
</style>

<script>
  const top = document.querySelector<HTMLElement>(".case-top");
  if (top) {
    // Compact once the header of the case has scrolled away. On phones the bar also hides while the reader scrolls
    // down and returns when they scroll up, each only after a run in one direction (48px down, 24px up) so small
    // scrolls never make it flicker.
    const phone = matchMedia("(max-width: 719px)");
    const progress = !CSS.supports("animation-timeline", "scroll()");
    let turn = scrollY;
    let last = scrollY;
    let frame = 0;
    const sync = () => {
      const y = scrollY;
      if ((y > last && last < turn) || (y < last && last > turn)) turn = last;
      last = y;
      top.toggleAttribute("data-stuck", y > 8);
      // A keyboard user moving through the bar, or an open index, keeps it in place.
      const busy = top.querySelector(':focus-visible, [aria-expanded="true"]') !== null;
      let hidden = top.hasAttribute("data-hidden");
      if (!phone.matches || y <= 96 || busy) hidden = false;
      else if (y - turn > 48) hidden = true;
      else if (turn - y > 24) hidden = false;
      top.toggleAttribute("data-hidden", hidden);
      top.toggleAttribute("data-compact", y > 160);
      if (progress) {
        const end = document.documentElement.scrollHeight - innerHeight;
        top.style.setProperty("--case-top-progress", String(end > 0 ? Math.min(1, y / end) : 0));
      }
    };
    addEventListener(
      "scroll",
      () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(sync);
      },
      { passive: true },
    );
    sync();
  }
</script>
