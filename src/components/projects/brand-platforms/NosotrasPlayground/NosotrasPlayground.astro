<script>
  import { announce, followDevice, wait } from "../../case/ExampleFrame/frame";
  import { nosotrasCast, nosotrasWorlds, type NosotrasWorld } from "./nosotras.config";

  const reduce = () => matchMedia("(prefers-reduced-motion: reduce)").matches;
  /** Restarts the CSS animation keyed on `attribute`. */
  const replay = (element: HTMLElement, attribute: string) => {
    element.removeAttribute(attribute);
    void element.offsetWidth;
    element.setAttribute(attribute, "");
  };
  const isWorld = (value: string | undefined): value is NosotrasWorld =>
    nosotrasWorlds.includes(value as NosotrasWorld);

  for (const root of document.querySelectorAll<HTMLElement>("[data-nosotras]")) {
    const frame = root.querySelector(".example-frame");
    const site = root.querySelector<HTMLElement>(".nosotras-playground__site");
    const chip = root.querySelector<HTMLElement>(".nosotras-playground__chip");
    if (!frame || !site || !chip) continue;
    followDevice(frame, site, "nosotras-device");

    let chipTimer = 0;
    root.querySelectorAll(".nosotras-playground__play").forEach((button) =>
      button.addEventListener("click", () => {
        const text = root.dataset.play ?? "";
        chip.textContent = text;
        chip.setAttribute("data-show", "");
        announce(frame, text);
        clearTimeout(chipTimer);
        chipTimer = window.setTimeout(() => chip.removeAttribute("data-show"), 3500);
      }),
    );

    const desk = [
      ...root.querySelectorAll<HTMLElement>(".nosotras-playground__hero .nosotras-playground__char"),
    ];
    const phone = [
      ...root.querySelectorAll<HTMLElement>(".nosotras-playground__chars .nosotras-playground__char"),
    ];
    for (const button of [...desk, ...phone]) {
      button.addEventListener("animationend", (event) => {
        if (event.target === button) button.removeAttribute("data-arc");
        else button.removeAttribute(button.hasAttribute("data-in") ? "data-in" : "data-hop");
      });
    }
    const hop = (button: HTMLElement) => !reduce() && replay(button, "data-hop");

    const setWorld = (world: NosotrasWorld) => {
      const from = site.dataset.world;
      if (world === from) return;
      site.dataset.world = world;
      const order = Object.keys(nosotrasCast[world]);
      for (const button of desk) {
        const character = button.dataset.char;
        if (!isWorld(character)) continue;
        const [x, y, width] = nosotrasCast[world][character];
        const rank = order.indexOf(character);
        button.style.setProperty("--x", String(x));
        button.style.setProperty("--y", String(y));
        button.style.setProperty("--w", String(width));
        button.style.zIndex = String(3 - rank);
        button.setAttribute("aria-pressed", String(rank === 0));
        if (character === from && !reduce()) replay(button, "data-arc");
      }
      for (const button of phone) button.hidden = button.dataset.char !== world;
      const shown = phone.find((button) => !button.hidden);
      if (shown && !reduce()) replay(shown, "data-in");
      const name = desk.find((button) => button.dataset.char === world)?.getAttribute("aria-label") ?? world;
      announce(frame, (root.dataset.front ?? "%s").replace("%s", name));
    };

    desk.forEach((button) =>
      button.addEventListener("click", () => {
        const character = button.dataset.char;
        if (!isWorld(character)) return;
        if (site.dataset.world === character) hop(button);
        else setWorld(character);
      }),
    );
    phone.forEach((button) => button.addEventListener("click", () => hop(button)));
    const next = () => {
      const current = nosotrasWorlds.indexOf(site.dataset.world as NosotrasWorld);
      setWorld(nosotrasWorlds[(current + 1) % nosotrasWorlds.length] ?? nosotrasWorlds[0]);
    };
    root.querySelector(".nosotras-playground__next")?.addEventListener("click", next);

    // The scripted path: walk every world once, back to where it started.
    const tour = root.querySelector<HTMLElement>(".example-frame__actions button.button--primary");
    tour?.addEventListener("click", async () => {
      if (tour.getAttribute("aria-disabled") === "true") return;
      tour.setAttribute("aria-disabled", "true");
      for (let step = 0; step < nosotrasWorlds.length; step++) {
        next();
        await wait(1400);
      }
      tour.removeAttribute("aria-disabled");
    });
  }
</script>
