---
import Icon from "../../../ui/Icon/Icon.astro";
import { getLang } from "../../../../i18n/ui";
import { cloudCopy } from "./cloud.config";
const copy = cloudCopy[getLang(Astro)];
const [before, after] = copy.sides;
---

<!--
  GoodRx, chapter 02 (v11 `.byoc`): a still before/after, no interaction. Datadog on the left, groundcover on GoodRx's
  own cloud on the right, dashed as the new setup; on phones one above the other, the arrow pointing down.
-->
<figure class="cloud-figure" aria-label={copy.label}>
  {before && (
    <div class="cloud-figure__side">
      <p class="cloud-figure__title">{before.title}</p>
      <ul class="cloud-figure__points">
        {before.points.map((point) => (
          <li class="cloud-figure__point">{point}</li>
        ))}
      </ul>
    </div>
  )}
  <span class="cloud-figure__arrow" aria-hidden="true">
    <Icon name="arrow-down" size={18} />
  </span>
  {after && (
    <div class="cloud-figure__side cloud-figure__side--after">
      <p class="cloud-figure__title">{after.title}</p>
      <ul class="cloud-figure__points">
        {after.points.map((point) => (
          <li class="cloud-figure__point">{point}</li>
        ))}
      </ul>
    </div>
  )}
</figure>

<style>
  .cloud-figure {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    gap: 12px;
    margin: 8px 0 0;
  }
  .cloud-figure__side {
    justify-self: stretch;
    padding: 20px 24px;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    background: var(--color-surface);
  }
  .cloud-figure__side--after {
    border: 1.5px dashed var(--color-text-muted);
    background: transparent;
  }
  .cloud-figure__title {
    margin: 0;
    color: var(--color-text-muted);
    font: 500 var(--font-size-label) / 1.3 var(--font-mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .cloud-figure__points {
    display: grid;
    gap: 6px;
    margin: 12px 0 0;
    padding-left: 18px;
    color: var(--color-text);
  }
  .cloud-figure__arrow {
    display: inline-flex;
    color: var(--color-text-muted);
  }
  @media (min-width: 720px) {
    .cloud-figure {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      align-items: center;
      gap: 24px;
    }
    .cloud-figure__arrow {
      rotate: -90deg;
    }
  }
</style>
