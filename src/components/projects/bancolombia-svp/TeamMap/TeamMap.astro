---
import { getLang } from "../../../../i18n/ui";
import { teamMapCopy, type TeamRow } from "./teamMap.config";
const copy = teamMapCopy[getLang(Astro)];
const rows: readonly TeamRow[] = [copy.start, copy.grown, copy.across];
---

<!--
  Bancolombia · the team: how it grew, set in type. Three rows on the layout's quarters, the moment in the mono label
  column and what the team was then across the other three. Nothing to operate, so no frame: hairlines between rows,
  no boxes. Motion tells the story (owner rule "Flat to the eye, crafted in every detail"): when the map comes into
  view the rows rise in sequence and the team counts up from 1 to 20. Without JavaScript, or with reduced motion, it
  is simply there.
-->
<figure class="team-map" aria-label={copy.title} data-team-map>
  <dl class="team-map__rows">
    {rows.map((row) => (
      <div class="team-map__row" style={`--team-map-row: ${rows.indexOf(row)}`}>
        <dt class="team-map__label">{row.label}</dt>
        <dd class="team-map__body">
          <p class="team-map__value">
            {row.count !== undefined && (
              <span class="team-map__count" data-count-from={row.countFrom} data-count-to={row.count}>
                {row.count}
              </span>
            )}{" "}
            {row.value}
          </p>
          <p class="team-map__note">{row.note}</p>
        </dd>
      </div>
    ))}
  </dl>
</figure>

<script>
  // Arms only a map still below the fold, so nothing the reader already sees disappears; then reveals it once.
  const easeOut = (t: number) => 1 - (1 - t) ** 3;
  const countUp = (el: HTMLElement) => {
    const from = Number(el.dataset.countFrom);
    const to = Number(el.dataset.countTo);
    const start = performance.now() + 240; // after the second row starts rising
    const duration = 1100;
    const step = (now: number) => {
      const t = Math.min(1, Math.max(0, (now - start) / duration));
      el.textContent = String(Math.round(from + (to - from) * easeOut(t)));
      if (t < 1) requestAnimationFrame(step);
    };
    el.textContent = String(from);
    requestAnimationFrame(step);
  };
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
    for (const map of document.querySelectorAll<HTMLElement>("[data-team-map]")) {
      if (map.getBoundingClientRect().top < innerHeight) continue;
      map.dataset.armed = "";
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (!entry?.isIntersecting) return;
          observer.disconnect();
          map.dataset.shown = "";
          for (const count of map.querySelectorAll<HTMLElement>("[data-count-from]")) countUp(count);
        },
        { rootMargin: "0px 0px -20% 0px" },
      );
      observer.observe(map);
    }
  }
</script>

<style>
  .team-map {
    margin: var(--space-6) 0 0;
  }
  /* The reveal: each row rises 12px and fades in, 120ms after the one above. */
  .team-map[data-armed] .team-map__row {
    opacity: 0;
    translate: 0 12px;
    transition:
      opacity var(--duration-slow) var(--ease-out),
      translate var(--duration-slow) var(--ease-out);
    transition-delay: calc(var(--team-map-row) * 120ms);
  }
  .team-map[data-shown] .team-map__row {
    opacity: 1;
    translate: none;
  }
  .team-map__count {
    font-variant-numeric: tabular-nums;
  }
  /* A counting number keeps the width of its final value, so the words after it never move. */
  .team-map__count[data-count-from] {
    display: inline-block;
    min-width: 2ch;
    text-align: right;
  }
  /* No closing rule: the FullStory's hairline, or the next step's, closes it. */
  .team-map__rows {
    margin: 0;
  }
  .team-map__row {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-border);
  }
  .team-map__label {
    color: var(--color-text-muted);
    font: 500 var(--font-size-label) / 1.3 var(--font-mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .team-map__body {
    margin: 0;
  }
  .team-map__value {
    margin: 0;
    font-size: clamp(22px, 2.4vw, 28px);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .team-map__note {
    max-width: var(--measure-prose);
    margin: var(--space-2) 0 0;
    color: var(--color-text-secondary);
    font-size: clamp(16px, 1.4vw, 18px);
    line-height: 1.55;
  }
  /* The layout's quarters: the label in the first, the rest across the other three. */
  @media (min-width: 720px) {
    .team-map__row {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: var(--layout-gap);
      padding-block: var(--space-7);
    }
    .team-map__label {
      padding-top: 8px;
    }
    .team-map__body {
      grid-column: 2 / -1;
    }
  }
</style>
