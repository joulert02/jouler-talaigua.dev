---
import { getLang, useTranslations } from "../../../../../i18n/ui";
const t = useTranslations(getLang(Astro));
---

<!-- "The full story" (v11 `.more`): a disclosure under a chapter's interactive piece with its approved paragraphs, unchanged. -->
<details class="full-story">
  <summary class="full-story__summary">{t("case.fullStory")}</summary>
  <div class="full-story__body">
    <slot />
  </div>
</details>

<style>
  .full-story {
    max-width: var(--measure-prose);
    margin-top: 28px;
    border-top: 1px solid var(--color-border);
  }
  .full-story__summary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    color: var(--color-text);
    font-size: var(--font-size-small);
    font-weight: 500;
    list-style: none;
    cursor: pointer;
  }
  .full-story__summary::-webkit-details-marker {
    display: none;
  }
  .full-story__summary::before {
    content: "+";
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    color: var(--color-text-secondary);
    font: 500 15px / 1 var(--font-mono);
  }
  .full-story[open] .full-story__summary::before {
    content: "\2212";
  }
  .full-story__summary:focus-visible {
    outline: 2px solid var(--color-text-accent);
    outline-offset: 4px;
    border-radius: 6px;
  }
  .full-story__body {
    --case-paragraph-color: var(--color-text-secondary);
    padding: 4px 0 8px;
  }
  @media (hover: hover) {
    .full-story__summary:hover {
      color: var(--color-text-accent);
    }
  }
</style>
