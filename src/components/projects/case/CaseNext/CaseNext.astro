---
import { getLang, useTranslations } from "../../../../i18n/ui";
import type { CaseLink } from "./types";
interface Props {
  /** The case before this one on Work. */
  previous: CaseLink;
  /** The case after it. */
  next: CaseLink;
}
const { previous, next } = Astro.props;
const t = useTranslations(getLang(Astro));
// The narrow nav's name: the shorter of the case's title and its company ("GoodRx", "CAPS+").
const short = (link: CaseLink) => (link.title.length <= link.company.length ? link.title : link.company);
---

<!--
  The end of a case: the previous and the next case on Work, one in each half of the layout, then the footer. A band
  between two hairlines at every width, its own on top and the footer's under it, with the same space inside as the
  footer (owner review, 2026-11-23). When the nav is too narrow for both titles, each shows a short name instead.
-->
<nav class="case-next" aria-label={t("case.more")}>
  <div class="case-next__links">
    <a class="case-next__link" href={previous.href}>
      <span class="case-next__label">
        {t("case.previous")}
        <span class="case-next__company"> · {previous.company}</span>
      </span>
      <b class="case-next__title">
        ← <span class="case-next__name">{previous.title}</span>
        <span class="case-next__name case-next__name--short">{short(previous)}</span>
      </b>
    </a>
    <a class="case-next__link case-next__link--next" href={next.href}>
      <span class="case-next__label">
        {t("case.next")}
        <span class="case-next__company"> · {next.company}</span>
      </span>
      <b class="case-next__title">
        <span class="case-next__name">{next.title}</span>
        <span class="case-next__name case-next__name--short">{short(next)}</span> →
      </b>
    </a>
  </div>
</nav>

<style>
  .case-next {
    container: case-next / inline-size;
    margin-top: var(--space-10);
    border-top: 1px solid var(--color-border);
  }
  /*
   * The layout's halves, with its gap: "Next" ends on the right edge and the footer's Contact column starts where the
   * right half does. Narrow: a short name in place of the title; display: none keeps the hidden text unread.
   */
  .case-next__links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--layout-gap);
  }
  .case-next__link {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-8) 0;
    color: var(--color-text);
    text-decoration: none;
  }
  .case-next__link--next {
    text-align: right;
  }
  .case-next__company,
  .case-next__name:not(.case-next__name--short) {
    display: none;
  }
  .case-next__link:focus-visible {
    outline: 2px solid var(--color-text-accent);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }
  .case-next__label {
    color: var(--color-text-muted);
    font: 500 var(--font-size-label) / 1.3 var(--font-mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .case-next__title {
    font-size: clamp(20px, 2.4vw, 28px);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
    transition: color var(--duration-fast) var(--ease-out);
  }
  @container case-next (min-width: 640px) {
    .case-next__company,
    .case-next__name:not(.case-next__name--short) {
      display: inline;
    }
    .case-next__name--short {
      display: none;
    }
  }
  @media (min-width: 720px) {
    .case-next__link {
      padding-block: var(--space-9);
    }
  }
  @media (hover: hover) {
    .case-next__link:hover .case-next__title {
      color: var(--color-text-accent);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .case-next__title {
      transition: none;
    }
  }
</style>
