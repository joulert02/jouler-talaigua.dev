---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props {
  /** The image, imported from `src/assets/`. */
  src: ImageMetadata;
  /** What the image shows, for people who cannot see it. */
  alt: string;
}
const { src, alt } = Astro.props;
---

<!-- A capture or photo in a case (v11 `.figure`), full width with a hairline, and its caption from the slot. -->
<figure class="case-figure">
  <Image
    class="case-figure__image"
    src={src}
    alt={alt}
    widths={[800, 1600]}
    sizes="(min-width: 1240px) 1200px, 100vw"
  />
  {Astro.slots.has("default") && (
    <figcaption class="case-figure__caption">
      <slot />
    </figcaption>
  )}
</figure>

<style>
  .case-figure {
    margin: var(--space-6) 0 0;
  }
  .case-figure__image {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-border);
    border-radius: 14px;
  }
  .case-figure__caption {
    margin-top: 10px;
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
    line-height: 1.5;
  }
</style>
