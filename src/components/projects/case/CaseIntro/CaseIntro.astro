---
interface Props {
  /** The intro's heading ("What I learned"). */
  title: string;
  /**
   * Where the media sits: `portrait` (a phone-shaped video or photo, 380px on the right) or `side` (a landscape image,
   * half the width on the right; on phones it sits between the paragraphs and the quote) or `photo` (a square photo,
   * beside one paragraph and centred with the text under the heading; on tablets the quote goes below both). Not
   * `media`: that name is the slot's, and Astro would not pass it as a prop.
   */
  layout?: "portrait" | "side" | "photo";
}
const { title, layout = "portrait" } = Astro.props;
const id = "case-intro-title";
---

<!--
  The case intro (v11 intro-c with the Pragma variant): the heading, the owner's text and quote on the left, the media
  (a photo or a CaseVideo, in the `media` slot) on the right; one column on phones, text first.
-->
<section class={`case-intro case-intro--${layout}`} id="case-intro" aria-labelledby={id}>
  <h2 class="case-intro__title" id={id}>
    {title}
  </h2>
  <div class="case-intro__text">
    <slot />
  </div>
  {Astro.slots.has("media") && (
    <div class="case-intro__media">
      <slot name="media" />
    </div>
  )}
</section>

<style>
  .case-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    margin-top: clamp(48px, 6vw, 72px);
  }
  .case-intro__title {
    margin: 0 0 -8px;
    font-size: clamp(26px, 3vw, 36px);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .case-intro__text {
    --case-paragraph-size: clamp(18px, 1.5vw, 20px);
    --case-paragraph-leading: 1.65;
    --case-paragraph-measure: 56ch;
    --case-paragraph-gap: 1.15em;
    --case-paragraph-color: var(--color-text);
    --case-quote-size: clamp(18px, 1.5vw, 20px);
    --case-quote-leading: 1.55;
    --case-quote-margin: 28px 0 24px;
    --case-quote-indent: 20px;
    --case-quote-measure: 44rem;
  }
  .case-intro__media {
    width: min(100%, 380px);
  }
  @media (min-width: 720px) {
    .case-intro {
      grid-template-columns: minmax(0, 1fr) minmax(260px, 380px);
      grid-template-rows: auto 1fr;
      gap: 28px var(--layout-gap);
      align-items: start;
    }
    .case-intro__title,
    .case-intro__text {
      grid-column: 1;
    }
    .case-intro__text {
      margin-top: 20px;
    }
    .case-intro__media {
      grid-column: 2;
      grid-row: 1 / span 2;
      justify-self: end;
      width: 100%;
    }
    /* A landscape image beside the text: both halves share the row. */
    .case-intro--side {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
    }
  }
  .case-intro--side .case-intro__media {
    width: 100%;
  }
  /* A square photo: the heading has its own row, and the photo is centred with the text (v11 Mercado Libre). */
  @media (min-width: 720px) {
    .case-intro--photo {
      grid-template-rows: auto auto;
      align-items: center;
    }
    .case-intro--photo .case-intro__title {
      grid-column: 1 / -1;
    }
    .case-intro--photo .case-intro__text {
      margin-top: 0;
    }
    .case-intro--photo .case-intro__media {
      grid-row: 2;
    }
  }
  /* Photo, on tablets: the paragraph beside the photo and the quote below, across both columns. */
  @media (min-width: 720px) and (max-width: 1040px) {
    .case-intro--photo {
      grid-template-columns: minmax(0, 1fr) min(44%, 380px);
    }
    .case-intro--photo .case-intro__text {
      --case-paragraph-gap: 0;
      --case-quote-margin: 0;
      --case-quote-measure: none;
      display: contents;
    }
    .case-intro--photo :global(.case-quote) {
      --case-paragraph-measure: none;
      grid-column: 1 / -1;
      grid-row: 3;
    }
  }
  /* The intro's grid spaces the figure; its own top margin is for chapters. */
  .case-intro__media :global(.case-figure) {
    margin-top: 0;
  }
  /*
   * Side, on phones: paragraphs, then the image, then the quote. The text box lets its paragraphs and quote join the
   * intro's grid, so the image can sit between them.
   */
  @media (max-width: 719px) {
    .case-intro--side {
      gap: 24px;
    }
    .case-intro--side .case-intro__text {
      --case-paragraph-gap: 0;
      --case-quote-margin: 0;
      display: contents;
    }
    .case-intro--side .case-intro__media {
      order: 1;
    }
    .case-intro--side :global(.case-quote) {
      order: 2;
    }
  }
</style>
