---
interface Props {
  /** Who the work was for, shown above the title ("Grupo Familia brands · via PRAGMA"). */
  company: string;
  /** The case title, the page's H1. */
  title: string;
  /** The case's slug: the title shares `case-title-<slug>` with its row on Work, so it morphs on the way in. */
  slug: string;
}
const { company, title, slug } = Astro.props;
---

<!-- The case header (v11 `.case-head`): the company label and the title. -->
<header class="case-header">
  <p class="case-header__company" translate="no">
    {company}
  </p>
  <h1 class="case-header__title" style={`view-transition-name: case-title-${slug}`}>
    {title}
  </h1>
</header>

<style>
  .case-header {
    padding-top: clamp(28px, 6vw, 64px);
  }
  .case-header__company {
    margin: 12px 0 0;
    color: var(--color-text-muted);
    font: 500 var(--font-size-label) / 1.3 var(--font-mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .case-header__title {
    margin: 8px 0 0;
    font-size: clamp(38px, 5.6vw, 64px);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
</style>
