---
import BackPill from "../../../layout/BackPill/BackPill.astro";
import LanguageSwitch from "../../../layout/LanguageSwitch/LanguageSwitch.astro";
import { languageItems } from "../../../../config/profile";
import { getLang, localePath, useTranslations } from "../../../../i18n/ui";
interface Props {
  /** The case's slug: the pill goes back to its row on Work, the switch to the same case in the other language. */
  slug: string;
}
const { slug } = Astro.props;
const lang = getLang(Astro);
const t = useTranslations(lang);
const languages = languageItems.map((item) => ({ ...item, href: localePath(item.lang, `/work/${slug}/`) }));
---

<!--
  The case top bar (v11): sticky, the back pill to the row the reader came from and the language switch, the same pill
  as on every other page (owner review, 2026-11-23); no Dock. Once the page scrolls, its hairline becomes a reading
  progress bar. On phones the bar slides away while the reader scrolls down and comes back when they scroll up. Used by
  coming-soon cases, and by built cases on phones only (WorkCase).
-->
<header class="case-top">
  <BackPill
    href={localePath(lang, `/work/#row-${slug}`)}
    label={t("work.back")}
    shortLabel={t("work.backShort")}
    caption={t("work.backCaption")}
  />
  <LanguageSwitch items={languages} />
</header>

<style>
  /*
   * Sticky over the page, as wide as the case. No side padding of its own: the body's already sets the page margin, so
   * the pill lines up with the content (v11). The blurred backdrop and the hairline reach the screen edges through that
   * margin.
   */
  .case-top {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    width: min(var(--layout-container), 100%);
    margin-inline: auto;
    padding: var(--space-4) 0 12px;
    /* Hiding and showing on phones: a smooth slide, gentle at both ends. */
    transition: translate 350ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .case-top::before {
    content: "";
    position: absolute;
    inset: 0 calc(-1 * var(--page-gutter));
    z-index: -1;
    background: color-mix(in srgb, var(--color-bg) 82%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-fast) var(--ease-out);
  }
  .case-top[data-stuck]::before {
    border-bottom-color: var(--color-border);
  }
  /* The reading progress: it fills the hairline from the left as the page scrolls, 0 at the top and 1 at the end. */
  .case-top::after {
    content: "";
    position: absolute;
    right: calc(-1 * var(--page-gutter));
    bottom: -1px;
    left: calc(-1 * var(--page-gutter));
    height: 2px;
    background: var(--color-accent);
    opacity: 0;
    scale: var(--case-top-progress, 0) 1;
    transform-origin: left center;
    transition:
      opacity var(--duration-fast) var(--ease-out),
      translate 350ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .case-top[data-stuck]::after {
    opacity: 1;
  }
  @supports (animation-timeline: scroll()) {
    .case-top::after {
      animation: case-top-progress linear both;
      animation-timeline: scroll(root block);
    }
  }
  @keyframes case-top-progress {
    from {
      scale: 0 1;
    }
    to {
      scale: 1 1;
    }
  }

  /*
   * Phones: the bar slides away while scrolling down. The progress line slides the other way by the same easing, so it
   * travels up with the bar and docks at the top edge of the screen, and comes back down with it.
   */
  .case-top[data-hidden] {
    translate: 0 calc(-100% - 8px);
  }
  .case-top[data-hidden]::after {
    translate: 0 9px;
  }
  @media (prefers-reduced-motion: reduce) {
    .case-top,
    .case-top::before,
    .case-top::after {
      transition: none;
    }
  }
</style>

<script>
  const top = document.querySelector<HTMLElement>(".case-top");
  if (top) {
    // On phones the bar hides while the reader scrolls
    // down and returns when they scroll up, each only after a run in one direction (48px down, 24px up) so small
    // scrolls never make it flicker.
    const phone = matchMedia("(max-width: 719px)");
    const progress = !CSS.supports("animation-timeline", "scroll()");
    let turn = scrollY;
    let last = scrollY;
    let frame = 0;
    const sync = () => {
      const y = scrollY;
      if ((y > last && last < turn) || (y < last && last > turn)) turn = last;
      last = y;
      top.toggleAttribute("data-stuck", y > 8);
      // A keyboard user moving through the bar keeps it in place.
      const busy = top.querySelector(":focus-visible") !== null;
      let hidden = top.hasAttribute("data-hidden");
      if (!phone.matches || y <= 96 || busy) hidden = false;
      else if (y - turn > 48) hidden = true;
      else if (turn - y > 24) hidden = false;
      top.toggleAttribute("data-hidden", hidden);
      if (progress) {
        const end = document.documentElement.scrollHeight - innerHeight;
        top.style.setProperty("--case-top-progress", String(end > 0 ? Math.min(1, y / end) : 0));
      }
    };
    addEventListener(
      "scroll",
      () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(sync);
      },
      { passive: true },
    );
    sync();
  }
</script>
