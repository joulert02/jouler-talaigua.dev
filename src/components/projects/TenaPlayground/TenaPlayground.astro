    const $ = <T extends Element = HTMLElement>(selector: string) => win.querySelector<T>(selector);
    const $$ = <T extends Element = HTMLElement>(selector: string) => [...win.querySelectorAll<T>(selector)];

    // Registration / Academy
    for (const radio of frame.querySelectorAll<HTMLInputElement>('input[name="tena-screen"]')) {
      radio.addEventListener("change", () => {
        for (const screen of $$("[data-screen]")) screen.hidden = screen.dataset.screen !== radio.value;
        const live = frame.querySelector<HTMLAnchorElement>(".example-frame__actions a");
        const urls = JSON.parse(win.dataset.urls ?? "{}") as Record<string, string>;
        const url = urls[radio.value];
        if (live && url) live.href = url;
      });
    }

    // A demo action: a toast in the window, announced.
    let toastTimer = 0;
    const demo = () => {
      const text = root.dataset.demo ?? "";
      toast.textContent = text;
      toast.setAttribute("data-show", "");
      clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => toast.removeAttribute("data-show"), 2200);
      announce(frame, text);
    };
    $$("[data-demo-action]").forEach((button) => button.addEventListener("click", demo));

    // Steps: a user type leads to the details; Back returns to the types.
    const types = $('[data-step="types"]');
    const details = $('[data-step="details"]');
    if (types && details) {
      $$(".tena-playground__type").forEach((button) =>
        button.addEventListener("click", () => {
          types.hidden = true;
          details.hidden = false;
          $("[data-back]")?.focus();
        }),
      );
      $("[data-back]")?.addEventListener("click", () => {
        details.hidden = true;
        types.hidden = false;
        $(".tena-playground__type")?.focus();
      });
    }

    // A− / A+: 100% to 130% in steps of 15%.
    let zoom = 1;
    const [smaller, larger] = $$<HTMLButtonElement>("[data-zoom]");
    $$<HTMLButtonElement>("[data-zoom]").forEach((button) =>
      button.addEventListener("click", () => {
        zoom = Math.round(Math.max(1, Math.min(1.3, zoom + Number(button.dataset.zoom) * 0.15)) * 100) / 100;
        win.style.setProperty("--_zoom", String(zoom));
        if (smaller) smaller.disabled = zoom <= 1;
        if (larger) larger.disabled = zoom >= 1.3;
        announce(frame, `${root.dataset.size}: ${Math.round(zoom * 100)}%`);
      }),
    );

    // Academy: the promo bar hides when the list or a view scrolls down and comes back when it scrolls up, as the
    // site's does with the page. A few pixels of slack keep it from flickering at the very top.
    const academy = $('[data-screen="academy"]');
    const showPromo = (shown: boolean) => {
      if (shown) academy?.removeAttribute("data-promo");
      else academy?.setAttribute("data-promo", "hidden");
    };
    const lastTop = new WeakMap<HTMLElement, number>();
    $$("[data-scroll]").forEach((scroller) =>
      scroller.addEventListener(
        "scroll",
        () => {
          const top = scroller.scrollTop;
          const previous = lastTop.get(scroller) ?? 0;
          if (top > previous && top > 8) showPromo(false);
          else if (top < previous) showPromo(true);
          lastTop.set(scroller, top);
        },
        { passive: true },
      ),
    );

    // Each card opens its own view, at its top; Back returns focus to the card's button.
    const list = $("[data-list]");
    let opener: HTMLElement | null = null;
    $$("[data-open]").forEach((button) =>
      button.addEventListener("click", () => {
        const view = $(`[data-view="${button.dataset.open}"]`);
        if (!list || !view) return;
        opener = button;
        list.hidden = true;
        view.hidden = false;
        view.scrollTop = 0;
        lastTop.set(view, 0);
        showPromo(true);
        view.querySelector<HTMLElement>("[data-close]")?.focus();
      }),
    );
    const closeView = () => {
      const view = $("[data-view]:not([hidden])");
      if (!list || !view) return false;
      view.hidden = true;
      list.hidden = false;
      showPromo(true);
      return true;
    };
    $$("[data-close]").forEach((button) =>
      button.addEventListener("click", () => {
        if (closeView()) opener?.focus();
      }),
    );

    // TENA Academy in the nav: back to the grid, at its top; focus goes to the card that was open, or the heading.
    $("[data-home]")?.addEventListener("click", () => {
      const fromView = closeView();
      if (!list) return;
      list.scrollTop = 0;
      lastTop.set(list, 0);
      showPromo(true);
      const target = fromView && opener ? opener : $("[data-heading]");
      target?.focus({ preventScroll: true });
    });
  }
</script>
