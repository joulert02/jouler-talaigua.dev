---
import { Image, getImage } from "astro:assets";
import ExampleFrame from "../ExampleFrame/ExampleFrame.astro";
import ExampleHint from "../ExampleFrame/ExampleHint/ExampleHint.astro";
import ExampleNote from "../ExampleFrame/ExampleNote/ExampleNote.astro";
import SegmentedSwitch from "../../ui/SegmentedSwitch/SegmentedSwitch.astro";
import Button from "../../ui/Button/Button.astro";
import Icon from "../../ui/Icon/Icon.astro";
import registration from "../../../assets/projects/pragma/tena/registration.jpg";
import logo from "../../../assets/projects/pragma/tena/logo-header.webp";
import { getLang } from "../../../i18n/ui";
import { tenaCards, tenaCopy, tenaTitles, tenaUrls, type TenaUserIcon } from "./tena.config";
const lang = getLang(Astro);
const copy = tenaCopy[lang];
// Line drawings for the user types, as on the site.
const icons: Record<TenaUserIcon, string> = {
  user: '<circle cx="16" cy="10" r="5"/><path d="M7 28c0-5 4-9 9-9s9 4 9 9"/>',
  buyer: '<path d="M10 6h12v11H10z M4 24c4-4 8-4 12-2h8l4-3" stroke-linejoin="round"/>',
  caregiver: '<circle cx="16" cy="11" r="5"/><path d="M11 6h10M16 3v4M7 28c0-5 4-9 9-9s9 4 9 9"/>',
  institution:
    '<path d="M5 28V11h22v17M3 28h26M10 15h3M19 15h3M10 20h3M19 20h3M14 28v-5h4v5M14 6h4M16 4v4"/>',
};
// Academy: line drawings for the card's format tab, the date and the site chrome, after the site's own icons.
const formatIcons = {
  article:
    '<rect x="4" y="8" width="16" height="21" rx="3"/><path d="M8 8V6a3 3 0 0 1 3-3h8l7 7.5V23a3 3 0 0 1-3 3h-3"/><path d="M19 3v5a2.5 2.5 0 0 0 2.5 2.5H26M8 18h8M8 23h8"/>',
  live: '<path d="M12.5 2.5a10 10 0 0 0-8.6 15.1L2.5 22.5l4.9-1.4a10 10 0 1 0 5.1-18.6z"/><path d="M9.6 10a2.9 2.9 0 1 1 4 2.7c-.7.3-1.1.9-1.1 1.6v.6M12.5 17.6v.3"/><path d="M22.7 11.7a8.4 8.4 0 0 1 5.4 12.6l1.4 5.2-5.2-1.4a8.4 8.4 0 0 1-11.2-4.4"/>',
} as const;
const chromeIcons = {
  calendar: '<rect x="2.5" y="3.5" width="11" height="10" rx="1.5"/><path d="M2.5 7h11M5.5 2v3M10.5 2v3"/>',
  search: '<circle cx="7" cy="7" r="4.5"/><path d="M10.5 10.5 14 14"/>',
  user: '<circle cx="8" cy="5" r="3"/><path d="M2.5 14.5c0-3 2.5-5 5.5-5s5.5 2 5.5 5"/>',
  register:
    '<circle cx="7" cy="5" r="3"/><path d="M1.5 14.5c0-3 2.5-5 5.5-5 1.3 0 2.5.4 3.4 1M13 9v5M10.5 11.5h5"/>',
  home: '<path d="M2 8 8 2.5 14 8M4 6.5V14h3v-4h2v4h3V6.5"/>',
  sample: '<rect x="2" y="2.5" width="12" height="4" rx="1"/><path d="M3 6.5V14h10V6.5M6 9.5h4"/>',
  cart: '<path d="M1 2h2l1.6 8h8.2L14.5 4.5H4M6 13.5h.01M12 13.5h.01"/>',
  menu: '<path d="M2 4h12M2 8h12M2 12h12"/>',
} as const;
const tabIcons = [chromeIcons.cart, chromeIcons.sample];
const barIcons = [
  chromeIcons.home,
  chromeIcons.search,
  chromeIcons.sample,
  chromeIcons.cart,
  chromeIcons.menu,
];
const cards = tenaCards.flatMap((card, index) => {
  const text = copy.cards[index];
  const title = tenaTitles[index];
  return text && title ? [{ ...card, ...text, title }] : [];
});
// The article banner swaps to its mobile crop below 720px, as on the site.
const banners = await Promise.all(
  cards.map(async (card) =>
    card.format === "article"
      ? {
          wide: await getImage({ src: card.hero.wide, width: 1440, format: "webp" }),
          mobile: await getImage({ src: card.hero.mobile, width: 960, format: "webp" }),
        }
      : undefined,
  ),
);
---

<!--
  TENA (Brand platforms, chapter 02): a recreation of the shipped registration and Academy, in TENA's own light
  palette in both themes. Registration: pick a user type to reach the details step; A− / A+ scale the text, as on the
  site for older adults. Academy: each format opens its own layout (article, live). Nothing is sent or stored.
-->
<div class="tena-playground" data-tena data-demo={copy.demo} data-size={copy.textSize}>
  <ExampleFrame id="tena-example" label={copy.label}>
    <SegmentedSwitch
      slot="controls"
      name="tena-screen"
      legend={copy.screen}
      options={[
        { value: "registration", label: copy.registration },
        { value: "academy", label: copy.screenAcademy },
      ]}
    />
    <ExampleHint slot="head">{copy.hint}</ExampleHint>
    <div
      class="tena-playground__window"
      role="region"
      aria-label={copy.region}
      data-urls={JSON.stringify(tenaUrls)}
    >
      <section class="tena-playground__registration" data-screen="registration">
        <div class="tena-playground__hero">
          <Image class="tena-playground__hero-image" src={registration} alt="" width={720} />
          <Image class="tena-playground__hero-logo" src={logo} alt="" width={500} />
        </div>
        <div class="tena-playground__panel">
          <div class="tena-playground__zoom">
            <button
              class="tena-playground__zoom-button"
              type="button"
              aria-label={copy.smaller}
              disabled
              data-zoom="-1"
            >
              A−
            </button>
            <button class="tena-playground__zoom-button" type="button" aria-label={copy.larger} data-zoom="1">
              A+
            </button>
          </div>
          <p class="tena-playground__welcome">{copy.welcome}</p>
          <div data-step="types">
            <p class="tena-playground__subtitle">{copy.signUp}</p>
            <p class="tena-playground__text">{copy.pick}</p>
            <div class="tena-playground__types">
              {copy.types.map((type) => (
                <button class="tena-playground__type" type="button">
                  <svg
                    viewBox="0 0 32 32"
                    aria-hidden="true"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    set:html={icons[type.icon]}
                  />
                  <b class="tena-playground__type-title">{type.title}</b>
                  <span class="tena-playground__type-text">{type.text}</span>
                </button>
              ))}
            </div>
          </div>
          <div data-step="details" hidden>
            <p class="tena-playground__text">{copy.details}</p>
            {copy.fields.map((field, index) => (
              <div class="tena-playground__field">
                {field}
                {index === 0 && <span aria-hidden="true">⌄</span>}
              </div>
            ))}
            {[copy.terms, copy.privacy].map(([before, link, after]) => (
              <label class="tena-playground__check">
                <input class="tena-playground__checkbox" type="checkbox" />
                <span>
                  {before}
                  <em class="tena-playground__em">{link}</em>
                  {after}
                </span>
              </label>
            ))}
            <p class="tena-playground__legal">{copy.legal}</p>
            <div class="tena-playground__buttons">
              <button class="tena-playground__button" type="button" data-back>
                {copy.back}
              </button>
              <button
                class="tena-playground__button tena-playground__button--dark"
                type="button"
                data-demo-action
              >
                {copy.next}
              </button>
            </div>
          </div>
          <button class="tena-playground__help" type="button" data-demo-action>
            {copy.help}
          </button>
        </div>
      </section>
      <section class="tena-playground__academy" data-screen="academy" hidden>
        <!-- The site's fixed header: the promo bar slides away on scroll down and back on scroll up. -->
        <div class="tena-playground__chrome">
          <p class="tena-playground__promo">
            <span class="tena-playground__promo-long">{copy.promo[0]}</span>
            <span class="tena-playground__promo-short">{copy.promoShort}</span>
            <span class="tena-playground__promo-tag">{copy.promo[1]}</span>
          </p>
          <div class="tena-playground__header" aria-hidden="true">
            <Image class="tena-playground__logo" src={logo} alt="" width={500} />
            <span class="tena-playground__search">
              {copy.search}
              <svg
                class="tena-playground__glyph"
                viewBox="0 0 16 16"
                aria-hidden="true"
                set:html={chromeIcons.search}
              />
            </span>
            <span class="tena-playground__sizes" aria-hidden="true">
              <span class="tena-playground__size tena-playground__size--off">A-</span>
              <span class="tena-playground__size">A+</span>
            </span>
            <span class="tena-playground__account">
              <svg
                class="tena-playground__glyph"
                viewBox="0 0 16 16"
                aria-hidden="true"
                set:html={chromeIcons.user}
              />
              {copy.logIn}
            </span>
            <span class="tena-playground__account tena-playground__account--register">
              <svg
                class="tena-playground__glyph"
                viewBox="0 0 16 16"
                aria-hidden="true"
                set:html={chromeIcons.register}
              />
              {copy.register}
            </span>
          </div>
          <div class="tena-playground__nav">
            {copy.nav.map((item, index) =>
              index === copy.nav.length - 1 ? (
                <button
                  class="tena-playground__nav-link tena-playground__nav-link--on"
                  type="button"
                  aria-current="page"
                  data-home
                >
                  {item}
                </button>
              ) : (
                <span class="tena-playground__nav-link" aria-hidden="true">
                  {item}
                </span>
              ),
            )}
            {copy.tabs.map((tab, index) => (
              <span class="tena-playground__nav-tab" aria-hidden="true">
                <svg
                  class="tena-playground__glyph"
                  viewBox="0 0 16 16"
                  aria-hidden="true"
                  set:html={tabIcons[index]}
                />
                {tab}
              </span>
            ))}
          </div>
        </div>
        <div class="tena-playground__list" data-list data-scroll>
          <p class="tena-playground__academy-title">{copy.academy}</p>
          <p class="tena-playground__heading" tabindex="-1" data-heading>
            {copy.designed}
          </p>
          <div class="tena-playground__cards">
            {cards.map((card, index) => (
              <article class="tena-playground__card">
                <div class="tena-playground__thumb">
                  <Image class="tena-playground__thumb-image" src={card.image} alt="" width={540} />
                  <span class="tena-playground__format" aria-hidden="true">
                    <svg viewBox="0 0 32 32" set:html={formatIcons[card.format]} />
                  </span>
                </div>
                <div class="tena-playground__card-head">
                  <span class="tena-playground__category">{card.category}</span>
                  <span class="tena-playground__kind">{card.kind}</span>
                </div>
                <div class="tena-playground__card-body">
                  <p
                    class:list={[
                      "tena-playground__card-title",
                      { "tena-playground__card-title--live": card.format === "live" },
                    ]}
                    id={`tena-card-${index}`}
                    lang="es"
                  >
                    {card.title}
                  </p>
                  <span
                    class:list={[
                      "tena-playground__who",
                      { "tena-playground__who--live": card.format === "live" },
                    ]}
                  >
                    {card.who}
                  </span>
                  <span class="tena-playground__when">
                    <svg
                      class="tena-playground__glyph"
                      viewBox="0 0 16 16"
                      aria-hidden="true"
                      set:html={chromeIcons.calendar}
                    />
                    {card.when}
                  </span>
                  <button
                    class="tena-playground__cta"
                    type="button"
                    data-open={index}
                    aria-describedby={`tena-card-${index}`}
                  >
                    {card.open}
                  </button>
                </div>
              </article>
            ))}
          </div>
        </div>
        {cards.map((card, index) => {
          const banner = banners[index];
          const row = (
            <p class="tena-playground__row">
              <span class="tena-playground__stamp">
                <svg
                  class="tena-playground__glyph"
                  viewBox="0 0 16 16"
                  aria-hidden="true"
                  set:html={chromeIcons.calendar}
                />
                {card.stamp}
              </span>
              <u class="tena-playground__row-link">{copy.share}</u>
              <u class="tena-playground__row-link">{copy.like}</u>
            </p>
          );
          return (
            <div
              class:list={["tena-playground__view", `tena-playground__view--${card.format}`]}
              data-view={index}
              data-scroll
              hidden
            >
              <button class="tena-playground__back" type="button" data-close>
                {copy.toList}
              </button>
              {banner ? (
                <>
                  <div class="tena-playground__banner">
                    <picture class="tena-playground__banner-picture">
                      <source media="(min-width: 720px)" srcset={banner.wide.src} />
                      <img
                        class="tena-playground__banner-image"
                        src={banner.mobile.src}
                        alt=""
                        loading="lazy"
                        decoding="async"
                      />
                    </picture>
                    <span class="tena-playground__banner-tag">{card.category}</span>
                    <p class="tena-playground__banner-title" lang="es">
                      {card.title}
                    </p>
                  </div>
                  {row}
                  <div class="tena-playground__article" aria-hidden="true">
                    <div class="tena-playground__lines">
                      {Array.from({ length: 10 }, () => (
                        <i class="tena-playground__line" />
                      ))}
                    </div>
                    <span class="tena-playground__aside" />
                  </div>
                </>
              ) : (
                <>
                  <div class="tena-playground__live">
                    <div class="tena-playground__video" aria-hidden="true">
                      <Image class="tena-playground__video-poster" src={card.image} alt="" width={720} />
                      <span class="tena-playground__video-bar">
                        <span class="tena-playground__video-avatar">TENA</span>
                        <span class="tena-playground__video-title" lang="es">
                          {card.title}
                          <small class="tena-playground__video-channel">TENA</small>
                        </span>
                      </span>
                      <span class="tena-playground__play" />
                    </div>
                    <div class="tena-playground__live-side">
                      <span class="tena-playground__live-tag">{card.category}</span>
                      <p class="tena-playground__live-title" lang="es">
                        {card.title}
                      </p>
                      <p class="tena-playground__live-who">{card.who}</p>
                      {row}
                    </div>
                  </div>
                  <div class="tena-playground__about">
                    <div class="tena-playground__about-text">
                      <p class="tena-playground__about-heading">{copy.aboutLive}</p>
                      <div class="tena-playground__lines" aria-hidden="true">
                        {Array.from({ length: 5 }, () => (
                          <i class="tena-playground__line" />
                        ))}
                      </div>
                    </div>
                    <div class="tena-playground__aimed">
                      <p class="tena-playground__about-heading">{copy.aimedAt}</p>
                      <span class="tena-playground__aimed-tile" aria-hidden="true" />
                      <p class="tena-playground__aimed-label">{copy.audience}</p>
                    </div>
                  </div>
                </>
              )}
            </div>
          );
        })}
        <div class="tena-playground__bar" aria-hidden="true">
          {copy.bar.map((item, index) => (
            <span class="tena-playground__bar-item">
              <svg class="tena-playground__bar-icon" viewBox="0 0 16 16" set:html={barIcons[index]} />
              {item}
            </span>
          ))}
        </div>
      </section>
      <p class="tena-playground__toast" aria-hidden="true"></p>
    </div>
    <ExampleNote slot="foot">{copy.note}</ExampleNote>
    <Button slot="actions" variant="ghost" size="sm" href={tenaUrls.registration} label={copy.live}>
      <Icon slot="end" name="external" size={14} />
    </Button>
  </ExampleFrame>
</div>

<style>
  /* TENA's own palette and type, fixed in both themes like the product. --_zoom is the A− / A+ text scale. */
  .tena-playground__window {
    --_navy: #173a72;
    --_blue: #3a78d4;
    --_green: #7ac143;
    --_ink: #33415c;
    --_muted: #6b7280;
    --_zoom: 1;
    position: relative;
    height: 620px;
    margin-top: 20px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    background: #fbfbfb;
    box-shadow: var(--shadow-rest);
    color: var(--_ink);
    color-scheme: light;
    font:
      14px/1.4 Nunito,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      sans-serif;
  }
  .tena-playground__window [hidden] {
    display: none !important;
  }
  .tena-playground__window :focus-visible {
    outline: 2px solid var(--_blue);
    outline-offset: 2px;
  }

  /* Registration */
  .tena-playground__registration {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: 120px minmax(0, 1fr);
    height: 100%;
  }
  .tena-playground__hero {
    position: relative;
    overflow: hidden;
  }
  .tena-playground__hero-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }
  /* The site's logo wave over the photo's top left, as on the registration page. */
  .tena-playground__hero-logo {
    position: absolute;
    top: 0;
    left: 0;
    width: max(160px, 44%);
    height: auto;
  }
  .tena-playground__panel {
    position: relative;
    overflow: auto;
    padding: 28px clamp(18px, 4vw, 48px) 24px;
    border-bottom-right-radius: 14px;
    font-size: calc(14px * var(--_zoom));
  }
  .tena-playground__zoom {
    position: absolute;
    top: 16px;
    right: 20px;
    display: flex;
    gap: 4px;
  }
  .tena-playground__zoom-button {
    width: 32px;
    height: 32px;
    padding: 0;
    border: 1px solid #9aa3b2;
    border-radius: 50%;
    background: #fff;
    color: var(--_ink);
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
  }
  .tena-playground__zoom-button:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .tena-playground__welcome {
    margin: 0;
    color: var(--_navy);
    font-size: 1.85em;
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  .tena-playground__subtitle {
    margin: 2px 0 12px;
    color: var(--_navy);
    font-size: 1.3em;
  }
  .tena-playground__text {
    margin: 0 0 12px;
    color: var(--_muted);
    font-size: 0.95em;
  }
  .tena-playground__types {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 10px;
  }
  .tena-playground__type {
    position: relative;
    display: grid;
    grid-template-columns: 34px 1fr;
    gap: 8px 10px;
    align-items: center;
    padding: 12px 14px 12px 18px;
    border: 0;
    border-radius: 2px;
    background: #fff;
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.18);
    color: var(--_ink);
    text-align: left;
    cursor: pointer;
  }
  .tena-playground__type::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 8px;
    height: 30%;
    background: var(--_green);
  }
  .tena-playground__type::after {
    content: "";
    position: absolute;
    top: 10px;
    right: 10px;
    width: 14px;
    height: 14px;
    border: 1.5px solid var(--_blue);
    border-radius: 50%;
  }
  .tena-playground__type svg {
    width: 30px;
    height: 30px;
    color: var(--_blue);
  }
  .tena-playground__type-title {
    color: var(--_blue);
    font-size: 0.95em;
    font-weight: 800;
  }
  .tena-playground__type-text {
    grid-column: 1 / -1;
    color: var(--_muted);
    font-size: 0.92em;
  }
  .tena-playground__field {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 2.9em;
    margin-bottom: 10px;
    padding: 0 12px;
    border: 1px solid #d3d7de;
    border-radius: 3px;
    background: #fff;
    color: #555;
    font-size: 0.95em;
  }
  .tena-playground__check {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    margin: 6px 0 10px;
    font-size: 0.95em;
    cursor: pointer;
  }
  .tena-playground__checkbox {
    flex: none;
    width: 18px;
    height: 18px;
    margin: 1px 0 0;
    accent-color: var(--_blue);
  }
  .tena-playground__em {
    color: var(--_blue);
    font-style: normal;
    font-weight: 700;
  }
  .tena-playground__legal {
    height: 3.4em;
    margin: 0 0 14px;
    overflow: hidden;
    color: #444;
    font-size: 0.78em;
    font-weight: 600;
    mask: linear-gradient(#000 50%, transparent);
  }
  .tena-playground__buttons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .tena-playground__button {
    min-height: 2.8em;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: var(--_blue);
    color: #fff;
    font-weight: 700;
    cursor: pointer;
  }
  .tena-playground__button--dark {
    background: var(--_navy);
  }
  .tena-playground__help {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 2.6em;
    margin: 14px 0 0;
    border: 0;
    border-radius: 999px;
    background: var(--_green);
    color: #fff;
    font-size: 1em;
    font-weight: 700;
    cursor: pointer;
  }

  /* Academy: tena.com.co/academia-tena as measured (Nunito; the live's texts use a lighter face). */
  .tena-playground__academy {
    --_site-navy: #063c73;
    --_site-blue: #0082d6;
    --_site-sky: #13b8f1;
    --_site-green: #62c224;
    --_slate: #3f515d;
    --_promo-h: 34px;
    --_chrome-h: calc(var(--_promo-h) + 38px);
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #fbfcfc;
    color: var(--_slate);
  }
  .tena-playground__glyph {
    flex: none;
