---
interface Props {
  /** Mono label at the top left: what this is and whose code it is ("Recreation of the shipped screens · not TENA code"). */
  label: string;
  /** Unique on the page; names the frame for screen readers and lets scripts find it. */
  id: string;
}
const { label, id } = Astro.props;
const labelId = `${id}-label`;
---

<!--
  The one frame for every example and playground in a case (v11 `.lab`): a dotted board with the label top left and the
  controls top right (`controls` slot), an optional line under them (`head` slot), the piece itself, then a foot with
  hints and notes on the left (`foot` slot) and the actions on the right (`actions` slot). Foot rule: the primary
  action runs the demo and is always rightmost; links that leave are ghost, to its left. On phones the actions stack,
  primary last, nearest the thumb. Scripts announce results through the frame's polite live region.
-->
<div class="example-frame" id={id} role="group" aria-labelledby={labelId}>
  <div class="example-frame__head">
    <p class="example-frame__label" id={labelId}>
      {label}
    </p>
    {Astro.slots.has("controls") && (
      <div class="example-frame__controls">
        <slot name="controls" />
      </div>
    )}
    <slot name="head" />
  </div>
  <slot />
  <div class="example-frame__foot">
    {Astro.slots.has("foot") && (
      <div class="example-frame__notes">
        <slot name="foot" />
      </div>
    )}
    {Astro.slots.has("actions") && (
      <div class="example-frame__actions">
        <slot name="actions" />
      </div>
    )}
  </div>
  <p class="example-frame__live" aria-live="polite" data-example-live></p>
</div>

<style>
  .example-frame {
    margin-top: 8px;
    padding: clamp(16px, 3vw, 32px);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    background-color: var(--color-bg-subtle);
    background-image: radial-gradient(
      circle at 1px 1px,
      color-mix(in srgb, var(--color-text-muted) 18%, transparent) 1px,
      transparent 0
    );
    background-size: 22px 22px;
  }
  .example-frame__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
  }
  .example-frame__label {
    margin: 0;
    color: var(--color-text-muted);
    font: 500 var(--font-size-label) / 1.3 var(--font-mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .example-frame__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .example-frame__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: var(--example-frame-foot-gap, 16px);
  }
  .example-frame__foot:empty {
    display: none;
  }
  /* Notes take what the actions leave, so long notes wrap beside them instead of pushing them to a new line. */
  .example-frame__notes {
    display: grid;
    flex: 1 1 320px;
    gap: 4px;
  }
  /* Stacked on phones: hint, then the link, then the primary last, so DOM, keyboard and visual order agree. */
  .example-frame__actions {
    display: flex;
    flex: 1 1 100%;
    flex-direction: column;
    align-items: stretch;
    gap: 10px;
  }
  .example-frame__live {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media (min-width: 720px) {
    .example-frame__actions {
      flex: 0 0 auto;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 12px;
    }
  }
</style>
