---
import { getLang, useTranslations } from "../../../i18n/ui";
const t = useTranslations(getLang(Astro));
---

<!--
  The case index. It reads the page: its h1 first (the link goes back to the top), then every `[data-case-nav]`
  section (CaseIntro, Chapter). Nothing to configure per case. Hidden until filled.

  Wide screens: a column of ticks in the right margin, one per entry; the one in view is longer and in the accent.
  Hover or focus opens it without a panel: the ticks stretch one after another and the names slide in beside them as
  bare text, straight over whatever is behind them.
  Narrower screens: a pill with the section in view ("02 TENA"). It unfolds the same ticks and names under the bar,
  over a continuation of the bar's frosted backdrop that fades out; the pill, a tap outside or Esc folds it again.
  CaseTop places it and decides when it shows. A link scrolls there.
-->
<nav class="case-nav" aria-label={t("case.contents")} hidden>
  <ol class="case-nav__list"></ol>
  <button class="case-nav__pill" type="button" aria-expanded="false" aria-controls="case-nav-drop">
    <span class="case-nav__pill-text">{t("case.contents")}: </span>
    <span class="case-nav__pill-num"></span>
    <span class="case-nav__pill-name"></span>
    <svg class="case-nav__pill-chevron" viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
      <path
        d="M5.5 8 10 12.5 14.5 8"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      ></path>
    </svg>
  </button>
  <ol class="case-nav__drop" id="case-nav-drop"></ol>
</nav>

<style>
  .case-nav[hidden] {
    display: none;
  }

  /* Wide screens: the rail of ticks, only where the margin beside the 1240px case fits it. */
  .case-nav__list {
    display: none;
    margin: 0;
    padding: 10px 18px 10px 24px;
    list-style: none;
  }
  @media (min-width: 1320px) {
    .case-nav__list {
      position: fixed;
      z-index: 20;
      top: 50%;
      right: 0;
      display: grid;
      gap: 2px;
      translate: 0 -50%;
    }
  }
  .case-nav__list :global(.case-nav__item:not(:first-child)) {
    margin-top: 8px;
  }
  .case-nav__list :global(.case-nav__link) {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 14px;
    min-height: 26px;
    border-radius: var(--radius-xs);
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
  }
  .case-nav__list :global(.case-nav__label) {
    max-width: 0;
    overflow: hidden;
    opacity: 0;
    translate: 12px 0;
    transition:
      max-width 0s linear var(--duration-fast),
      opacity 0.15s var(--ease-out),
      translate var(--duration-fast) var(--ease-out);
  }
  .case-nav__list :global(.case-nav__tick) {
    flex: none;
    width: 16px;
    height: 2px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--color-text-muted) 55%, transparent);
    transform-origin: right center;
    transition:
      width var(--duration-medium) var(--ease-spring),
      background-color var(--duration-medium) var(--ease-out);
  }
  .case-nav__list :global(.case-nav__link[aria-current="true"]) {
    color: var(--color-text);
    font-weight: 600;
  }
  .case-nav__list :global(.case-nav__link[aria-current="true"] .case-nav__tick) {
    width: 28px;
    background: var(--color-accent);
  }
  .case-nav__list :global(.case-nav__link:focus-visible) {
    outline: 2px solid var(--color-text-accent);
    outline-offset: 4px;
  }

  /* Open: the ticks stretch one after another, and the names follow from the right. */
  .case-nav__list:hover :global(.case-nav__tick),
  .case-nav__list:focus-within :global(.case-nav__tick) {
    width: 24px;
    transition-delay: calc(var(--i) * 25ms);
  }
  .case-nav__list:hover :global(.case-nav__link[aria-current="true"] .case-nav__tick),
  .case-nav__list:focus-within :global(.case-nav__link[aria-current="true"] .case-nav__tick) {
    width: 36px;
  }
  .case-nav__list:hover :global(.case-nav__label),
  .case-nav__list:focus-within :global(.case-nav__label) {
    max-width: 18rem;
    opacity: 1;
    translate: 0 0;
    transition:
      max-width 0s,
      opacity var(--duration-fast) var(--ease-out) calc(var(--i) * 35ms + 80ms),
      translate var(--duration-medium) var(--ease-out) calc(var(--i) * 35ms + 80ms);
  }
  /* The name under the pointer or focus: full colour, and its tick reaches out to it. */
  .case-nav__list :global(.case-nav__link:is(:hover, :focus-visible)) {
    color: var(--color-text);
  }
  .case-nav__list :global(.case-nav__link:is(:hover, :focus-visible) .case-nav__tick) {
    width: 40px;
    background: var(--color-text);
    transition-delay: 0s;
  }
  @media (prefers-reduced-motion: reduce) {
    .case-nav__list :global(.case-nav__label),
    .case-nav__list :global(.case-nav__tick),
    .case-nav__list:hover :global(.case-nav__label),
    .case-nav__list:focus-within :global(.case-nav__label),
    .case-nav__list:hover :global(.case-nav__tick),
    .case-nav__list:focus-within :global(.case-nav__tick) {
      transition: none;
    }
  }
  /* Narrower screens: the pill with the section in view. */
  .case-nav__pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    /* As tall as the language switch, whose place it takes on phones. */
    min-height: 52px;
    padding: 0 var(--space-3) 0 var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    box-shadow: var(--shadow-rest);
    color: var(--color-text);
    font: 600 var(--font-size-small) / 1.2 var(--font-sans);
    white-space: nowrap;
    cursor: pointer;
    transition: scale var(--duration-fast) var(--ease-out);
  }
  .case-nav__pill:active {
    scale: 0.97;
  }
  .case-nav__pill:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
  .case-nav__pill-text {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .case-nav__pill-num {
    color: var(--color-text-muted);
    font: 500 12px / 1 var(--font-mono);
  }
  .case-nav__pill-num:empty {
    display: none;
  }
  .case-nav__pill-name {
    max-width: 11rem;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .case-nav__pill-chevron {
    color: var(--color-text-muted);
  }
  @media (min-width: 1320px) {
    .case-nav__pill {
      display: none;
    }
  }

  /* The unfolded index under the bar: the rail's ticks and names, right-aligned under the pill, in cascade. */
  .case-nav__drop {
    position: absolute;
    top: 100%;
    right: calc(-1 * var(--page-gutter));
    left: calc(-1 * var(--page-gutter));
    display: grid;
    justify-items: end;
    gap: 2px;
    margin: 0;
    padding: var(--space-3) var(--page-gutter) var(--space-10);
    list-style: none;
    background: color-mix(in srgb, var(--color-bg) 90%, transparent);
    backdrop-filter: blur(12px);
    mask-image: linear-gradient(to bottom, #000 calc(100% - var(--space-10)), transparent);
    visibility: hidden;
    opacity: 0;
    transition:
      opacity var(--duration-fast) var(--ease-out),
      visibility 0s linear var(--duration-fast);
  }
  .case-nav__drop[data-open] {
    visibility: visible;
    opacity: 1;
    transition: opacity var(--duration-fast) var(--ease-out);
  }
  @media (min-width: 1320px) {
    .case-nav__drop {
      display: none;
    }
  }
  .case-nav__drop :global(.case-nav__item:not(:first-child)) {
    margin-top: var(--space-2);
  }
  .case-nav__drop :global(.case-nav__link) {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 14px;
    min-height: 40px;
    color: var(--color-text-muted);
    font-size: var(--font-size-body);
    line-height: 1.2;
    text-decoration: none;
  }
  .case-nav__drop :global(.case-nav__label) {
    opacity: 0;
    translate: 12px 0;
    transition:
      opacity 0.15s var(--ease-out),
      translate var(--duration-fast) var(--ease-out);
  }
  .case-nav__drop :global(.case-nav__tick) {
    flex: none;
    width: 0;
    height: 2px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--color-text-muted) 55%, transparent);
    transition:
      width var(--duration-medium) var(--ease-spring),
      background-color var(--duration-medium) var(--ease-out);
  }
  .case-nav__drop[data-open] :global(.case-nav__label) {
    opacity: 1;
    translate: 0 0;
    transition:
      opacity var(--duration-fast) var(--ease-out) calc(var(--i) * 35ms + 60ms),
      translate var(--duration-medium) var(--ease-out) calc(var(--i) * 35ms + 60ms);
  }
  .case-nav__drop[data-open] :global(.case-nav__tick) {
    width: 24px;
    transition-delay: calc(var(--i) * 25ms);
  }
  .case-nav__drop :global(.case-nav__link[aria-current="true"]) {
    color: var(--color-text);
    font-weight: 600;
  }
  .case-nav__drop[data-open] :global(.case-nav__link[aria-current="true"] .case-nav__tick) {
    width: 36px;
    background: var(--color-accent);
  }
  .case-nav__drop :global(.case-nav__link:focus-visible) {
    outline: 2px solid var(--color-text-accent);
    outline-offset: 2px;
    border-radius: var(--radius-xs);
  }
  .case-nav__pill[aria-expanded="true"] .case-nav__pill-chevron {
    rotate: 180deg;
  }
  .case-nav__pill-chevron {
    transition: rotate var(--duration-medium) var(--ease-out);
  }

  @media (prefers-reduced-motion: reduce) {
    .case-nav__pill,
    .case-nav__pill-chevron,
    .case-nav__drop,
    .case-nav__drop[data-open],
    .case-nav__drop :global(.case-nav__label),
    .case-nav__drop :global(.case-nav__tick),
    .case-nav__drop[data-open] :global(.case-nav__label),
    .case-nav__drop[data-open] :global(.case-nav__tick) {
      transition: none;
    }
  }
</style>

<script>
  for (const nav of document.querySelectorAll<HTMLElement>(".case-nav")) {
    const rail = nav.querySelector<HTMLOListElement>(".case-nav__list");
    const drop = nav.querySelector<HTMLOListElement>(".case-nav__drop");
    const pill = nav.querySelector<HTMLButtonElement>(".case-nav__pill");
    const pillNum = nav.querySelector<HTMLElement>(".case-nav__pill-num");
    const pillName = nav.querySelector<HTMLElement>(".case-nav__pill-name");
    if (!rail || !drop || !pill || !pillNum || !pillName) continue;

    const reduce = () => matchMedia("(prefers-reduced-motion: reduce)").matches;
    const fold = (open: boolean) => {
      drop.toggleAttribute("data-open", open);
      pill.setAttribute("aria-expanded", String(open));
    };

    // One entry per heading, with a link in the rail and one in the pill's list.
    type Entry = { target: HTMLElement | null; links: HTMLAnchorElement[]; num: string; name: string };
    const entries: Entry[] = [];
    const link = (entry: Entry, list: HTMLOListElement, index: number) => {
      const item = document.createElement("li");
      item.className = "case-nav__item";
      const anchor = document.createElement("a");
      anchor.className = "case-nav__link";
      // The h1's entry is a plain "#": the top of the page, even without the script.
      anchor.href = entry.target ? `#${entry.target.id}` : "#";
      anchor.style.setProperty("--i", String(index));
      const name = document.createElement("span");
      name.className = "case-nav__label";
      name.textContent = entry.num ? `${entry.num} ${entry.name}` : entry.name;
      const tick = document.createElement("span");
      tick.className = "case-nav__tick";
      tick.setAttribute("aria-hidden", "true");
      anchor.append(name, tick);
      item.append(anchor);
      list.append(item);
      entry.links.push(anchor);
      anchor.addEventListener("click", (event) => {
        event.preventDefault();
        if (list === drop) fold(false);
        const behavior = reduce() ? "auto" : "smooth";
        if (entry.target) {
          entry.target.scrollIntoView({ behavior, block: "start" });
          history.replaceState(null, "", anchor.hash);
        } else {
          scrollTo({ top: 0, behavior });
          history.replaceState(null, "", location.pathname + location.search);
        }
        // A pointer click closes the rail; from the keyboard it stays open to go on.
        if (list === rail && event.detail > 0) anchor.blur();
      });
    };
    const add = (target: HTMLElement | null, label: string) => {
      const [first = "", ...rest] = label.split(" ");
      const numbered = /^\d+$/.test(first);
      const entry: Entry = {
        target,
        links: [],
        num: numbered ? first : "",
        name: numbered ? rest.join(" ") : label,
      };
      link(entry, rail, entries.length);
      link(entry, drop, entries.length);
      entries.push(entry);
    };
    const title = document.querySelector("h1")?.textContent?.trim();
    if (title) add(null, title);
    for (const section of document.querySelectorAll<HTMLElement>("[data-case-nav]"))
      if (section.id) add(section, section.dataset["caseNav"] ?? "");
    if (entries.length < 2) continue;
    nav.hidden = false;

    // The pill unfolds the list; the pill again, a tap outside or Esc folds it.
    pill.addEventListener("click", () => fold(!drop.hasAttribute("data-open")));
    document.addEventListener("pointerdown", (event) => {
      if (drop.hasAttribute("data-open") && !nav.contains(event.target as Node)) fold(false);
    });
    nav.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || !drop.hasAttribute("data-open")) return;
      fold(false);
      pill.focus();
    });

    // The entry in view: the last section whose top has passed 40% of the screen; the h1's until then.
    let frame = 0;
    const spy = () => {
      const line = innerHeight * 0.4;
      let current = entries[0];
      for (const entry of entries)
        if (entry.target && entry.target.getBoundingClientRect().top <= line) current = entry;
      if (!current) return;
      for (const entry of entries)
        for (const anchor of entry.links) {
          if (entry === current) anchor.setAttribute("aria-current", "true");
          else anchor.removeAttribute("aria-current");
        }
      pillNum.textContent = current.num;
      pillName.textContent = current.name;
    };
    addEventListener(
      "scroll",
      () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(spy);
      },
      { passive: true },
    );
    spy();
  }
</script>
