---
import ExampleFrame from "@/components/projects/case/ExampleFrame/ExampleFrame.astro";
import ExampleHint from "@/components/projects/case/ExampleFrame/ExampleHint/ExampleHint.astro";
import SegmentedSwitch from "@/components/ui/SegmentedSwitch/SegmentedSwitch.astro";
import Button from "@/components/ui/Button/Button.astro";
import { getLang } from "@/i18n/ui";
import { navigationCopy } from "./navigation.config";

import { imageMap } from "../assets";
import "../phone.css";

const lang = getLang(Astro);
const copy = navigationCopy[lang];
---

<div
  class="navigation-playground"
  data-navigation
  data-images={JSON.stringify(imageMap)}
  data-lang={lang}
  data-done={copy.doneAnnouncement}
  data-playing={copy.playingAnnouncement}
>
  <ExampleFrame id="meli-navigation" label={copy.label} shortLabel={copy.shortLabel}>
    <div class="navigation-playground__controls" slot="controls">
      <div class="navigation-playground__mode">
        <SegmentedSwitch
          name="meli-demo-mode"
          value="after"
          legend={copy.modeLegend}
          options={[
            { value: "before", label: copy.before },
            { value: "after", label: copy.after },
          ]}
        />
      </div>
      <span class="navigation-playground__reset" data-action="reset">
        <Button label={copy.reset} variant="ghost" size="sm">
          {copy.reset}
        </Button>
      </span>
    </div>

    <noscript>{copy.noscript}</noscript>
    <div class="navigation-playground__phones" data-show="after">
      <div class="navigation-playground__col" data-mode="before">
        <span class="navigation-playground__label">{copy.beforeTitle}</span>
        <div class="meli-phone-frame">
          <div
            class="navigation-playground__phone meli-phone"
            data-native
            data-screen="list"
            role="region"
            aria-label={copy.beforeRegion}
          ></div>
        </div>
        <p class="navigation-playground__stack" aria-hidden="true"></p>
        <p class="navigation-playground__result"></p>
      </div>
      <div class="navigation-playground__col" data-mode="after">
        <span class="navigation-playground__label">{copy.afterTitle}</span>
        <div class="meli-phone-frame">
          <div
            class="navigation-playground__phone meli-phone"
            data-native
            data-screen="list"
            role="region"
            aria-label={copy.afterRegion}
          ></div>
        </div>
        <p class="navigation-playground__stack" aria-hidden="true"></p>
        <p class="navigation-playground__result"></p>
      </div>
    </div>

    <ExampleHint slot="foot">
      <span class="navigation-playground__hint-wide">{copy.hint}</span>
      <span class="navigation-playground__hint-narrow">{copy.hintNarrow}</span>
    </ExampleHint>

    <Button slot="actions" size="sm" label={copy.play} />
  </ExampleFrame>
</div>

<style>
  .navigation-playground__mode {
    display: none;
  }
  @media (max-width: 719px) {
    .navigation-playground__mode {
      display: block;
    }
  }
  .navigation-playground__hint-narrow {
    display: none;
  }
  @media (max-width: 719px) {
    .navigation-playground__hint-wide {
      display: none;
    }
    .navigation-playground__hint-narrow {
      display: inline;
    }
  }
  .navigation-playground :global(.navigation-playground__phone .loader[hidden]) {
    display: none;
  }
  .navigation-playground__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
  }
  /* Phones: the switch takes the width, as in the other cases. No Reset there: Play starts from a clean state. */
  @media (max-width: 719px) {
    .navigation-playground__mode,
    .navigation-playground__mode > :global(.segmented-switch) {
      flex: 1 1 100%;
      width: 100%;
    }
    .navigation-playground__reset {
      display: none;
    }
  }
  .navigation-playground__phones {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(20px, 4vw, 56px);
    margin-top: 24px;
    justify-items: center;
  }
  .navigation-playground__col {
    width: 100%;
    max-width: 300px;
    display: grid;
    align-content: start;
    gap: 12px;
    justify-items: center;
  }
  .navigation-playground__label {
    font: 500 var(--font-size-label)/1.4 var(--font-mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-align: center;
  }
  .navigation-playground__stack {
    margin: 0;
    font: 12.5px/1.5 var(--font-mono);
    color: var(--color-text-muted);
    text-align: center;
    min-height: 1.5em;
  }
  .navigation-playground__result {
    margin: 0;
    min-height: 3.2em;
    text-align: center;
    font-size: var(--font-size-small);
    line-height: 1.45;
    color: var(--color-text);
    justify-self: stretch;
  }
  .navigation-playground__result[data-tone="good"] {
    color: #12805c;
  }
  .navigation-playground__result[data-tone="bad"] {
    color: #c73838;
  }
  .navigation-playground :global(.sr) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  @media (max-width: 719px) {
    .navigation-playground__phones {
      grid-template-columns: minmax(0, 1fr);
    }
    .navigation-playground__col {
      grid-area: 1/1;
    }
    /* One phone at a time: no room is kept for a result before there is one. */
    .navigation-playground__result:empty {
      display: none;
    }
    .navigation-playground__phones[data-show="before"] .navigation-playground__col[data-mode="after"],
    .navigation-playground__phones[data-show="after"] .navigation-playground__col[data-mode="before"] {
      visibility: hidden;
    }
  }
  :global(.navigation-playground .navigation-playground__phone .screen) {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    transition: transform 0.32s var(--ease-out);
    background: #fff;
  }
  :global(.navigation-playground .navigation-playground__phone .count) {
    margin-left: auto;
    margin-right: 6px;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.08);
    font: 500 13px/1.2 var(--font-mono);
    color: #000;
  }
  :global(.navigation-playground .navigation-playground__phone .n-search) {
    flex: 1;
    margin: 0 8px 0 4px;
    padding: 11px 14px;
    border-radius: 8px;
    background: #fff;
    color: var(--m-2);
    font-size: 15px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  :global(.navigation-playground .navigation-playground__phone .n-tabs) {
    flex: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    height: 54px;
    border-bottom: 1px solid var(--m-line);
    font-size: 18px;
    font-weight: 500;
  }
  :global(.navigation-playground .navigation-playground__phone .n-tabs span) {
    display: grid;
    place-items: center;
    border-bottom: 3px solid transparent;
  }
  :global(.navigation-playground .navigation-playground__phone .n-tabs .on) {
    color: var(--m-blue);
    border-color: var(--m-blue);
  }
  :global(.navigation-playground .navigation-playground__phone .scroller) {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: auto;
    scroll-behavior: auto;
    background: #ededed;
  }
  :global(.navigation-playground .navigation-playground__phone ul) {
    list-style: none;
    margin: 0;
    padding: 0;
    background: #fff;
  }
  :global(.navigation-playground .navigation-playground__phone li button) {
    all: unset;
    box-sizing: border-box;
    width: 100%;
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr) auto;
    align-items: start;
    gap: 14px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--m-line);
    cursor: pointer;
  }
  @media (hover: hover) {
    :global(.navigation-playground .navigation-playground__phone li button:hover) {
      background: rgb(0 0 0 / 0.03);
    }
  }
  :global(.navigation-playground .navigation-playground__phone li button:focus-visible) {
    outline: 2px solid var(--m-blue);
    outline-offset: -2px;
  }
  :global(.navigation-playground .navigation-playground__phone li img) {
    width: 112px;
    height: 112px;
    object-fit: contain;
    background: #fff;
  }
  :global(.navigation-playground .navigation-playground__phone .n-info) {
    display: grid;
    gap: 3px;
    min-width: 0;
  }
  :global(.navigation-playground .navigation-playground__phone .n-t) {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 17px;
    line-height: 1.3;
  }
  :global(.navigation-playground .navigation-playground__phone .n-p) {
    font-size: 24px;
    line-height: 1.2;
  }
  :global(.navigation-playground .navigation-playground__phone .n-s) {
    font-size: 15px;
    font-weight: 600;
    color: var(--m-green);
  }
  :global(.navigation-playground .navigation-playground__phone .n-i) {
    font: 12px/1 var(--font-mono);
    color: var(--m-2);
    padding-top: 3px;
  }
  :global(.navigation-playground .navigation-playground__phone li[data-hit="true"] button) {
    background: rgb(52 131 250 / 0.1);
  }
  :global(.navigation-playground .navigation-playground__phone .loader) {
    display: grid;
    place-items: center;
    padding: 22px;
    margin: 0;
    background: #fff;
  }
  :global(.navigation-playground .navigation-playground__phone .loader i),
  :global(.navigation-playground .navigation-playground__phone .n-loading i) {
    display: block;
    width: 34px;
    height: 34px;
    border: 4px solid var(--m-blue);
    border-right-color: transparent;
    border-radius: 50%;
    animation: meli-nav-spin 0.8s linear infinite;
  }
  @keyframes meli-nav-spin {
    to {
      transform: rotate(360deg);
    }
  }
  :global(.navigation-playground .navigation-playground__phone .n-loading) {
    position: absolute;
    inset: 108px 0 0;
    z-index: 2;
    display: none;
    place-items: center;
    background: #fff;
  }
  :global(.navigation-playground .navigation-playground__phone[data-loading="true"] .n-loading) {
    display: grid;
  }
  :global(.navigation-playground .navigation-playground__phone .detail) {
    transform: translateX(100%);
  }
  :global(.navigation-playground .navigation-playground__phone[data-screen="detail"] .detail) {
    transform: none;
  }
  :global(.navigation-playground .navigation-playground__phone[data-screen="detail"] .list-screen) {
    transform: translateX(-24%);
  }
  :global(.navigation-playground .navigation-playground__phone .detail .body) {
    padding: 18px 18px 22px;
    display: grid;
    gap: 8px;
    align-content: start;
    overflow: hidden;
  }
  :global(.navigation-playground .navigation-playground__phone .detail h3) {
    margin: 0;
    font-size: 20px;
    font-weight: 400;
    line-height: 1.3;
  }
  :global(.navigation-playground .navigation-playground__phone .d-new) {
    font-size: 14px;
    color: var(--m-2);
  }
  :global(.navigation-playground .navigation-playground__phone .d-img) {
    width: 100%;
    height: 250px;
    object-fit: contain;
    background: #fff;
  }
  :global(.navigation-playground .navigation-playground__phone .detail p) {
    margin: 0;
  }
  :global(.navigation-playground .navigation-playground__phone .d-price) {
    font-size: 32px;
    line-height: 1.15;
  }
  :global(.navigation-playground .navigation-playground__phone .d-q) {
    font-size: 15px;
    color: var(--m-green);
  }
  :global(.navigation-playground .navigation-playground__phone .d-buy),
  :global(.navigation-playground .navigation-playground__phone .d-cart) {
    display: grid;
    place-items: center;
    height: 52px;
    border-radius: 8px;
    font-size: 18px;
    font-weight: 600;
    margin-top: 8px;
  }
  :global(.navigation-playground .navigation-playground__phone .d-buy) {
    background: var(--m-blue);
    color: #fff;
  }
  :global(.navigation-playground .navigation-playground__phone .d-cart) {
    background: rgb(52 131 250 / 0.15);
    color: #2968c8;
    margin-top: 0;
  }
</style>
<script>
  import "./navigation";
</script>
