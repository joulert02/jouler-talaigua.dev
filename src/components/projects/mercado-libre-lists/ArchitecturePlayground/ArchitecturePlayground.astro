---
import ExampleFrame from "@/components/projects/case/ExampleFrame/ExampleFrame.astro";
import ExampleHint from "@/components/projects/case/ExampleFrame/ExampleHint/ExampleHint.astro";
import SegmentedSwitch from "@/components/ui/SegmentedSwitch/SegmentedSwitch.astro";
import Button from "@/components/ui/Button/Button.astro";
import { getLang } from "@/i18n/ui";
import { imageMap } from "../assets";
import { architecture, type CardId } from "./architecture.config";

const { text, title, cards, price, old, image } = architecture(getLang(Astro));
const src = imageMap[image as keyof typeof imageMap];
const on = (id: CardId) => (id === cards[0]?.id ? "" : undefined);
const [apisStep, bffStep, screenStep] = text.steps;
---

<!--
  Mercado Libre · 04 (owner review, 2026-11-25): how a BFF builds a card. It calls several APIs, takes what the card
  needs, returns one response and the screen shows it. Three columns on desktop; phones show one step at a time (plain
  radios and CSS). Both cards are in the page, one over the other, so nothing moves when they change.
-->
<div
  class="architecture-playground"
  data-architecture
  data-copy={JSON.stringify({ play: text.play, playAgain: text.playAgain, said: text.said })}
>
  <ExampleFrame id="meli-architecture" label={text.label} shortLabel={text.label}>
    <div class="architecture-playground__switch" slot="controls">
      <SegmentedSwitch
        name="meli-card"
        legend={text.legend}
        options={cards.map((card) => ({ value: card.id, label: card.label }))}
      />
    </div>

    <noscript>{text.noscript}</noscript>
    <div class="architecture-playground__steps" role="group" aria-label={text.stepsLegend}>
      <div class="architecture-playground__step">
        <label class="architecture-playground__title">
          <input class="architecture-playground__radio" type="radio" name="meli-step" value="1" checked />
          <span class="architecture-playground__long">{apisStep.title}</span>
          <span class="architecture-playground__short">{apisStep.short}</span>
        </label>
        <div class="architecture-playground__stack">
          {cards.map((card) => (
            <div class="architecture-playground__layer" data-card={card.id} data-on={on(card.id)}>
              <p class="architecture-playground__root">BFF</p>
              <dl class="architecture-playground__apis">
                {card.calls.map((call) => (
                  <div class="architecture-playground__api">
                    <dt>{text.apis[call.api]}</dt>
                    <dd class="architecture-playground__fields">
                      {call.takes.map((field) => (
                        <b class="architecture-playground__field">{field}</b>
                      ))}
                      {call.leaves.map((field) => (
                        <span class="architecture-playground__field">{field}</span>
                      ))}
                    </dd>
                  </div>
                ))}
              </dl>
            </div>
          ))}
        </div>
      </div>
      <div class="architecture-playground__step">
        <label class="architecture-playground__title">
          <input class="architecture-playground__radio" type="radio" name="meli-step" value="2" />
          <span class="architecture-playground__long">{bffStep.title}</span>
          <span class="architecture-playground__short">{bffStep.short}</span>
        </label>
        <div class="architecture-playground__stack">
          {cards.map((card) => (
            <code
              class="architecture-playground__layer architecture-playground__response"
              data-card={card.id}
              data-on={on(card.id)}
            >
              <span>{"{"}</span>
              {card.response.map(([key, value], index) => (
                <span class="architecture-playground__line">
                  <span class="architecture-playground__key">{key}</span>: {JSON.stringify(value)}
                  {index < card.response.length - 1 && ","}
                </span>
              ))}
              <span>{"}"}</span>
            </code>
          ))}
        </div>
      </div>
      <div class="architecture-playground__step">
        <label class="architecture-playground__title">
          <input class="architecture-playground__radio" type="radio" name="meli-step" value="3" />
          <span class="architecture-playground__long">{screenStep.title}</span>
          <span class="architecture-playground__short">{screenStep.short}</span>
        </label>
        <div class="architecture-playground__stack">
          {cards.map((card) => (
            <div
              class="architecture-playground__layer architecture-playground__view"
              data-card={card.id}
              data-on={on(card.id)}
            >
              <img class="architecture-playground__image" src={src} alt="" width="72" height="72" />
              <div>
                <p class="architecture-playground__name">{card.id === "list" ? text.listName : title}</p>
                {card.id === "list" ? (
                  <p class="architecture-playground__detail">{text.count}</p>
                ) : (
                  <>
                    <p class="architecture-playground__detail">
                      <s>$ {old}</s>
                    </p>
                    <p class="architecture-playground__price">$ {price}</p>
                    <p class="architecture-playground__detail architecture-playground__detail--good">
                      {text.freeShipping}
                    </p>
                  </>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <ExampleHint slot="foot">
      <span class="architecture-playground__long">{text.hint}</span>
      <span class="architecture-playground__captions">
        {text.steps.map((step) => (
          <span class="architecture-playground__caption">{step.caption}</span>
        ))}
      </span>
    </ExampleHint>
    <Button slot="actions" size="sm" label={text.play} />
  </ExampleFrame>
</div>

<style>
  .architecture-playground {
    --_good: #12805c;
    --_gap: clamp(24px, 3vw, 48px);
    container-type: inline-size;
  }
  .architecture-playground__steps {
    display: grid;
    gap: 20px 32px;
    margin: clamp(20px, 3vw, 32px) 0;
  }
  .architecture-playground__step {
    min-width: 0;
  }
  .architecture-playground__title {
    display: block;
    margin: 0 0 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font: 500 14px/1.4 var(--font-mono);
    transition:
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }
  .architecture-playground__step[data-now] .architecture-playground__title {
    border-color: currentColor;
    color: var(--color-text-accent);
  }
  .architecture-playground__stack {
    display: grid;
  }
  .architecture-playground__layer {
    grid-area: 1 / 1;
    visibility: hidden;
  }
  .architecture-playground__layer[data-on] {
    visibility: inherit;
  }
  .architecture-playground__root {
    margin: 0;
    color: var(--color-text-accent);
    font: 500 14px/1.4 var(--font-mono);
  }
  .architecture-playground__apis {
    margin: 0;
    padding-left: 10px;
    font: 14px/1.5 var(--font-mono);
  }
  /* The calls hang from the BFF: one line down, one branch per API. */
  .architecture-playground__api {
    position: relative;
    padding: 8px 0 0 22px;
    color: var(--color-text);
  }
  .architecture-playground__api::before,
  .architecture-playground__api::after {
    content: "";
    position: absolute;
    left: 0;
    background: var(--color-text-muted);
  }
  .architecture-playground__api::before {
    top: 0;
    bottom: 0;
    width: 1px;
  }
  .architecture-playground__api:last-child::before {
    bottom: auto;
    height: 19px;
  }
  .architecture-playground__api::after {
    top: 18px;
    width: 14px;
    height: 1px;
  }
  .architecture-playground__fields {
    display: flex;
    flex-wrap: wrap;
    gap: 0 2ch;
    margin: 0;
  }
  .architecture-playground__field {
    color: var(--color-text-muted);
    font-weight: 400;
  }
  b.architecture-playground__field {
    color: var(--color-text-accent);
    font-weight: 500;
  }
  .architecture-playground__response {
    display: block;
    color: var(--color-text);
    font: 14px/1.55 var(--font-mono);
    overflow-wrap: anywhere;
  }
  .architecture-playground__response > span {
    display: block;
  }
  .architecture-playground__line {
    padding-left: 2ch;
  }
  .architecture-playground__key {
    color: var(--color-text-accent);
  }
  .architecture-playground__view {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 14px;
    align-items: center;
    align-self: start;
    padding: 12px;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-surface);
  }
  .architecture-playground__image {
    width: 72px;
    height: 72px;
    border-radius: 8px;
    background: #fff;
    object-fit: contain;
  }
  .architecture-playground__name {
    margin: 0;
    color: var(--color-text);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.35;
  }
  .architecture-playground__detail {
    margin: 4px 0 0;
    color: var(--color-text-secondary);
    font-size: 14px;
    line-height: 1.5;
  }
  .architecture-playground__detail--good {
    color: var(--_good);
  }
  .architecture-playground__price {
    margin: 4px 0 0;
    color: var(--color-text);
    font-size: 20px;
    font-weight: 500;
    line-height: 1.3;
    white-space: nowrap;
  }
  /* While it plays, what has not happened yet waits dimmed. */
  .architecture-playground__stack,
  .architecture-playground__api {
    transition: opacity var(--duration-medium) var(--ease-out);
  }
  .architecture-playground[data-playing]
    .architecture-playground__step:not([data-done])
    .architecture-playground__stack,
  .architecture-playground[data-playing] .architecture-playground__api:not([data-done]) {
    opacity: 0.2;
  }
  .architecture-playground__short,
  .architecture-playground__radio,
  .architecture-playground__captions {
    display: none;
  }
  .architecture-playground__switch > :global(.segmented-switch) {
    width: 100%;
  }
  /* Phones: one step at a time under its three names, so the demo and its button fit on one screen. */
  @media (max-width: 719px) {
    .architecture-playground__steps {
      grid-template-columns: auto auto auto;
      gap: 0;
      margin: 18px 0 0;
    }
    .architecture-playground__step {
      display: contents;
    }
    .architecture-playground__title {
      position: relative;
      grid-row: 1;
      margin-bottom: 16px;
      padding: 12px 0;
      border-bottom-width: 2px;
      text-align: center;
      cursor: pointer;
    }
    .architecture-playground__title:has(:checked) {
      border-color: currentColor;
      color: var(--color-text-accent);
    }
    .architecture-playground__title:has(:focus-visible) {
      outline: 2px solid var(--color-text-accent);
      outline-offset: 2px;
      border-radius: 6px;
    }
    .architecture-playground__radio {
      position: absolute;
      display: block;
      width: 1px;
      height: 1px;
      margin: 0;
      opacity: 0;
    }
    .architecture-playground__stack {
      grid-row: 2;
      grid-column: 1 / -1;
      visibility: hidden;
    }
    .architecture-playground__title:has(:checked) + .architecture-playground__stack {
      visibility: visible;
    }
    .architecture-playground__long {
      display: none;
    }
    .architecture-playground__short {
      display: inline;
    }
    .architecture-playground__captions {
      display: grid;
    }
    .architecture-playground__caption {
      grid-area: 1 / 1;
      visibility: hidden;
    }
    .architecture-playground:has([value="1"]:checked) .architecture-playground__caption:nth-child(1),
    .architecture-playground:has([value="2"]:checked) .architecture-playground__caption:nth-child(2),
    .architecture-playground:has([value="3"]:checked) .architecture-playground__caption:nth-child(3) {
      visibility: visible;
    }
  }
  @media (min-width: 720px) {
    .architecture-playground__steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .architecture-playground__step:first-child {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 900px) {
    .architecture-playground__steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--_gap);
    }
    .architecture-playground__step:first-child {
      grid-column: auto;
    }
    .architecture-playground__view {
      padding: 16px;
    }
    /* As wide as the column of the screen below it: the frame less its padding, in three. */
    .architecture-playground__switch {
      width: calc((100cqi - 2px - 2 * clamp(16px, 3vw, 32px) - 2 * var(--_gap)) / 3);
      min-width: max-content;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .architecture-playground__title,
    .architecture-playground__stack,
    .architecture-playground__api {
      transition: none;
    }
  }
  :global([data-theme="dark"]) .architecture-playground {
    --_good: #4fd1a1;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .architecture-playground {
      --_good: #4fd1a1;
    }
  }
</style>

<script>
  import { mountArchitecture } from "./architecture";

  document.querySelectorAll<HTMLElement>("[data-architecture]").forEach(mountArchitecture);
</script>
