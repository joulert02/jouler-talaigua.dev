---
import Icon from "../../../ui/Icon/Icon.astro";
import { getLang, useTranslations } from "../../../../i18n/ui";
interface Props {
  /** Id of the section it leads to (the first chapter). */
  target: string;
}
const { target } = Astro.props;
const t = useTranslations(getLang(Astro));
---

<!--
  "See what we built" (v11 `.intro-c-cta`): fixed at the bottom centre with a gentle bounce; once the reader scrolls it
  fades out and leaves the Tab order. It smooth-scrolls to the first chapter (instantly with reduced motion).
-->
<a class="case-jump" href={`#${target}`} data-case-jump>
  <span>{t("case.seeBuilt")}</span>
  <Icon name="arrow-down" size={18} />
</a>

<style>
  .case-jump {
    position: fixed;
    z-index: 30;
    left: 50%;
    bottom: calc(20px + env(safe-area-inset-bottom, 0px));
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 0 20px 0 22px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    box-shadow: var(--shadow-rest);
    color: var(--color-text);
    font-size: 15.5px;
    font-weight: 500;
    text-decoration: none;
    /* With left: 50% the pill only gets half the screen to grow into; keep the label on one line. */
    white-space: nowrap;
    transform: translateX(-50%);
    transition:
      opacity 0.45s var(--ease-out),
      transform 0.55s var(--ease-out),
      visibility 0s linear 0s;
  }
  .case-jump :global(svg) {
    color: var(--color-text-accent);
  }
  .case-jump:focus-visible {
    outline: 2px solid var(--color-text-accent);
    outline-offset: 3px;
  }
  .case-jump[data-gone] {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 18px);
    transition:
      opacity 0.45s var(--ease-out),
      transform 0.55s var(--ease-out),
      visibility 0s linear 0.55s;
  }
  @keyframes case-jump-bounce {
    50% {
      translate: 0 -6px;
    }
  }
  @keyframes case-jump-arrow {
    50% {
      transform: translateY(3px);
    }
  }
  @media (min-width: 720px) {
    .case-jump {
      bottom: 28px;
    }
  }
  @media (hover: hover) {
    .case-jump:hover {
      border-color: color-mix(in srgb, var(--color-text-accent) 45%, var(--color-border));
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .case-jump:not([data-gone]) {
      animation: case-jump-bounce 2.2s ease-in-out 1.2s infinite;
    }
    .case-jump:not([data-gone]) :global(svg) {
      animation: case-jump-arrow 2.2s ease-in-out 1.2s infinite;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .case-jump,
    .case-jump[data-gone] {
      transition: none;
    }
  }
</style>

<script>
  for (const jump of document.querySelectorAll<HTMLAnchorElement>("[data-case-jump]")) {
    const sync = () => {
      const gone = scrollY > 48;
      jump.toggleAttribute("data-gone", gone);
      if (gone) {
        jump.setAttribute("tabindex", "-1");
        jump.setAttribute("aria-hidden", "true");
      } else {
        jump.removeAttribute("tabindex");
        jump.removeAttribute("aria-hidden");
      }
    };
    addEventListener("scroll", sync, { passive: true });
    sync();
    jump.addEventListener("click", (event) => {
      const target = document.getElementById(jump.hash.slice(1));
      if (!target) return;
      event.preventDefault();
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      target.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "start" });
      history.replaceState(null, "", jump.hash);
    });
  }
</script>
