---
import { Image } from "astro:assets";
import WorkTag from "../WorkTag/WorkTag.astro";
import type { WorkItem } from "../types";
interface Props {
  /** The projects of the list, in its order. The first one shows until a row is pointed at or focused. */
  items: readonly WorkItem[];
}
const { items } = Astro.props;
---

<!-- Decorative: every row already says what its preview shows. -->
<div class="work-preview" aria-hidden="true">
  <div class="work-preview__frame">
    {items.map((item, index) => (
      <div class="work-preview__slide" data-work-slug={item.slug} data-active={index === 0 ? "" : undefined}>
        {item.cover ? (
          <Image
            class="work-preview__image"
            src={item.cover}
            alt=""
            widths={[520, 1040]}
            sizes="(min-width: 901px) 520px, 0px"
            loading={index === 0 ? "eager" : "lazy"}
          />
        ) : (
          <div class="work-preview__tile">
            <span class="work-preview__tags">
              {item.tags.map((tag) => (
                <WorkTag tag={tag} />
              ))}
            </span>
            <b class="work-preview__title">{item.title}</b>
          </div>
        )}
      </div>
    ))}
  </div>
  {items.map((item, index) => (
    <p class="work-preview__caption" data-work-slug={item.slug} data-active={index === 0 ? "" : undefined}>
      {item.company} · {item.title}
    </p>
  ))}
</div>

<style>
  .work-preview__frame {
    display: grid;
    aspect-ratio: 16 / 10; /* close to the covers' own shape, so they fill it */
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-bg-subtle);
  }
  /* Every slide sits in the same cell; only the active one shows, with a short crossfade. */
  .work-preview__slide {
    grid-area: 1 / 1;
    display: grid;
    place-items: center;
    min-height: 0;
    opacity: 0;
    transition: opacity var(--duration-fast) var(--ease-out);
  }
  .work-preview__slide[data-active] {
    opacity: 1;
  }
  .work-preview__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .work-preview__tile {
    display: grid;
    gap: var(--space-3);
    justify-items: center;
    padding: var(--space-6);
    text-align: center;
  }
  .work-preview__tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
  }
  .work-preview__title {
    color: var(--color-text);
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .work-preview__caption {
    display: none;
    margin: var(--space-3) 0 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
  }
  .work-preview__caption[data-active] {
    display: block;
  }
  @media (prefers-reduced-motion: reduce) {
    .work-preview__slide {
      transition: none;
    }
  }
</style>
