---
import { Image } from "astro:assets";
import WorkTag from "../WorkTag/WorkTag.astro";
import type { WorkItem } from "../types";
import { getLang, useTranslations } from "../../../../i18n/ui";
interface Props {
  /** The project. With `href` the row is a link to its case; without one it is plain text, tagged as coming. */
  item: WorkItem;
  /** Whether the Work preview starts on this row (the first one). */
  active?: boolean;
}
const { item, active = false } = Astro.props;
const t = useTranslations(getLang(Astro));
const summaryId = `work-summary-${item.slug}`;
---

<!--
  The title is the link; its ::after stretches over the whole row, so the row is one big target while the "See more"
  button (touch and narrow screens, WorkList's script) can sit above it instead of inside a link.
-->
<li
  class:list={["work-row", item.href && "work-row--link"]}
  data-work-slug={item.slug}
  data-active={active ? "" : undefined}
>
  <div class="work-row__body">
    <span class="work-row__company" translate="no">
      {item.company}
    </span>
    <strong class="work-row__title">
      {item.href ? (
        <a class="work-row__link" href={item.href} id={`row-${item.slug}`}>
          {item.title}
        </a>
      ) : (
        item.title
      )}
      {item.tags.map((tag) => (
        <WorkTag tag={tag} />
      ))}
    </strong>
    <span class="work-row__summary" id={summaryId}>
      {item.summary}
    </span>
    <button
      class="work-row__more"
      type="button"
      aria-controls={summaryId}
      aria-expanded="false"
      data-more={t("work.more")}
      data-less={t("work.less")}
      hidden
    >
      {t("work.more")}
    </button>
    {item.focus.length > 0 && <span class="work-row__focus">{item.focus.join(" · ")}</span>}
    {item.cover && (
      <Image
        class="work-row__cover"
        src={item.cover}
        alt=""
        widths={[400, 800]}
        sizes="(max-width: 900px) calc(100vw - 40px), 0px"
        loading="lazy"
      />
    )}
    {item.href && (
      <span class="work-row__arrow" aria-hidden="true">
        →
      </span>
    )}
  </div>
</li>

<style>
  .work-row {
    position: relative;
    border-bottom: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }
  .work-row__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 24px;
    gap: 5px var(--space-3);
    padding-block: var(--space-6);
    color: var(--color-text);
    transition: opacity var(--duration-fast) var(--ease-out);
  }
  .work-row__link {
    /* Opened at `#row-<slug>` (back from a case), the row lands mid-screen instead of at the top edge. */
    scroll-margin-top: 40svh;
    color: inherit;
    text-decoration: none;
    outline: none;
  }
  /* The whole row is the link's target. */
  .work-row__link::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .work-row:has(.work-row__link:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
  .work-row__company {
    grid-column: 1;
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
    line-height: 1.5;
  }
  /* Flex, so a tag that wraps starts its own line flush left. */
  .work-row__title {
    grid-column: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: clamp(22px, 2.2vw, 30px);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.025em;
    transition: color var(--duration-fast) var(--ease-out);
  }
  .work-row__summary {
    grid-column: 1;
    max-width: var(--measure-prose);
    margin-top: var(--space-1);
    color: var(--color-text-secondary);
    font-size: 15px;
    line-height: 1.6;
  }
  /* Above the stretched link, so tapping it expands the summary instead of opening the case. */
  .work-row__more {
    grid-column: 1;
    justify-self: start;
    position: relative;
    z-index: 1;
    margin: -2px 0 2px;
    padding: 4px 0;
    border: 0;
    background: none;
    color: var(--color-text-accent);
    font: 500 var(--font-size-small) / 1.4 var(--font-sans);
    cursor: pointer;
  }
  .work-row__more[hidden] {
    display: none;
  }
  .work-row__focus {
    grid-column: 1;
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
    line-height: var(--line-height-compact);
  }
  /* Desktop shows the cover in WorkList's preview instead. */
  .work-row__cover {
    display: none;
  }
  .work-row__arrow {
    grid-column: 2;
    grid-row: 1 / 6;
    align-self: center;
    color: var(--color-text-accent);
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }
  .work-row--link:hover .work-row__arrow,
  .work-row:has(.work-row__link:focus-visible) .work-row__arrow {
    opacity: 1;
    transform: none;
  }
  /* Minimal variant (default, v11): no summary, "See more" or cover; the row is company, title and focus. */
  :global(.work-list:not([data-variant="detail"]))
    :is(.work-row__summary, .work-row__more, .work-row__cover) {
    display: none;
  }
  /* Its focus line takes the summary's place and size (v11 meta). */
  :global(.work-list:not([data-variant="detail"])) .work-row__focus {
    margin-top: var(--space-1);
    font-size: 15px;
    line-height: 1.6;
  }
  /* Touch and narrow screens: the arrow of the active row hops instead of a hover (WorkList). */
  @media (hover: none), (max-width: 900px) {
    .work-row__title {
      font-size: 24px;
    }
  }
  /*
   * Detail variant on touch and narrow screens: one text column with no arrow, the summary cut to two lines with
   * "See more", and the cover below the text. Pressing or focusing a row turns its title to the accent colour.
   */
  @media (hover: none), (max-width: 900px) {
    :global(.work-list[data-variant="detail"]) .work-row__body {
      grid-template-columns: minmax(0, 1fr);
    }
    :global(.work-list[data-variant="detail"]) .work-row__arrow {
      display: none;
    }
    :global(.work-list[data-variant="detail"]) .work-row__summary {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      overflow: hidden;
    }
    :global(.work-list[data-variant="detail"]) .work-row[data-expanded] .work-row__summary {
      -webkit-line-clamp: unset;
    }
    :global(.work-list[data-variant="detail"])
      .work-row:has(.work-row__link:is(:active, :focus-visible))
      .work-row__title {
      color: var(--color-text-accent);
    }
    .work-row__cover {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 10;
      margin-top: var(--space-3);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      background: var(--color-bg-subtle);
      object-fit: cover;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .work-row__body,
    .work-row__title,
    .work-row__arrow {
      transition: none;
    }
  }
</style>
