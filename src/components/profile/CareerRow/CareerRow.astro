---
import { localized, type CareerItem } from "../../../config/profile";
import { getLang } from "../../../i18n/ui";
interface Props {
  item: CareerItem;
}
const { item } = Astro.props;
const lang = getLang(Astro);
---

<li class="career-row">
  <span class="career-row__company" translate="no">
    {item.company}
  </span>
  <span class="career-row__role">{item.role[lang]}</span>
  <span class="career-row__years">{localized(item.years, lang)}</span>
</li>
<style>
  .career-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0 var(--space-3);
    padding: 10px 0;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
    font: var(--font-size-body)/var(--line-height-compact) var(--font-sans);
    overflow-wrap: anywhere;
  }
  .career-row__company {
    font-weight: 500;
  }
  .career-row__role {
    grid-column: 1;
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
  }
  .career-row__years {
    grid-column: 2;
    grid-row: 1;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--font-size-small);
    font-variant-numeric: tabular-nums;
  }
</style>
