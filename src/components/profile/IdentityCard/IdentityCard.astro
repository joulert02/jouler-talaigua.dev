---
import Button from "../../ui/Button/Button.astro";
import JotaMark from "../../ui/JotaMark/JotaMark.astro";
import CareerPath from "../CareerPath/CareerPath.astro";
import { identity, localized, type IdentityData } from "../../../config/profile";
import { getLang, useTranslations } from "../../../i18n/ui";
interface Props {
  data?: IdentityData;
}
const { data = identity } = Astro.props;
const lang = getLang(Astro);
const t = useTranslations(lang);
---

<article class="identity-card">
  <JotaMark data={data.brand} />
  <div class="identity-card__who">
    <h1 class="identity-card__name" translate="no">
      {data.brand.name}
    </h1>
    <p class="identity-card__role">{data.role[lang]}</p>
  </div>
  <p class="identity-card__sentence">{data.sentence[lang]}</p>
  <div class="identity-card__actions">
    <Button label={t(data.contact.label)} href={localized(data.contact.href, lang)} />
    <Button label={t(data.cv.label)} href={localized(data.cv.href, lang)} variant="ghost" />
  </div>
  <div class="identity-card__links">
    {data.links.map((link) => (
      <a
        class="identity-card__link"
        href={localized(link.href, lang)}
        target={link.target}
        rel={link.target === "_blank" ? "noopener noreferrer" : undefined}
      >
        {t(link.label)}
      </a>
    ))}
  </div>
  <CareerPath items={data.career} />
</article>
<style>
  .identity-card {
    --_radius: 18px;
    --_width: 540px;
    --_padding: clamp(24px, 4vw, 40px);
    display: grid;
    gap: 18px;
    width: 100%;
    max-width: var(--_width);
    padding: var(--_padding);
    border: 1px solid var(--color-border);
    border-radius: var(--_radius);
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: var(--shadow-rest);
    font: var(--font-size-body)/var(--line-height-body) var(--font-sans);
    overflow-wrap: anywhere;
  }
  /* v11 `.card .mark`: a quieter mark inside the card. */
  .identity-card :global(.jota-mark) {
    --_mark-size: 21px;
    width: fit-content;
    min-height: auto;
    gap: var(--space-2);
    color: var(--color-text-muted);
  }
  .identity-card__who {
    display: grid;
    gap: 2px;
  }
  .identity-card__name {
    margin: 0;
    font-size: var(--font-size-display);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .identity-card__role {
    margin: 0;
    font-size: var(--font-size-lead);
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--color-text-muted);
  }
  .identity-card__sentence {
    margin: 0;
    font-size: var(--font-size-lead);
    line-height: 1.55;
    letter-spacing: -0.01em;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }
  .identity-card__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
  .identity-card__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 18px;
  }
  /* v11 `.ulink`: the underline grows from the left on hover. */
  .identity-card__link {
    padding-bottom: 1px;
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition:
      background-size 250ms var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }
  .identity-card__link:hover {
    color: var(--color-text-accent);
    background-size: 100% 1px;
  }
  .identity-card__link:focus-visible {
    outline: 2px solid var(--color-text-accent);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }
  @media (max-width: 560px) {
    .identity-card {
      padding: var(--space-6);
    }
    .identity-card__name {
      font-size: 2rem;
    }
  }
  /* v11 desktop (the card on the desk): tighter padding and gap, a smaller sentence and career rows. */
  @media (min-width: 901px) {
    .identity-card {
      padding: 28px;
      gap: 15px;
    }
    .identity-card__sentence {
      font-size: 1.125rem;
    }
    .identity-card :global(.career-row) {
      padding-block: var(--space-2);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .identity-card__link {
      transition: none;
    }
  }
</style>
