---
import { cvLink, localized, type ProfileLink } from "../../../config/profile";
import { getLang, useTranslations } from "../../../i18n/ui";
interface Props {
  /** The CV link: one PDF per language. */
  data?: ProfileLink;
}
const { data = cvLink } = Astro.props;
const lang = getLang(Astro);
const t = useTranslations(lang);
---

<!-- Downloads the PDF for the page's language instead of navigating to it, so the visitor stays on the site. -->
<a class="cv-download" href={localized(data.href, lang)} download>
  {t(data.label)}
</a>
<style>
  /* Looks like the ghost Button (ui/Button); it is its own component because only the CV downloads a file. */
  .cv-download {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: 12px 18px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-text);
    font: 500 0.9375rem/1 var(--font-sans);
    text-decoration: none;
    text-align: center;
    overflow-wrap: anywhere;
    cursor: pointer;
    transition:
      transform var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }
  .cv-download:hover {
    background: var(--color-surface-hover);
  }
  .cv-download:active {
    transform: scale(0.97);
  }
  .cv-download:focus-visible {
    outline: 2px solid var(--color-text-accent);
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: reduce) {
    .cv-download {
      transition: none;
    }
    .cv-download:active {
      transform: none;
    }
  }
</style>
