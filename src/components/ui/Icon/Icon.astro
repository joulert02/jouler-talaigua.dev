---
interface Props {
  name: "home" | "work" | "notes" | "roadmap" | "email" | "theme" | "settings";
}
const { name } = Astro.props;
---

<svg
  viewBox="0 0 20 20"
  aria-hidden="true"
  width="20"
  height="20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {name === "home" && <path d="M3.5 9 10 3.5 16.5 9v7a1 1 0 0 1-1 1h-3.5v-4.5h-4V17H4.5a1 1 0 0 1-1-1Z" />}
  {name === "work" && (
    <>
      <rect x="2.5" y="6" width="15" height="11" rx="2" />
      <path d="M7 6V4.5A1.5 1.5 0 0 1 8.5 3h3A1.5 1.5 0 0 1 13 4.5V6M2.5 10.5h15" />
    </>
  )}
  {name === "notes" && (
    <>
      <path d="M5 2.5h7.5L16 6v11.5H5Z" />
      <path d="M8 9.5h5M8 12.5h5" stroke-linecap="round" />
    </>
  )}
  {name === "roadmap" && (
    <>
      <!-- Rocket from the v5 dock (docs/design/v5/index.html). -->
      <path d="M10 2c3 2.5 4.2 6 3.8 10.5H6.2C5.8 8 7 4.5 10 2Z" />
      <circle cx="10" cy="8" r="1.6" fill="currentColor" stroke="none" />
      <path d="M6.4 10 4 13.5v2.5l2.7-2M13.6 10l2.4 3.5v2.5l-2.7-2M8.5 15.5 10 18l1.5-2.5" />
    </>
  )}
  {name === "email" && (
    <>
      <rect x="2.5" y="4.5" width="15" height="11" rx="2" />
      <path d="m3 5.5 7 5.5 7-5.5" />
    </>
  )}
  {name === "theme" && <path d="M16 12.5A6.5 6.5 0 0 1 7.5 4a6.5 6.5 0 1 0 8.5 8.5Z" />}
  {name === "settings" && (
    <>
      <!-- Gear: eight teeth around a hub. -->
      <circle cx="10" cy="10" r="2.5" />
      <path d="M8.6 2.5h2.8l.4 2.1 1.5.9 2-.8 1.4 2.4-1.6 1.4v1.7l1.6 1.4-1.4 2.4-2-.8-1.5.9-.4 2.1H8.6l-.4-2.1-1.5-.9-2 .8-1.4-2.4 1.6-1.4V9.1L3.3 7.7l1.4-2.4 2 .8 1.5-.9Z" />
    </>
  )}
</svg>
