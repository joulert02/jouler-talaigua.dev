---
interface Props {
  name: "home" | "work" | "notes" | "roadmap" | "email" | "theme";
}
const { name } = Astro.props;
---

<svg
  viewBox={name === "roadmap" ? "0 0 24 24" : "0 0 20 20"}
  aria-hidden="true"
  width="20"
  height="20"
  fill="none"
  stroke="currentColor"
  stroke-width={name === "roadmap" ? "1.92" : "1.6"}
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {name === "home" && <path d="M3.5 9 10 3.5 16.5 9v7a1 1 0 0 1-1 1h-3.5v-4.5h-4V17H4.5a1 1 0 0 1-1-1Z" />}
  {name === "work" && (
    <>
      <rect x="2.5" y="6" width="15" height="11" rx="2" />
      <path d="M7 6V4.5A1.5 1.5 0 0 1 8.5 3h3A1.5 1.5 0 0 1 13 4.5V6M2.5 10.5h15" />
    </>
  )}
  {name === "notes" && (
    <>
      <path d="M5 2.5h7.5L16 6v11.5H5Z" />
      <path d="M8 9.5h5M8 12.5h5" stroke-linecap="round" />
    </>
  )}
  {name === "roadmap" && (
    <>
      <!-- Outline adapted from the v11 desk rocket. -->
      <path d="M12 2.5c3 2.5 4.5 6 4.5 10.5h-9C7.5 8.5 9 5 12 2.5Z" />
      <circle cx="12" cy="8.5" r="1.5" />
      <path d="M7.5 10 4.5 13v3l3.5-1.5M16.5 10l3 3v3L16 14.5M9 13v3h6v-3M10 18c.3 1.5 1 2.5 2 3.5 1-1 1.7-2 2-3.5" />
    </>
  )}
  {name === "email" && (
    <>
      <rect x="2.5" y="4.5" width="15" height="11" rx="2" />
      <path d="m3 5.5 7 5.5 7-5.5" />
    </>
  )}
  {name === "theme" && <path d="M16 12.5A6.5 6.5 0 0 1 7.5 4a6.5 6.5 0 1 0 8.5 8.5Z" />}
</svg>
