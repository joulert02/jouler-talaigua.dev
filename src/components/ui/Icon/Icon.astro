---
import { icons, type IconName } from "./icons";
interface Props {
  name: IconName;
}
const { name } = Astro.props;
const Svg = icons[name];
---

<Svg
  aria-hidden="true"
  width="20"
  height="20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
/>
