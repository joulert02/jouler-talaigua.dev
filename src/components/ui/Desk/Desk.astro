---
import { getLang, useTranslations } from "../../../i18n/ui";
interface Props {
  /** Names the desk: a `[data-desk-open="{id}"]` element opens it full screen on phones, at `#{id}`. Without it the
   *  desk stays desktop-only. */
  id?: string;
  /** Size of the world the visitor walks across, in px. Default: v11's 1960 × 1460. */
  world?: { width: number; height: number };
  /** Where the `center` element's top-left corner sits in the world, in px. Default: v11's (710, 350). */
  origin?: { x: number; y: number };
  /**
   * The desk opened full screen below 901px (v11 mobile): a smaller world, and where the `center` element sits in it,
   * by its horizontal middle (`x`) and its top (`y`), since its width follows the phone. Default: v11's 1280 × 1480,
   * (640, 600). DeskObjects take their own `compact` positions.
   */
  compact?: { world: { width: number; height: number }; center: { x: number; y: number } };
  /** What to do here, in the bar of the desk opened on a phone, next to the close button, e.g. "Drag to explore". */
  hint?: string;
}
const {
  id,
  world = { width: 1960, height: 1460 },
  origin = { x: 710, y: 350 },
  compact = { world: { width: 1280, height: 1480 }, center: { x: 640, y: 600 } },
  hint,
} = Astro.props;
const t = useTranslations(getLang(Astro));
const style = [
  `--desk-world-width: ${world.width}px`,
  `--desk-world-height: ${world.height}px`,
  `--desk-origin-x: ${origin.x}px`,
  `--desk-origin-y: ${origin.y}px`,
  `--desk-compact-width: ${compact.world.width}px`,
  `--desk-compact-height: ${compact.world.height}px`,
  `--desk-compact-x: ${compact.center.x}px`,
  `--desk-compact-y: ${compact.center.y}px`,
].join("; ");
---

<!--
  A desk (v11, docs/design/v11/canvas.js): a world larger than the screen that the visitor walks across by dragging,
  with the wheel or trackpad, or with the keyboard. It knows nothing of what it holds: the `center` slot is the element
  the resting view centers on (the Home's identity card), and the default slot takes DeskObjects, each placed in world
  coordinates. CSS alone lays out the resting view, so the first paint is final; the deferred camera script only adds an
  offset once the visitor moves.
  From 901px the desk is part of the page. Below, the world is hidden and the `center` element flows as a normal page,
  until a `[data-desk-open="{id}"]` element opens the desk full screen (v11 mobile): a modal layer at `#{id}` where one
  finger walks the desk, also from an object, a tap still flips or plays it, and a bar at the thumb says so and
  closes it. Back, Escape and the close button leave it; focus returns to the opener.
  At the bottom edge the desktop desk fires a bubbling `desk-edge` event, detail { armed, progress } (camera.ts,
  EdgeState): armed once the camera reaches the edge, progress filling from 0 to 1 while a background drag is held
  there or the wheel keeps scrolling down past it, back to 0 when the drag is released or the scroll pauses. What a full hand-off does is up to the page (the Home opens Work).
  The objects come in one by one: those in view when the page opens, or each time the phone's desk opens, then each
  of the others the first time the visitor walks up to it. The inline script hides them before the first
  paint (DeskObject owns the styles), so without scripts they are simply there; the camera script marks each one
  `data-revealed` as it comes into view. Their images wait too: an object is marked `data-near` a little before it
  can be seen, and only then do its lazy images load, so the page opens with what the first screen needs and fetches
  the rest as the visitor walks. On a phone the entrance waits for the opening transition to end, so it is seen.
  An object that carries a `view-transition-name` while the phone's desk opens is not part of that entrance: it is
  there from the first frame, so the page can make something of its own travel to it (the Home's entry prints).
-->
<desk-board class="desk" id={id} data-label={t("desk.label")} data-dialog-label={t("desk.dialog")} {style}>
  <script is:inline>
    document.currentScript.parentElement.dataset.reveal = "";
  </script>
  <div class="desk__viewport">
    <div class="desk__stage">
      <div class="desk__layer">
        <!-- The center element comes first, so reading and Tab order start with it, not the objects. -->
        <slot name="center" />
        <div class="desk__world">
          <slot />
        </div>
      </div>
    </div>
  </div>
  <div class="desk__bar">
    {hint && (
      <>
        <p class="desk__hint">
          <svg
            class="desk__hint-icon"
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 3v18M3 12h18M12 3l-3 3M12 3l3 3M12 21l-3-3M12 21l3-3M3 12l3-3M3 12l3 3M21 12l-3-3M21 12l-3 3"></path>
          </svg>
          {hint}
        </p>
        <span class="desk__separator" aria-hidden="true"></span>
      </>
    )}
    <button class="desk__button desk__close" type="button" aria-label={t("desk.close")}>
      <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
        <path
          d="m5.5 5.5 9 9m0-9-9 9"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
        ></path>
      </svg>
    </button>
  </div>
</desk-board>

<script>
  // Astro ships this as a module script: deferred, it never blocks the HTML or CSS from rendering.
  import { DeskCamera, type EdgeState, type WheelMode } from "./camera";

  const desktop = matchMedia("(min-width: 901px)");
  const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
  /** Time between two objects that come into view together, in ms: they arrive one by one, not as a block. */
  const REVEAL_STAGGER = 110;
  /** How long an object takes to come in, in ms: the ones met while walking arrive slower than the first screen's. */
  const REVEAL_DURATION = { opening: 900, walking: 1400 };
  /** How far outside the screen an object starts loading its images, so they are ready when it comes in. */
  const NEAR_MARGIN = "200px";
  // Experiment flag: `?wheel=page` lets the vertical wheel scroll the page instead of panning the desk.
  const wheelMode: WheelMode = new URLSearchParams(location.search).get("wheel") === "page" ? "page" : "desk";

  class DeskBoard extends HTMLElement {
    private camera: DeskCamera | undefined;
    private resize: ResizeObserver | undefined;
    private entrance: IntersectionObserver | undefined;
    private nearby: IntersectionObserver | undefined;
    /** While the phone's desk is still opening, no object comes in. */
    private held = false;
    private abort: AbortController | undefined;
    /** What opened the desk on a phone; focus goes back to it on close. */
    private opener: HTMLElement | null = null;
    /** Everything outside the desk made inert while it is open. */
    private inerted: HTMLElement[] = [];

    private get isOpen() {
      return this.hasAttribute("data-open");
    }

    private get hash() {
      return this.id ? `#${this.id}` : "";
    }

    connectedCallback() {
      this.abort = new AbortController();
      const { signal } = this.abort;
      desktop.addEventListener("change", () => this.onBreakpoint(), { signal });
      document.addEventListener("click", (event) => this.onOpenerClick(event), { signal });
      this.querySelector(".desk__close")?.addEventListener("click", () => this.leave(), { signal });
      this.addEventListener(
        "keydown",
        (event) => {
          if (event.key !== "Escape" || !this.isOpen) return;
          event.preventDefault();
          this.leave();
        },
        { signal },
      );
      // Opening the desk focuses it from a script, which Safari outlines even after a touch: the outline is for keys.
      const keys = (on: boolean) => () => this.toggleAttribute("data-keys", on);
      addEventListener("keydown", keys(true), { capture: true, signal });
      addEventListener("pointerdown", keys(false), { capture: true, signal });
      // The phone's back gesture closes the open desk; Forward opens it again.
      addEventListener("popstate", () => this.syncWithUrl(), { signal });
      this.mount();
      if (this.hash && location.hash === this.hash) this.open(null, false);
    }

    disconnectedCallback() {
      this.abort?.abort();
      this.unmount();
      this.inertOutside(false);
    }

    private onOpenerClick(event: MouseEvent) {
      if (!this.id || desktop.matches) return;
      const opener = (event.target as Element).closest<HTMLElement>("[data-desk-open]");
      if (opener?.dataset["deskOpen"] !== this.id) return;
      event.preventDefault();
      this.open(opener);
    }

    private syncWithUrl() {
      const here = this.hash !== "" && location.hash === this.hash;
      if (this.isOpen && !here) this.close();
      else if (!this.isOpen && here) this.open(null, false);
    }

    /** Opens the desk full screen (phones only); `push` adds the `#id` history entry that Back closes. */
    open(opener: HTMLElement | null, push = true) {
      if (this.isOpen || desktop.matches) return;
      this.opener = opener;
      this.held = true;
      const opening = this.transition("open", () => {
        this.setAttribute("data-open", "");
        this.setAttribute("role", "dialog");
        this.setAttribute("aria-modal", "true");
        this.setAttribute("aria-label", this.dataset["dialogLabel"] ?? "");
        this.inertOutside(true);
        // Every time the desk opens its objects come in again.
        for (const object of this.querySelectorAll<HTMLElement>(".desk__world > .desk-object")) {
          // One the page names for this transition travels here from somewhere else: it has already arrived.
          const travels = getComputedStyle(object).getPropertyValue("view-transition-name") !== "none";
          if (travels) object.dataset["revealed"] = "moved";
          else object.removeAttribute("data-revealed");
          object.toggleAttribute("data-near", travels || object.hasAttribute("data-near"));
        }
        this.mount();
      });
      void opening.updated.then(() => {
        this.querySelector<HTMLElement>(".desk__viewport")?.focus({ preventScroll: true });
      });
      // The objects come in once the desk is fully there, not under the transition's crossfade.
      void opening.finished.then(() => this.releaseEntrances());
      // The mark in the entry survives a reload and Back/Forward, so `leave` knows the entry is the desk's own.
      if (push) history.pushState({ ...history.state, desk: true }, "", this.hash);
    }

    /** Closes it in place; `leave` is the visitor's way out, through history when the desk added an entry. */
    close() {
      if (!this.isOpen) return;
      const opener = this.opener;
      void this.transition("close", () => this.reset()).updated.then(() =>
        opener?.focus({ preventScroll: true }),
      );
    }

    private leave() {
      if (location.hash !== this.hash) return this.close();
      // Our own entry: going back removes it and popstate closes the desk.
      if ((history.state as { desk?: boolean } | null)?.desk) return history.back();
      // Opened from a link to `#id`: there is no entry of ours to go back to.
      history.replaceState(history.state, "", location.pathname + location.search);
      this.close();
    }

    /** Back to the page, without animation: also used when the window grows past 900px. */
    private reset() {
      this.removeAttribute("data-open");
      this.removeAttribute("role");
      this.removeAttribute("aria-modal");
      this.removeAttribute("aria-label");
      this.inertOutside(false);
      this.mount();
    }

    private onBreakpoint() {
      if (desktop.matches && this.isOpen) {
        if (location.hash === this.hash)
          history.replaceState(history.state, "", location.pathname + location.search);
        this.reset();
      } else this.mount();
    }

    /** Runs a DOM change as a view transition where there is one: the center element morphs between page and desk. */
    private transition(kind: "open" | "close", update: () => void) {
      if (reducedMotion.matches || !document.startViewTransition) {
        update();
        return { updated: Promise.resolve(), finished: Promise.resolve() };
      }
      const root = document.documentElement;
      root.dataset["deskTransition"] = kind;
      const transition = document.startViewTransition(update);
      // A skipped transition rejects `finished`: what waits for it goes on all the same.
      const finished = transition.finished.catch(() => undefined);
      void finished.then(() => delete root.dataset["deskTransition"]);
      return { updated: transition.updateCallbackDone, finished };
    }

    /** Makes everything outside the desk inert while it is open, except layers marked `data-desk-above`. */
    private inertOutside(on: boolean) {
      for (const element of this.inerted) element.inert = false;
      this.inerted = [];
      if (!on) return;
      // Each ancestor up to <body>: its children that do not hold the desk become inert.
      for (
        let node = this.parentElement;
        node && node !== document.documentElement;
        node = node.parentElement
      ) {
        for (const sibling of node.children) {
          if (sibling.contains(this) || !(sibling instanceof HTMLElement) || sibling.inert) continue;
          if (sibling.matches("head, script, style, [data-desk-above]")) continue;
          sibling.inert = true;
          this.inerted.push(sibling);
        }
      }
    }

    private mount() {
      this.unmount();
      const phone = !desktop.matches;
      if (phone && !this.isOpen) return;
      const viewport = this.querySelector<HTMLElement>(".desk__viewport");
      const layer = this.querySelector<HTMLElement>(".desk__layer");
      const world = this.querySelector<HTMLElement>(".desk__world");
      if (!viewport || !layer || !world) return;
      // Only a working camera makes the desk a keyboard stop with instructions to move it.
      viewport.tabIndex = 0;
      viewport.setAttribute("role", "region");
      viewport.setAttribute("aria-label", this.dataset["label"] ?? "");
      this.camera = new DeskCamera(viewport, layer, world, {
        wheelMode,
        // On a phone a finger cannot aim at the background between objects, and objects do not move: every drag pans.
        panFromItems: phone,
        // The hand-off to Work belongs to the desktop desk.
        onEdge: (state) => !phone && this.edge(state),
      });
      this.resize = new ResizeObserver(() => this.camera?.refit());
      this.resize.observe(viewport);
      this.watchEntrances(viewport, world);
    }

    /** Brings each object in the first time it is in view, the ones nearest the middle of the screen first. */
    private watchEntrances(viewport: HTMLElement, world: HTMLElement) {
      // The observer's first report is the screen the page opens on; every later one is the visitor walking.
      let opening = true;
      this.entrance = new IntersectionObserver(
        (entries, observer) => {
          const duration = opening ? REVEAL_DURATION.opening : REVEAL_DURATION.walking;
          opening = false;
          const arriving = entries
            .filter((entry) => entry.isIntersecting)
            .map((entry) => {
              const box = entry.boundingClientRect;
              const view = entry.rootBounds ?? viewport.getBoundingClientRect();
              const distance = Math.hypot(
                box.left + box.width / 2 - (view.left + view.width / 2),
                box.top + box.height / 2 - (view.top + view.height / 2),
              );
              return { object: entry.target as HTMLElement, distance };
            })
            .sort((a, b) => a.distance - b.distance);
          arriving.forEach(({ object }, index) => {
            object.style.setProperty("--desk-object-enter-delay", `${index * REVEAL_STAGGER}ms`);
            object.style.setProperty("--desk-object-enter-duration", `${duration}ms`);
            object.dataset["revealed"] = "";
            observer.unobserve(object);
          });
        },
        { root: viewport, threshold: 0.1 },
      );
      this.nearby = new IntersectionObserver(
        (entries, observer) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            (entry.target as HTMLElement).dataset["near"] = "";
            observer.unobserve(entry.target);
          }
        },
        { root: viewport, rootMargin: NEAR_MARGIN },
      );
      for (const object of world.querySelectorAll(":scope > .desk-object")) {
        if (!object.hasAttribute("data-near")) this.nearby.observe(object);
        if (!this.held && !object.hasAttribute("data-revealed")) this.entrance.observe(object);
      }
    }

    /** Lets the objects of an open desk start coming in. */
    private releaseEntrances() {
      this.held = false;
      // Closed again before it finished opening: there is nothing to bring in.
      if (!this.camera) return;
      for (const object of this.querySelectorAll(".desk__world > .desk-object:not([data-revealed])")) {
        this.entrance?.observe(object);
      }
    }

    private edge(state: EdgeState) {
      this.dispatchEvent(new CustomEvent<EdgeState>("desk-edge", { detail: state, bubbles: true }));
    }

    private unmount() {
      // Without a camera there is no edge to stand on.
      if (this.camera) this.edge({ armed: false, progress: 0 });
      this.camera?.destroy();
      this.resize?.disconnect();
      this.entrance?.disconnect();
      this.nearby?.disconnect();
      this.camera = undefined;
      const viewport = this.querySelector<HTMLElement>(".desk__viewport");
      viewport?.removeAttribute("tabindex");
      viewport?.removeAttribute("role");
      viewport?.removeAttribute("aria-label");
    }
  }

  if (!customElements.get("desk-board")) customElements.define("desk-board", DeskBoard);
</script>

<style>
  /*
   * The desk at work: always from 901px, and below only while open full screen. Below 901px and closed, the media query
   * at the end turns it back into a plain wrapper where the center element flows as a normal page.
   */
  .desk {
    display: block;
    position: relative;
    width: 100%;
    height: 100%;
  }
  .desk__viewport {
    display: block;
    position: absolute;
    inset: 0;
    overflow: hidden;
    touch-action: none;
    cursor: grab;
    background-color: var(--color-bg-subtle);
    /* One dot grid that moves with the camera (v11); at rest the offsets are 0. */
    background-image: radial-gradient(
      circle at 1px 1px,
      color-mix(in srgb, var(--color-text-muted) 20%, transparent) 1px,
      transparent 0
    );
    background-size: 22px 22px;
    background-position: var(--desk-camera-x, 0px) var(--desk-camera-y, 0px);
    outline-offset: -4px;
  }
  .desk__viewport[data-panning] {
    cursor: grabbing;
    user-select: none;
  }
  /* The resting view: the center element centered in the screen above the Dock (80px), from the top when it is taller. */
  .desk__stage {
    display: grid;
    position: absolute;
    inset: 0;
    justify-items: center;
    align-items: safe center;
    padding: 24px 0 80px;
  }
  /* The camera translates this layer: the center element and the world move together. It shrinks to the
     center element, so the world can hang off that element's corner. */
  .desk__layer {
    display: block;
    position: relative;
    width: max-content;
    max-width: 100%;
    will-change: translate;
  }
  /* The world hangs off the center element: its top-left corner lands at the origin. */
  .desk__world {
    display: block;
    position: absolute;
    left: calc(-1 * var(--desk-origin-x));
    top: calc(-1 * var(--desk-origin-y));
    width: var(--desk-world-width);
    height: var(--desk-world-height);
    /* Objects are pressed, held and dragged: a long press must not select their text (on a phone it would also open
       the copy menu). The center element stays selectable. */
    -webkit-user-select: none; /* Safari needs the prefix; the build does not add it. */
    user-select: none;
    /* Nor does it open iOS's image menu, or a press flash gray. */
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
    /* Behind the card, inside the layer's stacking context (will-change creates it). */
    z-index: -1;
  }
  /* The phone bar exists only on the open desk. */
  .desk__bar {
    display: none;
  }

  @media (max-width: 900px) {
    /* Closed: no box, the center element flows with the page and the world is hidden. */
    .desk:not([data-open]),
    .desk:not([data-open]) .desk__viewport,
    .desk:not([data-open]) .desk__stage {
      display: contents;
    }
    /* Safari applies touch-action even to a box-less (display: contents) element: the page must keep scrolling. */
    .desk:not([data-open]) .desk__viewport {
      touch-action: auto;
      cursor: auto;
    }
    .desk:not([data-open]) .desk__layer {
      display: grid;
      justify-items: center;
      width: auto;
      max-width: none;
      will-change: auto;
    }
    .desk:not([data-open]) .desk__world {
      display: none;
    }

    /* Open: a full-screen layer over the page, above the Dock. */
    .desk[data-open] {
      position: fixed;
      inset: 0;
      z-index: 50;
      height: 100dvh;
      background: var(--color-bg-subtle);
      /* A finger only does what the desk offers: no text selection or magnifier (also on the center element and through
         an open note), no image or link menu, no gray flash on what is pressed. */
      -webkit-user-select: none;
      user-select: none;
      -webkit-touch-callout: none;
      -webkit-tap-highlight-color: transparent;
    }
    .desk[data-open]:not([data-keys]) .desk__viewport {
      outline: none;
    }
    :global(html:has(.desk[data-open])) {
      overflow: hidden;
    }
    /* The center element sits a little above the middle, clear of the bar at the bottom. */
    .desk[data-open] .desk__stage {
      padding: max(24px, env(safe-area-inset-top)) 24px calc(96px + env(safe-area-inset-bottom, 0px));
    }
    /* The compact world hangs off the center element's horizontal middle and its top, as its width follows the phone. */
    .desk[data-open] .desk__world {
      left: calc(50% - var(--desk-compact-x));
      top: calc(-1 * var(--desk-compact-y));
      width: var(--desk-compact-width);
      height: var(--desk-compact-height);
    }
    /* While the desk opens or closes, the bar is a layer of its own in the transition, above
       anything the page sends travelling across the desk (the Home's prints). */
    :global(:root[data-desk-transition]) .desk__bar {
      view-transition-name: desk-bar;
    }
    /* The bar sits where the thumb rests, as the Dock does on the page. */
    .desk[data-open] .desk__bar {
      display: flex;
      position: absolute;
      left: 50%;
      bottom: calc(var(--space-4) + env(safe-area-inset-bottom, 0px));
      translate: -50% 0;
      z-index: 2;
      align-items: center;
      gap: var(--space-1);
      padding: 6px;
      background: color-mix(in srgb, var(--color-surface) 92%, transparent);
      backdrop-filter: blur(10px);
      border: 1px solid var(--color-border);
      border-radius: 18px;
      box-shadow: var(--shadow-rest);
      /* Only its button takes the touch: a drag that starts on the words walks the desk underneath. */
      pointer-events: none;
    }
    .desk[data-open] .desk__close {
      pointer-events: auto;
    }
  }

  .desk__button {
    all: unset;
    box-sizing: border-box;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    color: var(--color-text);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      scale var(--duration-fast) var(--ease-out);
  }
  .desk__button:active {
    background: var(--color-surface-hover);
    scale: 0.94;
  }
  .desk__button:focus-visible {
    outline: 2px solid var(--color-text-accent);
    outline-offset: 2px;
  }
  .desk__close {
    background: var(--color-text);
    color: var(--color-surface);
  }
  .desk__close:active {
    background: var(--color-text-secondary);
  }
  /* The desktop hint pill's icon and words (board/BoardHint). */
  .desk__hint {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    padding-inline: var(--space-3) var(--space-2);
    font: 500 var(--font-size-small) / 1 var(--font-sans);
    color: var(--color-text);
    white-space: nowrap;
  }
  .desk__hint-icon {
    flex: none;
    animation: desk-hint-bounce 2.2s var(--ease-out) infinite;
  }
  @keyframes desk-hint-bounce {
    0%,
    60%,
    80%,
    100% {
      translate: 0 0;
    }
    70% {
      translate: 0 -5px;
    }
    88% {
      translate: 0 -2px;
    }
  }
  .desk__separator {
    width: 1px;
    height: 24px;
    margin-inline: var(--space-1);
    background: var(--color-border);
