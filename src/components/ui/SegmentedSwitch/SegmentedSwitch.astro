---
import type { SegmentedOption } from "./types";
interface Props {
  /** Radio group name; scripts read the checked value through it. */
  name: string;
  /** What the choice is about ("Device"), read by screen readers as the group's legend. */
  legend: string;
  /** The options, in order; the first one starts checked unless `value` names another. */
  options: readonly SegmentedOption[];
  /** The value checked at first. */
  value?: string;
}
const { name, legend, options, value = options[0]?.value } = Astro.props;
---

<!--
  A segmented switch (v11 `.seg-switch`): native radios in a fieldset, so arrow keys, forms and screen readers work
  without script. The legend is visually hidden; the options say the rest.
-->
<fieldset class="segmented-switch">
  <legend class="segmented-switch__legend">{legend}</legend>
  {options.map((option) => (
    <label class="segmented-switch__option">
      <input
        class="segmented-switch__input"
        type="radio"
        name={name}
        value={option.value}
        checked={option.value === value}
      />
      <span class="segmented-switch__label">{option.label}</span>
    </label>
  ))}
</fieldset>

<style>
  .segmented-switch {
    display: inline-flex;
    gap: 4px;
    margin: 0;
    padding: 4px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }
  .segmented-switch__legend {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .segmented-switch__option {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 var(--space-4);
    border-radius: 9px;
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
    cursor: pointer;
  }
  .segmented-switch__input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .segmented-switch__option:has(.segmented-switch__input:checked) {
    background: var(--color-surface-hover);
  }
  .segmented-switch__input:checked + .segmented-switch__label {
    color: var(--color-text);
    font-weight: 600;
  }
  .segmented-switch__option:has(.segmented-switch__input:focus-visible) {
    outline: 2px solid var(--color-text-accent);
    outline-offset: 2px;
  }
</style>
