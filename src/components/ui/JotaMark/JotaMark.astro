---
import { brand, type BrandData } from "../../../config/profile";
import { getLang, localePath, useTranslations } from "../../../i18n/ui";
interface Props {
  data?: BrandData;
}
const { data = brand } = Astro.props;
const lang = getLang(Astro);
const t = useTranslations(lang);
---

<a class="jota-mark" href={localePath(lang, data.href)} aria-label={`${data.name}, ${t("nav.home")}`}>
  <i class="jota-mark__glyph" aria-hidden="true">
    {data.mark}
  </i>
  <span class="jota-mark__label" translate="no">
    {data.label}
  </span>
</a>
<style>
  .jota-mark {
    --_tracking: 0.14em;
    --_mark-size: 22px;
    --_label-size: var(--font-size-small);
    display: inline-flex;
    max-width: 100%;
    overflow-wrap: anywhere;
    align-items: center;
    gap: var(--space-3);
    min-height: 44px;
    min-width: 44px;
    text-decoration: none;
    color: var(--color-text);
    font: 600 var(--_label-size)/1.5 var(--font-sans);
    letter-spacing: var(--_tracking);
  }
  .jota-mark__glyph {
    display: grid;
    place-items: center;
    width: var(--_mark-size);
    height: var(--_mark-size);
    border-radius: var(--radius-sm);
    background: var(--color-text);
    color: var(--color-bg);
    font-style: normal;
    letter-spacing: 0;
  }
  .jota-mark:hover {
    color: var(--color-text-accent);
  }
  .jota-mark:focus-visible {
    outline: 2px solid var(--color-text-accent);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }
</style>
