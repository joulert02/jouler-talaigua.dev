---
import { getLang, useTranslations } from "../../../i18n/ui";
const t = useTranslations(getLang(Astro));
---

<!--
  The Home desk (v11, docs/design/v11/canvas.js): on desktop (901px and up) a world larger than the screen
  that the visitor walks across by dragging, with the wheel or trackpad, or with the keyboard.
  CSS alone lays out the resting view (dot grid, card centered, world around it), so the first paint is final;
  the deferred camera script only adds an offset once the visitor moves. Below 901px the desk steps aside
  and the card flows as a normal page.
-->
<desk-board class="desk" data-label={t("desk.label")}>
  <div class="desk__viewport">
    <div class="desk__stage">
      <div class="desk__layer">
        <div class="desk__world">
          <slot />
        </div>
        <slot name="anchor" />
      </div>
    </div>
  </div>
</desk-board>

<script>
  // Astro ships this as a module script: deferred, it never blocks the HTML or CSS from rendering.
  import { DeskCamera, type WheelMode } from "./camera";

  const desktop = matchMedia("(min-width: 901px)");
  // Experiment flag: `?wheel=page` lets the vertical wheel scroll the page instead of panning the desk.
  const wheelMode: WheelMode = new URLSearchParams(location.search).get("wheel") === "page" ? "page" : "desk";

  class DeskBoard extends HTMLElement {
    private camera: DeskCamera | undefined;
    private resize: ResizeObserver | undefined;
    private readonly sync = () => this.mount();

    connectedCallback() {
      desktop.addEventListener("change", this.sync);
      this.mount();
    }

    disconnectedCallback() {
      desktop.removeEventListener("change", this.sync);
      this.unmount();
    }

    private mount() {
      this.unmount();
      if (!desktop.matches) return;
      const viewport = this.querySelector<HTMLElement>(".desk__viewport");
      const layer = this.querySelector<HTMLElement>(".desk__layer");
      const world = this.querySelector<HTMLElement>(".desk__world");
      if (!viewport || !layer || !world) return;
      // Only a working camera makes the desk a keyboard stop with instructions to move it.
      viewport.tabIndex = 0;
      viewport.setAttribute("role", "region");
      viewport.setAttribute("aria-label", this.dataset["label"] ?? "");
      this.camera = new DeskCamera(viewport, layer, world, wheelMode);
      this.resize = new ResizeObserver(() => this.camera?.refit());
      this.resize.observe(viewport);
    }

    private unmount() {
      this.camera?.destroy();
      this.resize?.disconnect();
      this.camera = undefined;
      const viewport = this.querySelector<HTMLElement>(".desk__viewport");
      viewport?.removeAttribute("tabindex");
      viewport?.removeAttribute("role");
      viewport?.removeAttribute("aria-label");
    }
  }

  if (!customElements.get("desk-board")) customElements.define("desk-board", DeskBoard);
</script>

<style>
  /* Mobile first: below 901px the desk is a plain wrapper and the card flows with the page. */
  .desk,
  .desk__viewport,
  .desk__stage {
    display: contents;
  }
  .desk__layer {
    display: grid;
    justify-items: center;
  }
  .desk__world {
    display: none;
  }

  @media (min-width: 901px) {
    .desk {
      display: block;
      position: relative;
      width: 100%;
      height: 100%;
    }
    .desk__viewport {
      display: block;
      position: absolute;
      inset: 0;
      overflow: hidden;
      touch-action: none;
      cursor: grab;
      background-color: var(--color-bg-subtle);
      /* One dot grid that moves with the camera (v11); at rest the offsets are 0. */
      background-image: radial-gradient(
        circle at 1px 1px,
        color-mix(in srgb, var(--color-text-muted) 20%, transparent) 1px,
        transparent 0
      );
      background-size: 22px 22px;
      background-position: var(--desk-camera-x, 0px) var(--desk-camera-y, 0px);
      outline-offset: -4px;
    }
    .desk__viewport[data-panning] {
      cursor: grabbing;
      user-select: none;
    }
    /* The resting view: the card centered in the screen above the Dock (80px), from the top when it is taller. */
    .desk__stage {
      display: grid;
      position: absolute;
      inset: 0;
      justify-items: center;
      align-items: safe center;
      padding: 24px 0 80px;
    }
    /* The camera translates this layer: the card and the world move together. */
    .desk__layer {
      display: block;
      position: relative;
      width: 540px;
      will-change: translate;
    }
    /* The world hangs off the card: v11 puts the 540px card at (710, 350) in a 1960 × 1460 desk. */
    .desk__world {
      display: block;
      position: absolute;
      left: -710px;
      top: -350px;
      width: 1960px;
      height: 1460px;
      /* Behind the card, inside the layer's stacking context (will-change creates it). */
      z-index: -1;
    }
  }
</style>
