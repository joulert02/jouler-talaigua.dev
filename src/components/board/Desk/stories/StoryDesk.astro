---
import Desk from "../Desk.astro";
import IdentityCard from "../../../profile/IdentityCard/IdentityCard.astro";
import { identity, type IdentityData } from "../../../../config/profile";
interface Props {
  /** Content of the identity card at the center of the desk. */
  data?: IdentityData;
}
const { data = identity } = Astro.props;
---

<!-- The desk fills its frame on the site; here the frame is a fixed-height box. -->
<div class="story-desk">
  <Desk>
    <IdentityCard slot="anchor" {data} />
  </Desk>
</div>

<style>
  .story-desk {
    height: 640px;
  }
</style>
