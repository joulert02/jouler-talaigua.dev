---
// The Home's board section, exactly as the page renders it: the identity card at the center of the desk, the
// personal objects around it and the hint pill that hands off to Work. Its story renders this file as is, so
// changing the section changes the story.
// The objects are in BoardObjects.astro, where each one rests in layout.ts (world pixels from the desk's top-left
// corner: `objects` on desktop, `compact` on the desk a phone opens full screen; the desktop is arranged with the
// layout editor, `npm run board:layout`) and what they say in src/config/desk.ts.
import Desk from "../../ui/Desk/Desk.astro";
import IdentityCard from "../../profile/IdentityCard/IdentityCard.astro";
import BoardHint from "../BoardHint/BoardHint.astro";
import DeskEntry from "../DeskEntry/DeskEntry.astro";
import BoardObjects from "./BoardObjects.astro";
import { layout } from "./layout";
import { getLang, localePath, useTranslations } from "../../../i18n/ui";
import moto from "../../../assets/photos/desk-moto.jpg";
import portrait from "../../../assets/photos/portrait-smile.jpg";
import teaching from "../../../assets/talks/teaching-01.jpg";
import unicornio from "../../../assets/covers/unicornio.jpg";

const lang = getLang(Astro);
const t = useTranslations(lang);
---

<div class="board">
  <Desk id="desk" world={layout.world} origin={layout.origin} hint={t("board.touchHint")}>
    <IdentityCard slot="center" />
    <!-- Phones only: the way into the desk, under the card (secondary to it). -->
    <DeskEntry
      slot="center"
      desk="desk"
      title={t("board.open")}
      meta={t("board.openMeta")}
      photos={[teaching, unicornio, moto, portrait]}
      revealPast=".identity-card__name"
    />
    <BoardObjects />
  </Desk>
  <!-- Holding a drag at the desk's bottom edge hands off to Work (HU-02, HU-03). -->
  <BoardHint href={localePath(lang, "/work/")} />
</div>

<script>
  // Tab order on the Home: the card, then the menu (the Dock), then the board's objects, then the footer. In the
  // document the desk wraps the card and the Dock comes after the board, so Tab is routed by groups (lib/tab-order).
  // From an object, Escape goes back to the menu. The desk opened full screen on a phone keeps its own order.
  import { nextStop } from "@/lib/tab-order.js";
  import { loadDraft, placedObjects, readAll, writeAll } from "./draft";

  const TABBABLE = "a[href], button:not([disabled]), input:not([disabled]), select, textarea, [tabindex]";
  /** The skip link and the language pill (0), the card (1), the Dock (2), the board (3), the footer (4). */
  const rank = (element: Element) =>
    element.closest(".identity-card")
      ? 1
      : element.closest(".dock")
        ? 2
        : element.closest(".board")
          ? 3
          : element.closest("footer")
            ? 4
            : 0;
  const stops = () =>
    [...document.querySelectorAll<HTMLElement>(TABBABLE)].filter(
      (element) => element.tabIndex >= 0 && !element.closest("[inert]") && element.checkVisibility(),
    );

  addEventListener("keydown", (event) => {
    const current = document.activeElement;
    if (!(current instanceof HTMLElement) || document.querySelector(".desk[data-open]")) return;
    if (event.key === "Escape" && rank(current) === 3) {
      // The menu's current page (Home), or its first stop.
      const menu =
        document.querySelector<HTMLElement>('.dock [aria-current="page"]') ??
        stops().find((stop) => rank(stop) === 2);
      menu?.focus();
      return;
    }
    if (event.key !== "Tab" || event.altKey || event.ctrlKey || event.metaKey) return;
    const next = nextStop(
      stops(),
      rank,
      current,
      event.shiftKey,
      (stop) =>
        current.contains(stop) ||
        !!(current.compareDocumentPosition(stop) & Node.DOCUMENT_POSITION_FOLLOWING),
    );
    if (!next) return;
    event.preventDefault();
    next.focus();
  });
  // While developing, the layout editor's unsaved positions are shown here too, so an arrangement can be walked
  // on the real desk before it is copied into layout.ts. The built site only knows layout.ts.
  if (import.meta.env.DEV) {
    const items = placedObjects(document.querySelector(".board") ?? document);
    const draft = loadDraft(readAll(items));
    if (draft) writeAll(items, draft);
  }
</script>

<style>
  /* Below 901px the board adds no box: the card flows with the page. */
  .board {
    display: contents;
  }
  /* The desk's way in (DeskEntry) tucks its prints under the card: the card stays on top. */
  @media (max-width: 900px) {
    .board :global(.identity-card) {
      position: relative;
      z-index: 1;
    }
  }
  /* From 901px the desk fills the first screen. */
  @media (min-width: 901px) {
    .board {
      display: block;
      position: relative;
      height: 100svh;
    }
  }
</style>
