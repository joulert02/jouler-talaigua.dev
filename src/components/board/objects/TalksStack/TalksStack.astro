---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
interface Photo {
  image: ImageMetadata;
  /** Line under the photo, e.g. the talk and its year. */
  caption: string;
}
interface Props {
  /** Accessible name of the button, e.g. "Flip through photos of my talks". */
  label: string;
  /** The prints, from the top of the stack down. */
  photos: readonly Photo[];
}
const { label, photos } = Astro.props;
// The last child is the top print, so the first photo is printed last.
const prints = photos.toReversed();
---

<!--
  A stack of photo prints. Pressing it sends the top print to the bottom and shows the next one, in a loop.
  The photos are decorative inside the button (alt=""): its name says what the stack is, and the caption now on
  top is said in the status line after it, which nobody sees.
-->
<button type="button" class="talks-stack" aria-label={label}>
  {prints.map((photo) => (
    <span class="talks-stack__print">
      <Image
        class="talks-stack__photo"
        src={photo.image}
        alt=""
        width={152}
        height={150}
        densities={[1, 2]}
        fit="cover"
        draggable="false"
      />
      <span class="talks-stack__caption">{photo.caption}</span>
    </span>
  ))}
</button>
<span class="talks-stack__status" role="status"></span>

<script>
  import { peel } from "../stack";

  // One listener for every stack on the page. On the desk, <desk-object> swallows the click after a drag.
  const scope = window as typeof window & { talksStackReady?: boolean };
  if (!scope.talksStackReady) {
    scope.talksStackReady = true;
    document.addEventListener("click", (event) => {
      const stack = (event.target as Element).closest(".talks-stack");
      const top = stack && peel(stack, "talks-stack__print--leaving");
      const status = stack?.nextElementSibling;
      if (top && status?.matches(".talks-stack__status")) {
        status.textContent = top.querySelector(".talks-stack__caption")?.textContent ?? "";
      }
    });
  }
</script>

<style>
  /* Said, not shown. */
  .talks-stack__status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .talks-stack {
    all: unset;
    box-sizing: border-box;
    position: relative;
    display: block;
    width: 170px;
    height: 200px;
    cursor: pointer;
  }
  .talks-stack:focus-visible {
    outline: 2px solid var(--color-text-accent);
    outline-offset: 6px;
    border-radius: var(--radius-sm);
  }
  /* A print keeps its white border and gray caption in both themes, like PhotoPrint. */
  .talks-stack__print {
    position: absolute;
    inset: 0;
    box-sizing: border-box;
    display: block;
    padding: 9px 9px 0;
    background: #fff;
    border-radius: 3px;
    box-shadow: var(--shadow-rest);
    transition:
      transform var(--duration-medium) var(--ease-out),
      opacity var(--duration-medium) var(--ease-out);
  }
  .talks-stack__print:nth-last-child(2) {
    transform: translate(5px, 4px) rotate(3deg);
  }
  .talks-stack__print:nth-last-child(n + 3) {
    transform: translate(-5px, 7px) rotate(-4deg);
  }
  .talks-stack__print--leaving {
    transform: translate(70%, -30%) rotate(18deg);
    opacity: 0;
  }
  .talks-stack__photo {
    display: block;
    width: 100%;
    height: 150px;
    object-fit: cover;
    filter: saturate(0.88);
    background: #e1e4e8;
  }
  .talks-stack__caption {
    display: block;
    padding: 9px 2px;
    font: 500 var(--font-size-small) / 1.2 var(--font-mono);
    color: #5b616a;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (prefers-reduced-motion: reduce) {
    .talks-stack__print {
      transition: none;
    }
  }
</style>
