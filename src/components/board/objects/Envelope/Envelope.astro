---
interface Props {
  /** Handwritten line on the envelope, e.g. "for you". */
  to: string;
  /** Accessible name of the link, e.g. "Open the letter: more about me". */
  label: string;
  /** The page the letter opens, e.g. "/more-about-me/". */
  href: string;
}
const { to, label, href } = Astro.props;
---

<!--
  The letter object: a sealed envelope, and a link. Pressing it turns the flap back from its top edge, a letter glides
  up and peeks out, and then its page opens. A press that opens another tab, and reduced motion, skip the wait.
  Where there is a pointer that hovers, hovering gives the same peek; a finger that drags across it does not. Coming back to the page finds it sealed again.
  Layers, back to front: envelope back < letter < front pocket < flap (closed). An open flap drops behind the letter.
-->
<a class="envelope" href={href} aria-label={label}>
  <span class="envelope__letter" aria-hidden="true"></span>
  <span class="envelope__pocket" aria-hidden="true"></span>
  <span class="envelope__flap" aria-hidden="true"></span>
  <span class="envelope__seal" aria-hidden="true"></span>
  <span class="envelope__to">{to}</span>
</a>

<script>
  // One listener for every envelope on the page. On the desk, <desk-object> swallows the click after a drag.
  const scope = window as typeof window & { envelopeReady?: boolean };
  if (!scope.envelopeReady) {
    scope.envelopeReady = true;
    document.addEventListener("click", (event) => {
      const envelope = (event.target as Element).closest<HTMLAnchorElement>("a.envelope");
      if (!envelope || event.defaultPrevented || event.button !== 0) return;
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      // Already on its way.
      if (envelope.hasAttribute("data-open")) return;
      envelope.toggleAttribute("data-open", true);
      // The letter comes out first. Nothing to wait for with reduced motion, or if hovering had opened it already.
      const opening = envelope.getAnimations({ subtree: true }).map((animation) => animation.finished);
      void Promise.allSettled(opening).then(() => location.assign(envelope.href));
    });
    // Back from the page, the browser may restore this one as it was left.
    addEventListener("pageshow", (event) => {
      if (!event.persisted) return;
      for (const envelope of document.querySelectorAll(".envelope")) envelope.removeAttribute("data-open");
    });
  }
</script>

<style>
  .envelope {
    --envelope-paper: color-mix(in srgb, var(--color-surface) 90%, white);
    --envelope-inside: color-mix(in srgb, var(--color-bg-subtle) 60%, var(--color-border));
    --envelope-flap: color-mix(in srgb, var(--color-bg-subtle) 70%, var(--color-surface));
    --envelope-ink: color-mix(in srgb, var(--color-text-muted) 60%, transparent);
    color: inherit;
    text-decoration: none;
    cursor: pointer;
    box-sizing: border-box;
    position: relative;
    display: block;
    width: 200px;
    height: 134px;
    background: var(--envelope-inside);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-rest);
    /* The pace of the opening: the flap's turn, the letter's glide and its easing (a soft start and a long landing). */
    --_turn: 420ms;
    --_slide: 560ms;
    --_glide: cubic-bezier(0.3, 0, 0.15, 1);
  }
  .envelope > * {
    position: absolute;
  }
  .envelope:focus-visible {
    outline: 2px solid var(--color-text-accent);
    outline-offset: 4px;
  }

  /* The letter waits inside, hidden by the pocket and the closed flap. */
  .envelope__letter {
    z-index: 1;
    inset: 8px 12px 6px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    background:
      linear-gradient(var(--envelope-ink), var(--envelope-ink)) 14px 16px / 46% 2px no-repeat,
      repeating-linear-gradient(to bottom, transparent 0 13px, var(--color-border) 13px 14px) 0 26px / 100%
        calc(100% - 26px) no-repeat,
      var(--envelope-paper);
    /* Closing: the letter goes back in first, then the flap comes down. */
    transition: transform var(--_slide) var(--_glide);
  }

  /* The front pocket: the whole face but a V cut from the top, where the flap closes. */
  .envelope__pocket,
  .envelope__flap {
    inset: -1px -1px auto;
    filter: drop-shadow(0 0 0.5px color-mix(in srgb, var(--color-text) 35%, transparent));
  }
  .envelope__pocket {
    z-index: 2;
    bottom: -1px;
  }
  .envelope__pocket::before,
  .envelope__flap::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius-sm);
  }
  .envelope__pocket::before {
    background: var(--color-surface);
    clip-path: polygon(0 0, 50% 52%, 100% 0, 100% 100%, 0 100%);
  }

  /* The flap hinges on its top edge. It turns at an even pace, so it is edge-on exactly halfway: that is when its
     z-index flips and it lands behind the letter, with nothing visible to jump. */
  .envelope__flap {
    z-index: 3;
    height: 76px;
    transform-origin: top;
    transform: perspective(700px) rotateX(0deg);
    transition:
      transform var(--_turn) linear calc(var(--_slide) * 0.7),
      z-index 0s linear calc(var(--_slide) * 0.7 + var(--_turn) / 2);
  }
  .envelope__flap::before {
    background: var(--envelope-flap);
    clip-path: polygon(0 0, 100% 0, 50% 100%);
  }

  .envelope__seal {
    z-index: 4;
    left: 50%;
    top: 58px;
    width: 22px;
    height: 22px;
    margin-left: -11px;
    border-radius: var(--radius-round);
    background: var(--color-accent);
    /* The seal comes back last, once the flap is down. */
    transition:
      opacity var(--duration-fast) var(--ease-out) calc(var(--_slide) * 0.7 + var(--_turn)),
      scale var(--duration-medium) var(--ease-spring) calc(var(--_slide) * 0.7 + var(--_turn));
  }
  .envelope__to {
    z-index: 4;
    left: 18px;
    bottom: 12px;
    font: 600 1.5rem / 1 var(--font-hand);
    color: var(--color-text-secondary);
  }

  /* Open once it is pressed, and for as long as a pointer that hovers rests on it. */
  .envelope:hover .envelope__flap,
  .envelope[data-open] .envelope__flap {
    z-index: 0;
    transform: perspective(700px) rotateX(180deg);
    transition:
      transform var(--_turn) linear calc(var(--duration-fast) * 0.6),
      z-index 0s linear calc(var(--duration-fast) * 0.6 + var(--_turn) / 2);
  }
  /* Opening: the seal pops off, the flap turns over, and the letter glides up as the flap passes upright. */
  .envelope:hover .envelope__seal,
  .envelope[data-open] .envelope__seal {
    opacity: 0;
    scale: 0.4;
    transition-delay: 0s;
  }
  .envelope:hover .envelope__letter,
  .envelope[data-open] .envelope__letter {
    transform: translateY(-64px);
    transition-delay: calc(var(--duration-fast) * 0.6 + var(--_turn) * 0.55);
  }

  /* Reduced motion: nothing moves, and pressing opens it at once. */
  @media (prefers-reduced-motion: reduce) {
    .envelope .envelope__letter,
    .envelope .envelope__flap,
    .envelope .envelope__seal {
      transition: none;
    }
  }
  /* Only pressing opens it with reduced motion, and on a touch screen, where a drag across it counts as hovering. */
  @media (prefers-reduced-motion: reduce), (hover: none), (pointer: coarse) {
    .envelope:not([data-open]):hover .envelope__flap {
      z-index: 3;
      transform: none;
    }
    .envelope:not([data-open]):hover .envelope__seal {
      opacity: 1;
      scale: 1;
    }
    .envelope:not([data-open]):hover .envelope__letter {
      transform: none;
    }
  }
</style>
