---
interface Props {
  /** Accessible name of the drawing area, e.g. "Sketch pad: draw with the pointer". */
  label: string;
  /** Handwritten line under the page, e.g. "Learning to draw. Your turn." */
  caption: string;
  /** Text of the button that wipes the page, e.g. "Clear". */
  clear: string;
}
const { label, caption, clear } = Astro.props;
---

<!--
  A spiral sketch pad the visitor can draw on with the pointer. The drawing lives only in the page: nothing is
  saved or sent. On the desk, dragging on the paper draws; the pad moves when dragged by its edge.
-->
<sketch-book class="sketchbook">
  <canvas class="sketchbook__page" width="440" height="280" role="img" aria-label={label}></canvas>
  <span class="sketchbook__foot">
    <span class="sketchbook__caption">{caption}</span>
    <button type="button" class="sketchbook__clear">
      {clear}
    </button>
  </span>
</sketch-book>

<script>
  class SketchbookElement extends HTMLElement {
    connectedCallback() {
      const canvas = this.querySelector<HTMLCanvasElement>(".sketchbook__page");
      const ink = canvas?.getContext("2d");
      if (!canvas || !ink) return;
      ink.lineWidth = 4;
      ink.lineCap = ink.lineJoin = "round";
      ink.strokeStyle = getComputedStyle(this).getPropertyValue("--_ink").trim() || "#3d4148";
      /** The pointer in canvas pixels: the canvas is drawn at half its resolution. */
      const at = (event: PointerEvent): [number, number] => {
        const box = canvas.getBoundingClientRect();
        return [
          ((event.clientX - box.left) / box.width) * canvas.width,
          ((event.clientY - box.top) / box.height) * canvas.height,
        ];
      };
      canvas.addEventListener("pointerdown", (event) => {
        // The stroke belongs to the paper: the desk must not pick the pad up.
        event.stopPropagation();
        canvas.setPointerCapture(event.pointerId);
        ink.beginPath();
        ink.moveTo(...at(event));
      });
      canvas.addEventListener("pointermove", (event) => {
        if (!canvas.hasPointerCapture(event.pointerId)) return;
        ink.lineTo(...at(event));
        ink.stroke();
      });
      this.querySelector(".sketchbook__clear")?.addEventListener("click", () =>
        ink.clearRect(0, 0, canvas.width, canvas.height),
      );
    }
  }

  if (!customElements.get("sketch-book")) customElements.define("sketch-book", SketchbookElement);
</script>

<style>
  .sketchbook {
    position: relative;
    box-sizing: border-box;
    display: block;
    width: 244px;
    padding: 22px 12px 10px;
    border: 1px solid var(--_edge);
    border-radius: 14px;
    background: var(--_cover);
    box-shadow: var(--shadow-rest);
    /* Local illustration colors, the same in both themes: cream paper, graphite ink and a metal spiral. */
    --_cover: #fbf8f0;
    --_paper: #fffdf8;
    --_edge: #e4dcc8;
    --_ink: #3d4148;
    --_muted: #5b616a;
  }
  /* The spiral binding along the top edge. */
  .sketchbook::before {
    content: "";
    position: absolute;
    left: 14px;
    right: 14px;
    top: 6px;
    height: 10px;
    background: repeating-linear-gradient(90deg, #8a8f98 0 3px, transparent 3px 14px);
    border-radius: 3px;
  }
  .sketchbook__page {
    display: block;
    width: 220px;
    height: 140px;
    background: var(--_paper);
    border: 1px solid var(--_edge);
    border-radius: 4px;
    cursor: crosshair;
    touch-action: none;
  }
  .sketchbook__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2);
    margin-top: 6px;
  }
  .sketchbook__caption {
    font: 600 1.1875rem / 1.1 var(--font-hand);
    color: var(--_ink);
  }
  .sketchbook__clear {
    padding: 2px 10px;
    border: 1px solid #d5ccb5;
    border-radius: var(--radius-pill);
    background: none;
    font: 500 var(--font-size-small) / 1.4 var(--font-mono);
    color: var(--_muted);
    cursor: pointer;
  }
  .sketchbook__clear:focus-visible {
    outline: 2px solid var(--color-text-accent);
    outline-offset: 2px;
  }
</style>
