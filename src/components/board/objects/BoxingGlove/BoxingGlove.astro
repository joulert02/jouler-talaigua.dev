---
import ObjectReveal from "../ObjectReveal/ObjectReveal.astro";
interface Props {
  /** Accessible name of the button, e.g. "Punch". */
  label: string;
  /** Title of the note for one hit and for several, with {count} replaced, e.g. "{count} hit" / "{count} hits". */
  hits: { one: string; other: string };
  /** The note under the count. */
  text: string;
}
const { label, hits, text } = Astro.props;
---

<!-- A boxing glove that throws a punch on every press and keeps count in its note. -->
<boxing-glove class="boxing-glove" data-one={hits.one} data-other={hits.other} data-text={text}>
  <button type="button" class="boxing-glove__face" aria-label={label}>
    <svg class="boxing-glove__art" viewBox="0 0 112 124" aria-hidden="true">
      <rect
        x="38"
        y="88"
        width="46"
        height="32"
        rx="6"
        fill="var(--_cuff)"
        stroke="var(--_line)"
        stroke-width="2.5"
      ></rect>
      <path d="M38 100h46" stroke="var(--_deep)" stroke-width="5"></path>
      <path
        d="M32 18C62 2 100 18 100 56c0 26-16 38-38 38H42C24 94 14 80 14 60c0-20 4-34 18-42Z"
        fill="var(--_red)"
        stroke="var(--_line)"
        stroke-width="2.5"
      ></path>
      <ellipse
        cx="27"
        cy="60"
        rx="15"
        ry="22"
        fill="var(--_deep)"
        stroke="var(--_line)"
        stroke-width="2.5"
      ></ellipse>
      <path
        d="M52 24c12-5 28-2 36 10"
        stroke="#fff"
        stroke-width="3"
        stroke-linecap="round"
        opacity=".45"
        fill="none"
      ></path>
    </svg>
  </button>
  <ObjectReveal text={text} />
</boxing-glove>

<script>
  import { setReveal } from "../reveal";

  class BoxingGloveElement extends HTMLElement {
    connectedCallback() {
      const face = this.querySelector<HTMLButtonElement>(".boxing-glove__face");
      let count = 0;
      face?.addEventListener("click", () => {
        count += 1;
        const title = (count === 1 ? this.dataset["one"] : this.dataset["other"]) ?? "";
        setReveal(this, true, {
          title: title.replace("{count}", String(count)),
          text: this.dataset["text"] ?? "",
        });
        // Restart the punch on every press, also mid-swing.
        face.classList.remove("boxing-glove__face--punch");
        void face.offsetWidth;
        face.classList.add("boxing-glove__face--punch");
      });
    }
  }

  if (!customElements.get("boxing-glove")) customElements.define("boxing-glove", BoxingGloveElement);
</script>

<style>
  .boxing-glove {
    position: relative;
    display: inline-block;
    /* Local illustration colors, the same in both themes. */
    --_red: #d9453a;
    --_deep: #c23b2e;
    --_cuff: #f4f1ea;
    --_line: #141517;
  }
  .boxing-glove__face {
    all: unset;
    box-sizing: border-box;
    display: block;
    width: 112px;
    height: 124px;
    cursor: pointer;
  }
  .boxing-glove__face:focus-visible {
    outline: 2px solid var(--color-text-accent);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }
  .boxing-glove__art {
    display: block;
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 8px 8px rgb(20 21 23 / 0.22));
  }
  .boxing-glove__face--punch {
    animation: boxing-glove-punch 0.22s var(--ease-out);
  }
  @keyframes boxing-glove-punch {
    40% {
      transform: translate(-26px, -14px) rotate(-14deg) scale(1.12);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .boxing-glove__face--punch {
      animation: none;
    }
  }
</style>
