---
interface Props {
  /** Accessible name of the button, e.g. "Bag of coffee beans: pour them into the grinder". */
  label: string;
}
const { label } = Astro.props;
---

<!--
  A kraft bag of coffee beans. Dropping it on the grinder (on the desk), or pressing it, tips the bag and
  announces the beans on the window (coffee.ts): any CoffeeGrinder on the page takes them. After a drop the bag
  goes back to where it was picked up.
-->
<coffee-beans class="coffee-beans">
  <button type="button" class="coffee-beans__face" aria-label={label}>
    <svg class="coffee-beans__art" width="74" height="100" viewBox="0 0 74 100" aria-hidden="true">
      <path d="M8 16h58l4 78q-33 8-66 0Z" fill="var(--_kraft)" stroke="var(--_edge)" stroke-width="2"></path>
      <path
        d="M8 16l6-12h46l6 12"
        fill="var(--_fold)"
        stroke="var(--_edge)"
        stroke-width="2"
        stroke-linejoin="round"
      ></path>
      <rect x="16" y="38" width="42" height="34" rx="4" fill="#fbf8f0"></rect>
      <ellipse cx="37" cy="52" rx="8" ry="11" fill="var(--_bean)"></ellipse>
      <path d="M37 42q-5 10 0 20" stroke="var(--_kraft)" stroke-width="1.6" fill="none"></path>
      <path d="M22 66h30" stroke="#8a826c" stroke-width="2"></path>
    </svg>
    <span class="coffee-beans__spill" aria-hidden="true">
      <span class="coffee-beans__bean"></span>
      <span class="coffee-beans__bean"></span>
      <span class="coffee-beans__bean"></span>
    </span>
  </button>
</coffee-beans>

<script>
  import { announceCoffee } from "../coffee";

  const wait = (ms: number) => new Promise((done) => setTimeout(done, ms));
  /** How long the bag stays tipped (CSS), in milliseconds. */
  const TIP = 700;

  class CoffeeBeansElement extends HTMLElement {
    private abort: AbortController | undefined;

    connectedCallback() {
      const face = this.querySelector<HTMLButtonElement>(".coffee-beans__face");
      if (!face) return;
      this.abort = new AbortController();
      const signal = this.abort.signal;
      const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const pour = async () => {
        if (face.hasAttribute("data-tipped")) return;
        face.setAttribute("data-tipped", "");
        await wait(still ? 0 : TIP * 0.6);
        announceCoffee("beans");
        await wait(still ? 0 : TIP * 0.4);
        face.removeAttribute("data-tipped");
      };
      face.addEventListener("click", () => void pour(), { signal });

      // On the desk the bag is carried by its <desk-object>. Let go over a grinder, it pours and goes home.
      this.addEventListener(
        "pointerdown",
        (down) => {
          const holder = this.closest<HTMLElement>(".desk-object");
          const home = holder && [
            holder.style.getPropertyValue("--desk-object-x"),
            holder.style.getPropertyValue("--desk-object-y"),
          ];
          window.addEventListener(
            "pointerup",
            (up) => {
              if (Math.hypot(up.clientX - down.clientX, up.clientY - down.clientY) < 6) return;
              const bag = this.getBoundingClientRect();
              const over = [...document.querySelectorAll(".coffee-grinder")].some((grinder) => {
                const box = grinder.getBoundingClientRect();
                return (
                  bag.left < box.right && bag.right > box.left && bag.top < box.bottom && bag.bottom > box.top
                );
              });
              if (!over) return;
              void pour().then(() => {
                if (!holder || !home) return;
                holder.style.setProperty("--desk-object-x", home[0] ?? "");
                holder.style.setProperty("--desk-object-y", home[1] ?? "");
              });
            },
            { once: true, signal },
          );
        },
        { signal },
      );
    }

    disconnectedCallback() {
      this.abort?.abort();
    }
  }

  if (!customElements.get("coffee-beans")) customElements.define("coffee-beans", CoffeeBeansElement);
</script>

<style>
  .coffee-beans {
    display: inline-block;
    /* Local illustration colors, the same in both themes: kraft paper and roasted beans. */
    --_kraft: #c9a46a;
    --_fold: #b08c55;
    --_edge: #8a6238;
    --_bean: #5a3620;
  }
  .coffee-beans__face {
    all: unset;
    box-sizing: border-box;
    position: relative;
    display: block;
    cursor: pointer;
  }
  .coffee-beans__face:focus-visible {
    outline: 2px solid var(--color-text-accent);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }
  .coffee-beans__art {
    display: block;
    overflow: visible;
    filter: drop-shadow(0 8px 8px rgb(20 21 23 / 0.2));
    transition: transform 0.4s var(--ease-out);
  }
  [data-tipped] > .coffee-beans__art {
    transform: rotate(105deg) translate(10px, -10px);
  }
  /* Three beans fall from the mouth of the tipped bag. */
  .coffee-beans__spill {
    position: absolute;
    left: 78px;
    top: 34px;
  }
  .coffee-beans__bean {
    position: absolute;
    width: 9px;
    height: 7px;
    border-radius: var(--radius-round);
    background: var(--_bean);
    opacity: 0;
  }
  [data-tipped] .coffee-beans__bean {
    animation: coffee-beans-fall 0.45s ease-in 0.25s;
  }
  [data-tipped] .coffee-beans__bean:nth-child(2) {
    left: 8px;
    animation-delay: 0.33s;
  }
  [data-tipped] .coffee-beans__bean:nth-child(3) {
    left: -5px;
    animation-delay: 0.41s;
  }
  @keyframes coffee-beans-fall {
    0% {
      opacity: 1;
      transform: none;
    }
    100% {
      opacity: 0;
      transform: translateY(46px) rotate(140deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .coffee-beans__art {
      transition: none;
    }
    [data-tipped] .coffee-beans__bean {
      animation: none;
    }
  }
</style>
