---
interface Note {
  /** What the note says, handwritten, e.g. "Learning to draw". */
  text: string;
  /** Small print in its corner, e.g. "NOW · 1/4". */
  tag: string;
}
interface Props {
  /** Accessible name of the button, e.g. "Peel the top note to see what I am learning now". */
  label: string;
  /** The notes, from the top of the pad down. */
  notes: readonly Note[];
}
const { label, notes } = Astro.props;
// The last child is the top sheet, so the first note is printed last.
const sheets = notes.toReversed();
---

<!--
  A pad of sticky notes. Pressing it peels the top note away and shows the next one; the peeled note goes to
  the bottom, so the pad loops. The button's name says what the pad is; the note now on top is said in the
  status line after it, which nobody sees.
-->
<button type="button" class="now-notes" aria-label={label}>
  {sheets.map((note) => (
    <span class="now-notes__note">
      <span class="now-notes__text">{note.text}</span>
      <span class="now-notes__tag">{note.tag}</span>
    </span>
  ))}
</button>
<span class="now-notes__status" role="status"></span>

<script>
  import { peel } from "../stack";

  // One listener for every pad on the page. On the desk, <desk-object> swallows the click after a drag.
  const scope = window as typeof window & { nowNotesReady?: boolean };
  if (!scope.nowNotesReady) {
    scope.nowNotesReady = true;
    document.addEventListener("click", (event) => {
      const pad = (event.target as Element).closest(".now-notes");
      const top = pad && peel(pad, "now-notes__note--leaving");
      const status = pad?.nextElementSibling;
      if (top && status?.matches(".now-notes__status")) {
        status.textContent = top.querySelector(".now-notes__text")?.textContent ?? "";
      }
    });
  }
</script>

<style>
  /* Said, not shown. */
  .now-notes__status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .now-notes {
    all: unset;
    box-sizing: border-box;
    position: relative;
    display: block;
    width: 150px;
    height: 150px;
    cursor: pointer;
    /* Local illustration colors, the same in both themes: three paper tints and dark ink. */
    --_yellow: #ffe680;
    --_pink: #ffc9de;
    --_green: #c9f0d8;
    --_ink: #2a2410;
  }
  .now-notes:focus-visible {
    outline: 2px solid var(--color-text-accent);
    outline-offset: 6px;
    border-radius: var(--radius-sm);
  }
  .now-notes__note {
    position: absolute;
    inset: 0;
    box-sizing: border-box;
    display: grid;
    align-content: space-between;
    padding: 12px 14px;
    background: var(--_yellow);
    color: var(--_ink);
    box-shadow: 0 6px 10px -6px rgb(20 21 23 / 0.35);
    transition:
      transform var(--duration-medium) var(--ease-out),
      opacity var(--duration-medium) var(--ease-out);
  }
  .now-notes__note:nth-child(2n) {
    background: var(--_pink);
  }
  .now-notes__note:nth-child(3n) {
    background: var(--_green);
  }
  /* The sheets under the top one fan out a little. */
  .now-notes__note:nth-last-child(2) {
    transform: translate(5px, 4px) rotate(3deg);
  }
  .now-notes__note:nth-last-child(n + 3) {
    transform: translate(-5px, 7px) rotate(-4deg);
  }
  .now-notes__note--leaving {
    transform: translate(70%, -30%) rotate(18deg);
    opacity: 0;
  }
  .now-notes__text {
    font: 600 1.4375rem / 1.1 var(--font-hand);
  }
  .now-notes__tag {
    font: 500 var(--font-size-small) / 1 var(--font-mono);
    opacity: 0.7;
  }

  @media (prefers-reduced-motion: reduce) {
    .now-notes__note {
      transition: none;
    }
  }
</style>
