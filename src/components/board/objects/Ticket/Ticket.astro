---
interface Stop {
  /** Three-letter code, as on a boarding pass. */
  code: string;
  /** City or country under the code. */
  place: string;
  /** A small flag bar under the place; only Colombia's is drawn. */
  flag?: "colombia";
}
interface Props {
  from: Stop;
  to: Stop;
  /** Short facts on the stub, e.g. ["One way", "Jun 2026"]. */
  details: readonly string[];
}
const { from, to, details } = Astro.props;
---

<!-- A one-way boarding pass with notched sides, from the roadmap prototype (Colombia to Valencia). -->
<span class="ticket">
  {[from, to].map((stop, index) => (
    <span class:list={["ticket__stop", { "ticket__stop--to": index === 1 }]}>
      <span class="ticket__code">{stop.code}</span>
      <span class="ticket__place">{stop.place}</span>
      {stop.flag === "colombia" && (
        <span class="ticket__flag" aria-hidden="true">
          <span class="ticket__flag-band ticket__flag-band--yellow" />
          <span class="ticket__flag-band ticket__flag-band--blue" />
          <span class="ticket__flag-band ticket__flag-band--red" />
        </span>
      )}
    </span>
  ))}
  <span class="ticket__plane" aria-hidden="true">
    ✈
  </span>
  <span class="ticket__details">
    {details.map((detail) => (
      <span class="ticket__detail">{detail}</span>
    ))}
  </span>
</span>

<style>
  .ticket {
    --_notch: 8px;
    box-sizing: border-box;
    display: grid;
    /* Each stop takes its own width and the plane centers in what is left, so the ticket stays compact. */
    grid-template-columns: auto 1fr auto;
    /* Both codes on one line, even though only Colombia has a flag bar underneath. */
    align-items: start;
    gap: 4px 10px;
    /* Fits "Valencia, Spain" on one line at the 14px floor. */
    width: 264px;
    padding: 14px 18px 12px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-rest);
    text-align: start;
    /* Two half-circle notches cut into the sides, like a torn boarding pass. */
    mask:
      radial-gradient(circle var(--_notch) at 0 50%, transparent 98%, #000) left / 51% 100% no-repeat,
      radial-gradient(circle var(--_notch) at 100% 50%, transparent 98%, #000) right / 51% 100% no-repeat;
  }
  .ticket__stop {
    display: grid;
    justify-items: start;
    gap: 2px;
  }
  /* The destination sits after the plane in the grid, aligned to the right. */
  .ticket__stop--to {
    grid-column: 3;
    grid-row: 1;
    justify-items: end;
    text-align: end;
  }
  .ticket__plane {
    grid-column: 2;
    grid-row: 1;
    justify-self: center;
    color: var(--color-text-accent);
    font-size: 1.1rem;
    line-height: 1.75rem;
  }
  .ticket__code {
    font: 600 1.75rem / 1 var(--font-mono);
    letter-spacing: 0.02em;
    color: var(--color-text);
  }
  .ticket__place {
    white-space: nowrap;
    font: var(--font-size-small) / 1.3 var(--font-sans);
    color: var(--color-text-muted);
  }
  .ticket__flag {
    display: flex;
    width: 44px;
    height: 5px;
    margin-top: 6px;
    border-radius: 2px;
    overflow: hidden;
  }
  .ticket__flag-band {
    flex: 1;
  }
  .ticket__flag-band--yellow {
    flex: 2;
    background: var(--color-flag-yellow);
  }
  .ticket__flag-band--blue {
    background: var(--color-flag-blue);
  }
  .ticket__flag-band--red {
    background: var(--color-flag-red);
  }
  .ticket__details {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px dashed var(--color-border);
  }
  .ticket__detail {
    font: 500 var(--font-size-small) / 1 var(--font-mono);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
</style>
