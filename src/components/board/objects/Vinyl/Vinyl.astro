---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { getLang, useTranslations } from "../../../../i18n/ui";
interface Props {
  /** Song title printed on the sleeve, e.g. "Unicornio". */
  title: string;
  /** Artist printed under the title, e.g. "Nanpa Básico". */
  artist: string;
  /** Accessible name of the toggle; defaults to "Play {title} by {artist}". Pass a translated one on Spanish pages. */
  label?: string;
  /** The record's real cover. It replaces the abstract art and the printed title, which the cover already carries. */
  cover?: ImageMetadata;
  /** Spotify URI of what plays, e.g. "spotify:album:4Ff07AMyi4ZUOORYUZpN9c" (a track works too). When set, pressing
   *  the record opens Spotify's player in the bottom-right corner; nothing loads from Spotify before that press. */
  spotify?: string;
}
const { title, artist, label = `Play ${title} by ${artist}`, cover, spotify } = Astro.props;
const t = useTranslations(getLang(Astro));
---

<!--
  A record in its sleeve, as a toggle button. Pressing it "plays" the song (no audio): the record slides
  out of the sleeve and spins, and equalizer bars move on the sleeve. Pressing again stops it and the
  record slides back in. aria-pressed carries the state; the name stays the same.
-->
<button
  type="button"
  class="vinyl"
  aria-pressed="false"
  aria-label={label}
  data-spotify={spotify}
  data-player-label={spotify && t("vinyl.player")}
  data-close-label={spotify && t("vinyl.close")}
>
  <span class="vinyl__stage">
    <span class="vinyl__record" aria-hidden="true"></span>
    <span class="vinyl__sleeve">
      {cover ? (
        <Image class="vinyl__cover" src={cover} alt="" width={184} height={184} />
      ) : (
        <>
          <span class="vinyl__art" aria-hidden="true" />
          <span class="vinyl__title">{title}</span>
          <span class="vinyl__artist">{artist}</span>
        </>
      )}
      <span class="vinyl__bars" aria-hidden="true">
        <span class="vinyl__bar" />
        <span class="vinyl__bar" />
        <span class="vinyl__bar" />
      </span>
    </span>
  </span>
</button>

<script>
  // One listener for every record on the page. On the desk, <desk-object> swallows the click after a drag.
  // A record with a Spotify URI opens Spotify's own player (its iFrame API) in a panel in the bottom-right corner.
  // The panel lives in <body>: on the desk the record sits inside rotated, translated boxes, where position: fixed
  // would follow the box instead of the screen.
  type Controller = {
    play(): void;
    togglePlay(): void;
    loadUri(uri: string): void;
    destroy(): void;
    addListener(
      event: "ready" | "playback_update",
      callback: (event: { data: { isPaused: boolean } }) => void,
    ): void;
  };
  type IFrameAPI = {
    createController(element: HTMLElement, options: object, callback: (controller: Controller) => void): void;
  };
  type Player = {
    panel: HTMLElement;
    controller: Promise<Controller>;
    vinyl: HTMLButtonElement;
    uri: string;
  };
  type VinylState = { api?: Promise<IFrameAPI>; player?: Player };

  // Page-wide state, set up once: a page that runs this script again (Storybook does when switching stories)
  // must not add a second listener, or one press would open two players.
  const scope = window as unknown as {
    vinylState?: VinylState;
    onSpotifyIframeApiReady?: (api: IFrameAPI) => void;
  };
  const firstRun = !scope.vinylState;
  const state = (scope.vinylState ??= {});

  /** Loads Spotify's iFrame API once, on the first press of a record. */
  function loadApi() {
    state.api ??= new Promise((resolve) => {
      scope.onSpotifyIframeApiReady = resolve;
      const script = document.createElement("script");
      script.src = "https://open.spotify.com/embed/iframe-api/v1";
      script.async = true;
      document.head.append(script);
    });
    return state.api;
  }

  function setPlaying(vinyl: HTMLButtonElement, playing: boolean) {
    vinyl.setAttribute("aria-pressed", String(playing));
  }

  function closePlayer() {
    const player = state.player;
    if (!player) return;
    delete state.player;
    void player.controller.then((controller) => controller.destroy());
    player.panel.remove();
    setPlaying(player.vinyl, false);
    player.vinyl.focus();
  }

  /** Creates the panel right away, so a second press while Spotify loads finds it instead of opening another. */
  function openPlayer(vinyl: HTMLButtonElement, uri: string): Player {
    const panel = document.createElement("aside");
    panel.className = "vinyl-player";
    panel.setAttribute("aria-label", vinyl.dataset["playerLabel"] ?? "");
    const close = document.createElement("button");
    close.type = "button";
    close.className = "vinyl-player__close";
    close.setAttribute("aria-label", vinyl.dataset["closeLabel"] ?? "");
    close.textContent = "✕";
    close.addEventListener("click", closePlayer);
    const embed = document.createElement("div");
    panel.append(close, embed);
    document.body.append(panel);

    const controller = loadApi().then(
      (api) =>
        new Promise<Controller>((resolve) => {
          api.createController(embed, { uri, width: "100%", height: 152 }, (created) => {
            created.addListener("ready", () => created.play());
            // The record follows the player, also when the visitor pauses inside it.
            created.addListener("playback_update", ({ data }) => {
              if (state.player?.controller === controller) setPlaying(state.player.vinyl, !data.isPaused);
            });
            resolve(created);
          });
        }),
    );
    return { panel, controller, vinyl, uri };
  }

  async function playOnSpotify(vinyl: HTMLButtonElement, uri: string) {
    const player = state.player;
    if (!player) {
      state.player = openPlayer(vinyl, uri);
      return;
    }
    if (player.uri === uri) {
      player.vinyl = vinyl;
      (await player.controller).togglePlay();
      return;
    }
    // Another record: the same player switches to its song.
    setPlaying(player.vinyl, false);
    player.vinyl = vinyl;
    player.uri = uri;
    const controller = await player.controller;
    controller.loadUri(uri);
    controller.play();
  }

  if (firstRun) {
    document.addEventListener("click", (event) => {
      const vinyl = (event.target as Element).closest<HTMLButtonElement>(".vinyl");
      if (!vinyl) return;
      setPlaying(vinyl, vinyl.getAttribute("aria-pressed") !== "true");
      const uri = vinyl.dataset["spotify"];
      if (uri) void playOnSpotify(vinyl, uri);
    });
  }
</script>

<style>
  .vinyl {
    all: unset;
    box-sizing: border-box;
    display: inline-block;
    cursor: pointer;
    /* Local illustration colors, the same in both themes: a black record with a cream and red label (v11)
       and an original abstract sleeve (night blue, a cream sun, a coral wave). */
    --_disc: #1b1b1d;
    --_groove: #111;
    --_hole: #141517;
    --_label: #f6eedd;
    --_label-ring: #d9534a;
    --_sleeve: #23214a;
    --_sleeve-deep: #15142e;
    --_sun: #f6eedd;
    --_wave: #ef7a5d;
    --_sleeve-text: #f6eedd;
    --_sleeve-muted: #c9c3e6;
    /* Geometry: the record peeks out of the sleeve's right edge and slides out further when playing. */
    --_sleeve-size: 184px;
    --_record-size: 172px;
    --_peek: 18px;
    --_hover-out: 14px;
    --_play-out: 92px;
  }
  .vinyl:focus-visible {
    outline: 2px solid var(--color-text-accent);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }
  .vinyl__stage {
    position: relative;
    display: block;
    width: calc(var(--_sleeve-size) + var(--_peek));
    height: var(--_sleeve-size);
  }

  /* The record: behind the sleeve, sliding along the x axis and spinning on its own rotate property. */
  .vinyl__record {
    position: absolute;
    top: calc((var(--_sleeve-size) - var(--_record-size)) / 2);
    left: calc(var(--_sleeve-size) + var(--_peek) - var(--_record-size));
    width: var(--_record-size);
    height: var(--_record-size);
    border-radius: var(--radius-round);
    background: radial-gradient(
      circle,
      var(--_hole) 0 2.5%,
      var(--_label) 3% 15%,
      var(--_label-ring) 15.5% 19%,
      var(--_groove) 19.5% 21%,
      var(--_disc) 22% 100%
    );
    /* The hairline keeps the black record visible on the dark theme's desk. */
    box-shadow:
      inset 0 0 0 2px rgb(255 255 255 / 0.08),
      0 0 0 1px var(--color-border),
      var(--shadow-rest);
    transition: translate var(--duration-slow) var(--ease-out);
    /* Always running but paused, so stopping keeps the angle instead of snapping back. */
    animation: vinyl-spin 1.8s linear infinite paused;
  }
  /* Grooves and a small printed mark on the label, so the spin reads. */
  .vinyl__record::before,
  .vinyl__record::after {
    content: "";
    position: absolute;
    border-radius: var(--radius-round);
  }
  .vinyl__record::before {
    inset: 8%;
    background: repeating-radial-gradient(circle, transparent 0 3px, rgb(255 255 255 / 0.05) 3px 4px);
  }
  .vinyl__record::after {
    top: 40%;
    left: 50%;
    width: 9%;
    height: 3%;
    border-radius: var(--radius-pill);
    background: var(--_label-ring);
    translate: -50% 0;
  }
  .vinyl:hover .vinyl__record {
    translate: var(--_hover-out) 0;
  }
  .vinyl[aria-pressed="true"] .vinyl__record {
    translate: var(--_play-out) 0;
    animation-play-state: running;
  }

  /* The sleeve: a square card over the record with abstract art and the song printed on it. */
  .vinyl__sleeve {
    position: absolute;
    inset: 0 auto 0 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    width: var(--_sleeve-size);
    padding: var(--space-3) var(--space-3) var(--space-3);
    box-sizing: border-box;
    overflow: hidden;
    border-radius: var(--radius-xs);
    background: linear-gradient(160deg, var(--_sleeve) 0%, var(--_sleeve-deep) 100%);
    box-shadow:
      0 0 0 1px var(--color-border),
      var(--shadow-rest);
    text-align: start;
  }
  /* The real cover fills the sleeve. */
  .vinyl__cover {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* A cream sun rising behind a coral wave, plus faint horizon lines. */
  .vinyl__art {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle 46px at 62% 40%, var(--_sun) 0 98%, transparent 100%),
      repeating-linear-gradient(to bottom, transparent 0 9px, rgb(246 238 221 / 0.07) 9px 10px);
  }
  .vinyl__art::after {
    content: "";
    position: absolute;
    left: -20%;
    right: -20%;
    top: 46%;
    height: 40px;
    background: var(--_wave);
    border-radius: 50% 50% 0 0 / 100% 100% 0 0;
    box-shadow: 0 40px 0 0 var(--_sleeve-deep);
  }
  .vinyl__title,
  .vinyl__artist {
    position: relative;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .vinyl__title {
    font: 600 var(--font-size-lead) / 1.15 var(--font-sans);
    color: var(--_sleeve-text);
  }
  .vinyl__artist {
    font: 500 var(--font-size-small) / var(--line-height-compact) var(--font-mono);
    color: var(--_sleeve-muted);
  }

  /* "Now playing" bars in the sleeve's top-left corner, only while pressed. */
  .vinyl__bars {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 16px;
    opacity: 0;
    transition: opacity var(--duration-medium) var(--ease-out);
  }
  .vinyl__bar {
    width: 4px;
    height: 100%;
    border-radius: 1px;
    background: var(--_wave);
    transform-origin: bottom;
    scale: 1 0.4;
    animation: vinyl-eq 0.9s ease-in-out infinite alternate paused;
  }
  .vinyl__bar:nth-child(2) {
    scale: 1 0.8;
    animation-duration: 0.7s;
    animation-delay: -0.3s;
  }
  .vinyl__bar:nth-child(3) {
    scale: 1 0.6;
    animation-duration: 1.1s;
    animation-delay: -0.6s;
  }
  .vinyl[aria-pressed="true"] .vinyl__bars {
    opacity: 1;
  }
  .vinyl[aria-pressed="true"] .vinyl__bar {
    animation-play-state: running;
  }

  /* Spotify's player, created in <body> by the script above (hence :global). The close button sits on its corner. */
  :global(.vinyl-player) {
    position: fixed;
    right: var(--space-4);
    bottom: var(--space-4);
    z-index: 100;
    width: min(352px, calc(100vw - 2 * var(--space-4)));
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-rest);
  }
  /* Below 901px the Dock sits at the bottom of the screen: the player rests above its 80px. */
  @media (max-width: 900px) {
    :global(.vinyl-player) {
      bottom: 80px;
    }
  }
  :global(.vinyl-player__close) {
    position: absolute;
    top: calc(-1 * var(--space-3));
    left: calc(-1 * var(--space-3));
    z-index: 1;
    display: grid;
    place-items: center;
    width: var(--space-6);
    height: var(--space-6);
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-round);
    background: var(--color-surface);
    box-shadow: var(--shadow-rest);
    color: var(--color-text);
    font: 600 12px / 1 var(--font-sans);
    cursor: pointer;
  }
  :global(.vinyl-player__close:focus-visible) {
    outline: 2px solid var(--color-text-accent);
    outline-offset: 2px;
  }
  :global(.vinyl-player iframe) {
    display: block;
    border: 0;
    border-radius: var(--radius-lg);
  }

  @keyframes vinyl-spin {
    to {
      rotate: 360deg;
    }
  }
  @keyframes vinyl-eq {
    from {
      scale: 1 0.25;
    }
    to {
      scale: 1 1;
    }
  }

  /* Reduced motion: no sliding or spinning; pressing still shows the record out and the bars, statically. */
  @media (prefers-reduced-motion: reduce) {
    .vinyl__record,
    .vinyl__bars,
    .vinyl__bar {
      transition: none;
      animation: none;
    }
    .vinyl:hover .vinyl__record {
      translate: none;
    }
    .vinyl[aria-pressed="true"] .vinyl__record {
      translate: var(--_play-out) 0;
    }
  }
</style>
