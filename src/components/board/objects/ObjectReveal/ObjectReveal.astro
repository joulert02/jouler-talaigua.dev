---
interface Props {
  /** First line, in bold. */
  title?: string;
  /** What the object lets the visitor discover. */
  text?: string;
}
const { title = "", text = "" } = Astro.props;
---

<!--
  The note a board object shows under itself once the visitor uses it. Closed until the object's script opens it
  (reveal.ts sets data-open); a live region, so the discovery is announced. The default slot adds a small line
  under the text (a credit).
-->
<span class="object-reveal" role="status">
  <strong class="object-reveal__title">{title}</strong>
  <span class="object-reveal__text">{text}</span>
  <slot />
</span>

<style>
  .object-reveal {
    position: absolute;
    left: 0;
    top: calc(100% + 10px);
    z-index: 2;
    box-sizing: border-box;
    display: block;
    width: max(100%, 220px);
    padding: 10px 12px;
    font: var(--font-size-small) / 1.4 var(--font-sans);
    color: var(--color-text-secondary);
    text-align: start;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-rest);
    opacity: 0;
    visibility: hidden;
    translate: 0 -6px;
    pointer-events: none;
    transition:
      opacity var(--duration-medium) var(--ease-out),
      translate var(--duration-medium) var(--ease-out),
      visibility 0s var(--duration-medium);
  }
  .object-reveal[data-open] {
    opacity: 1;
    visibility: visible;
    translate: none;
    transition-delay: 0s;
  }
  .object-reveal__title {
    display: block;
    color: var(--color-text);
    font-weight: 600;
  }
  .object-reveal__text {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .object-reveal {
      translate: none;
      transition: none;
    }
  }
</style>
