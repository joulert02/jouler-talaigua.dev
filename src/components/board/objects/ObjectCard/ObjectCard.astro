---
import { illustrations, type IllustrationName } from "./illustrations";
interface Props {
  /** The drawing at the top of the card. */
  illustration: IllustrationName;
  /** One short line, in bold: what the card is about. */
  title: string;
  /** One sentence under the title. */
  text: string;
}
const { illustration, title, text } = Astro.props;
const Illustration = illustrations[illustration];
---

<!-- A small card on the desk about an interest: a drawing, a title and a line of text. -->
<span class="object-card">
  <Illustration class="object-card__illustration" aria-hidden="true" width="40" height="40" />
  <strong class="object-card__title">{title}</strong>
  <span class="object-card__text">{text}</span>
</span>

<style>
  .object-card {
    box-sizing: border-box;
    display: grid;
    gap: 6px;
    width: 184px;
    padding: 14px 16px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    box-shadow: var(--shadow-rest);
    text-align: start;
  }
  .object-card__illustration {
    color: var(--color-text-secondary);
  }
  .object-card__title {
    font: 600 var(--font-size-body) / 1.25 var(--font-sans);
    color: var(--color-text);
  }
  .object-card__text {
    font: var(--font-size-small) / var(--line-height-compact) var(--font-sans);
    color: var(--color-text-muted);
  }
</style>
