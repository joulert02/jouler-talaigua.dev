---
import ObjectReveal from "../ObjectReveal/ObjectReveal.astro";
interface Props {
  /** Handwritten word on the jar's label, e.g. "bugs". */
  name: string;
  /** Accessible name of the bug while it is loose, e.g. "Catch the bug". */
  catchLabel: string;
  /** Accessible name of the jar, e.g. "Bug jar: open it to let the bug go". */
  releaseLabel: string;
  /** First line of the note shown once the bug is in the jar. */
  title: string;
  /** The note under the title. */
  text: string;
}
const { name, catchLabel, releaseLabel, title, text } = Astro.props;
---

<!--
  A glass jar with a bug walking beside it. The bug can be caught two ways: pressing it (the lid twists off, the
  bug jumps in and the lid closes), or picking it up and carrying it to the jar, whose lid opens by itself when
  the bug comes near, so it can be dropped in. Dropped anywhere else, the bug hops back beside the jar. Once it is
  inside, the note opens; pressing the jar opens the lid again and the bug jumps back out.
-->
<bug-jar class="bug-jar">
  <button type="button" class="bug-jar__jar" data-lid="closed" aria-label={releaseLabel} disabled>
    <span class="bug-jar__lid"></span>
    <span class="bug-jar__neck"></span>
    <span class="bug-jar__glass"></span>
    <span class="bug-jar__label">{name}</span>
  </button>
  <button type="button" class="bug-jar__bug" aria-label={catchLabel}>
    <svg
      class="bug-jar__bug-art"
      viewBox="0 0 26 26"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <ellipse cx="13" cy="14" rx="5.5" ry="7.5" fill="currentColor"></ellipse>
      <circle cx="13" cy="5.5" r="2.8" fill="currentColor"></circle>
      <path d="M7.5 11 3 8M7.5 15H2.5M8 19l-4 3M18.5 11 23 8M18.5 15h5M18 19l4 3"></path>
    </svg>
  </button>
  <ObjectReveal title={title} text={text} />
</bug-jar>

<script>
  import { DRAG_THRESHOLD } from "../../../ui/Desk/camera";
  import { setReveal } from "../reveal";

  type Point = [number, number];
  const wait = (ms: number) => new Promise((done) => setTimeout(done, ms));
  /** Where the bug rests: inside the jar, and loose beside it (left, top in pixels from the object's corner). */
  const INSIDE: Point = [36, 83];
  const OUTSIDE: Point = [132, 84];
  /** The jar's mouth, where a carried bug is dropped in. */
  const MOUTH: Point = [52, 24];
  /** A carried bug this close to the mouth, in pixels, opens the lid. */
  const NEAR = 96;
  /** Half the bug's box: its position is its top-left corner. */
  const HALF = 16;

  class BugJarElement extends HTMLElement {
    private abort: AbortController | undefined;

    connectedCallback() {
      const jar = this.querySelector<HTMLButtonElement>(".bug-jar__jar");
      const bug = this.querySelector<HTMLButtonElement>(".bug-jar__bug");
      if (!jar || !bug) return;
      this.abort = new AbortController();
      const signal = this.abort.signal;
      const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const pause = (ms: number) => wait(still ? 0 : ms);
      let busy = false;
      let unscrewing: ReturnType<typeof setTimeout> | undefined;

      /** Opens the lid (it unscrews, then swings open) or closes it; asking twice for the same thing is fine. */
      const setLid = (open: boolean) => {
        if (!open) {
          clearTimeout(unscrewing);
          jar.dataset["lid"] = "closed";
        } else if (jar.dataset["lid"] === "closed") {
          jar.dataset["lid"] = "spin";
          unscrewing = setTimeout(() => (jar.dataset["lid"] = "open"), still ? 0 : 420);
        }
      };
      const place = ([x, y]: Point) => {
        bug.style.left = `${x}px`;
        bug.style.top = `${y}px`;
      };
      /** Pixels on screen per pixel of the object, in case something scales it. */
      const zoom = () => this.getBoundingClientRect().width / this.offsetWidth || 1;
      /** Where the bug is right now, walk included, in the object's own pixels. */
      const whereabouts = (): Point => {
        const box = bug.getBoundingClientRect();
        const origin = this.getBoundingClientRect();
        return [(box.left - origin.left) / zoom(), (box.top - origin.top) / zoom()];
      };
      /** The bug travels between two spots: a tumbling jump, or a short straight drop. */
      const travel = async (from: Point, to: Point, how: "jump" | "drop") => {
        place(to);
        if (still) return;
        const frames: Keyframe[] =
          how === "jump"
            ? [
                {
                  left: `${from[0]}px`,
                  top: `${from[1]}px`,
                  rotate: "0deg",
                  easing: "cubic-bezier(0.2, 0.7, 0.4, 1)",
                },
                {
                  left: `${(from[0] + to[0]) / 2}px`,
                  top: `${Math.min(from[1], to[1]) - 90}px`,
                  rotate: "200deg",
                  easing: "cubic-bezier(0.6, 0, 0.8, 0.4)",
                },
                { left: `${to[0]}px`, top: `${to[1]}px`, rotate: "360deg" },
              ]
            : [
                { left: `${from[0]}px`, top: `${from[1]}px`, easing: "cubic-bezier(0.5, 0, 0.9, 0.5)" },
                { left: `${to[0]}px`, top: `${to[1]}px` },
              ];
        await bug.animate(frames, { duration: how === "jump" ? 680 : 320 }).finished;
      };
      /** The lid closes over a bug that just landed inside, or after one that left. */
      const settle = async (caught: boolean) => {
        this.dataset["bug"] = caught ? "caught" : "loose";
        setLid(false);
        await pause(360);
        // Inside the jar the bug cannot be pressed; the jar lets it out.
        bug.disabled = caught;
        jar.disabled = !caught;
        setReveal(this, caught);
        (caught ? jar : bug).focus({ preventScroll: true });
        busy = false;
      };
      /** A press: the lid opens by itself and the bug jumps in, or back out. */
      const jump = async (caught: boolean) => {
        if (busy) return;
        busy = true;
        const from = caught ? whereabouts() : INSIDE;
        // It stops walking (or wiggling) for the jump.
        this.dataset["bug"] = "jumping";
        setLid(true);
        await pause(700);
        await travel(from, caught ? INSIDE : OUTSIDE, "jump");
        await settle(caught);
      };
      bug.addEventListener("click", () => void jump(true), { signal });
      jar.addEventListener("click", () => void jump(false), { signal });

      // A press that travels picks the bug up. Near the jar the lid opens by itself; dropped there, the bug falls
      // in. Dropped anywhere else, it hops back beside the jar: it belongs to the jar and must not be left
      // behind, where it would slide along whenever the jar is moved.
      bug.addEventListener(
        "pointerdown",
        (down) => {
          if (down.button !== 0 || busy) return;
          // The object's own drag (on the desk) is for the jar, not for the bug.
          down.stopPropagation();
          let origin: Point | undefined;
          let near = false;
          const moves = new AbortController();
          const move = (event: PointerEvent) => {
            if (event.pointerId !== down.pointerId) return;
            const dx = (event.clientX - down.clientX) / zoom();
            const dy = (event.clientY - down.clientY) / zoom();
            if (!origin) {
              if (Math.hypot(dx, dy) <= DRAG_THRESHOLD) return;
              origin = whereabouts();
              busy = true;
              this.dataset["bug"] = "held";
              getSelection()?.removeAllRanges();
            }
            const at: Point = [origin[0] + dx, origin[1] + dy];
            place(at);
            near = Math.hypot(at[0] + HALF - MOUTH[0], at[1] + HALF - MOUTH[1]) < NEAR;
            setLid(near);
          };
          const end = (event: PointerEvent) => {
            if (event.pointerId !== down.pointerId) return;
            moves.abort();
            if (!origin) return;
            // The release after a drag is not a press on the bug.
            const swallow = (click: Event) => {
              click.preventDefault();
              click.stopPropagation();
            };
            this.addEventListener("click", swallow, { capture: true, once: true });
            setTimeout(() => this.removeEventListener("click", swallow, { capture: true }), 0);
            this.dataset["bug"] = "jumping";
            if (!near) {
              void travel([bug.offsetLeft, bug.offsetTop], OUTSIDE, "jump").then(() => {
                this.dataset["bug"] = "loose";
                busy = false;
              });
              return;
            }
            void (async () => {
              // The lid may still be unscrewing when the bug is dropped quickly.
              if (jar.dataset["lid"] !== "open") await pause(440);
              await travel([bug.offsetLeft, bug.offsetTop], INSIDE, "drop");
              await settle(true);
            })();
          };
          window.addEventListener("pointermove", move, { signal: moves.signal });
          window.addEventListener("pointerup", end, { signal: moves.signal });
          window.addEventListener("pointercancel", end, { signal: moves.signal });
        },
        { signal },
      );
    }

    disconnectedCallback() {
      this.abort?.abort();
    }
  }

  if (!customElements.get("bug-jar")) customElements.define("bug-jar", BugJarElement);
</script>

<style>
  .bug-jar {
    position: relative;
    display: inline-block;
    width: 104px;
    height: 150px;
  }
  .bug-jar__jar {
    all: unset;
    box-sizing: border-box;
    position: relative;
    display: block;
    width: 104px;
    height: 150px;
  }
  .bug-jar__jar:enabled {
    cursor: pointer;
  }
  .bug-jar__jar:focus-visible {
    outline: 2px solid var(--color-text-accent);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }
  /* The lid: ridged metal, the same in both themes. It unscrews (the ridges slide) and then swings open. */
  .bug-jar__lid {
    position: absolute;
    left: 14px;
    right: 14px;
    top: 0;
    z-index: 3;
    height: 20px;
    border-radius: 5px 5px 2px 2px;
    background: repeating-linear-gradient(90deg, #4a4f57 0 5px, #717782 5px 8px);
    box-shadow: inset 0 3px 0 rgb(255 255 255 / 0.25);
    transform-origin: 0 100%;
    transition: transform 0.38s var(--ease-spring);
  }
  [data-lid="spin"] > .bug-jar__lid {
    animation: bug-jar-unscrew 0.5s ease-in forwards;
  }
  @keyframes bug-jar-unscrew {
    to {
      background-position-x: -40px;
      transform: translateY(-6px);
    }
  }
  [data-lid="open"] > .bug-jar__lid {
    transform: translate(-12px, -10px) rotate(-78deg);
  }
  .bug-jar__neck {
    position: absolute;
    left: 18px;
    right: 18px;
    top: 18px;
    height: 12px;
    border: 2px solid color-mix(in srgb, var(--color-text) 45%, transparent);
    border-width: 0 2px;
    background: repeating-linear-gradient(
      0deg,
      transparent 0 3px,
      color-mix(in srgb, var(--color-text) 22%, transparent) 3px 4px
    );
  }
  .bug-jar__glass {
    position: absolute;
    inset: 28px 0 0;
    border: 2px solid color-mix(in srgb, var(--color-text) 45%, transparent);
    border-radius: 18px 18px 24px 24px;
    background:
      linear-gradient(100deg, transparent 8%, rgb(255 255 255 / 0.5) 10% 16%, transparent 18%),
      linear-gradient(100deg, rgb(255 255 255 / 0.22), transparent 45%),
      color-mix(in srgb, var(--color-surface) 50%, transparent);
    box-shadow: 0 14px 14px -12px rgb(20 21 23 / 0.45);
  }
  /* A paper label with handwriting, the same in both themes. */
  .bug-jar__label {
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 18px;
    z-index: 2;
    padding: 3px;
    text-align: center;
    font: 600 1.125rem / 1.1 var(--font-hand);
    color: #3d4148;
    background: #fbf8f0;
    border-radius: 3px;
    rotate: -2deg;
  }
  /* The bug: a 26px drawing inside a 32px target. */
  .bug-jar__bug {
    all: unset;
    box-sizing: border-box;
    position: absolute;
    left: 132px;
    top: 84px;
    z-index: 1;
    width: 32px;
    height: 32px;
    padding: 3px;
    color: var(--color-text);
    cursor: grab;
    touch-action: none;
    animation: bug-jar-walk 8s linear infinite;
  }
  .bug-jar__bug:focus-visible {
    outline: 2px solid var(--color-text-accent);
    outline-offset: 2px;
    border-radius: var(--radius-round);
  }
  .bug-jar__bug-art {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* A small loop beside the jar, turning at each corner. */
  @keyframes bug-jar-walk {
    0% {
      transform: translate(0, 0) rotate(90deg);
    }
    24% {
      transform: translate(70px, 6px) rotate(96deg);
    }
    26% {
      transform: translate(72px, 8px) rotate(186deg);
    }
    49% {
      transform: translate(64px, 52px) rotate(190deg);
    }
    51% {
      transform: translate(62px, 52px) rotate(276deg);
    }
    74% {
      transform: translate(4px, 46px) rotate(270deg);
    }
    76% {
      transform: translate(2px, 44px) rotate(360deg);
    }
    100% {
      transform: translate(0, 0) rotate(450deg);
    }
  }
  .bug-jar[data-bug="jumping"] > .bug-jar__bug {
    animation: none;
  }
  /* In the hand it squirms, above the jar and its lid. */
  .bug-jar[data-bug="held"] > .bug-jar__bug {
    z-index: 4;
    cursor: grabbing;
    animation: bug-jar-wiggle 0.18s ease-in-out infinite alternate;
  }
  .bug-jar[data-bug="caught"] > .bug-jar__bug {
    cursor: default;
    animation: bug-jar-wiggle 0.6s ease-in-out infinite alternate;
  }
  @keyframes bug-jar-wiggle {
    from {
      transform: rotate(-12deg);
    }
    to {
      transform: rotate(12deg) translateY(-3px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bug-jar__lid {
      transition: none;
    }
    [data-lid="spin"] > .bug-jar__lid,
    .bug-jar__bug,
    .bug-jar[data-bug="held"] > .bug-jar__bug,
    .bug-jar[data-bug="caught"] > .bug-jar__bug {
      animation: none;
    }
  }
</style>
