---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
interface Props {
  /** Title on the cover. With a `cover` image it is not printed: the image already carries it. */
  title: string;
  /** Author under the title. */
  author: string;
  /** Cover color, any CSS color, e.g. "#2f5d8a": the whole cover without an image, its edge and inside with one.
   *  Covers print white text: keep it dark enough. */
  color: string;
  /** The book's real cover. It fills the front and replaces the printed title and author. */
  cover?: ImageMetadata;
  /** Small heading on the first page, e.g. "MY REVIEW". */
  heading: string;
  /** The handwritten review on the first page: two or three lines. */
  review: string;
  /** Print inside the cover, e.g. "ex libris · JOTA". */
  bookplate: string;
  /** Accessible name of the toggle, e.g. "How to Know a Person: open the book". */
  label: string;
}
const { title, author, color, cover, heading, review, bookplate, label } = Astro.props;
// The review describes the button: ids are shared by the whole document, so each book gets its own.
const pages = `book-${crypto.randomUUID().slice(0, 8)}`;
---

<!--
  A book that opens on a handwritten review. A toggle button: pressing it swings the cover (a color with the title, or the book's real cover image) open in 3D over the
  first page, with a bookplate inside the cover; pressing again closes it. The button is named by `label` and
  described by the review, since a name replaces what a button holds for assistive technology.
-->
<button
  type="button"
  class="book"
  aria-pressed="false"
  aria-label={label}
  aria-describedby={pages}
  style={`--_cover: ${color}`}
>
  <span class="book__pages" id={pages}>
    <span class="book__heading">{heading}</span>
    <span class="book__review">{review}</span>
  </span>
  <span class="book__cover">
    <span class="book__front">
      {cover ? (
        <Image
          class="book__art"
          src={cover}
          alt=""
          width={132}
          height={178}
          densities={[1, 2, 3]}
          fit="cover"
          loading="eager"
          draggable="false"
        />
      ) : (
        <>
          <span class="book__title">{title}</span>
          <span class="book__author">{author}</span>
        </>
      )}
    </span>
    <span class="book__inside">{bookplate}</span>
  </span>
</button>

<script>
  // One listener for every book on the page. On the desk, <desk-object> swallows the click after a drag.
  const scope = window as typeof window & { bookReady?: boolean };
  if (!scope.bookReady) {
    scope.bookReady = true;
    document.addEventListener("click", (event) => {
      const book = (event.target as Element).closest<HTMLButtonElement>(".book");
      book?.setAttribute("aria-pressed", String(book.getAttribute("aria-pressed") !== "true"));
    });
  }
</script>

<style>
  .book {
    all: unset;
    box-sizing: border-box;
    position: relative;
    display: block;
    width: 132px;
    height: 178px;
    perspective: 1100px;
    cursor: pointer;
    /* Local illustration colors, the same in both themes: cream pages, graphite handwriting, a red ribbon. */
    --_paper: #fbf8f0;
    --_paper-edge: #e2dac5;
    --_ink: #3d4148;
    --_print: #5b616a;
  }
  .book:focus-visible {
    outline: 2px solid var(--color-text-accent);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }
  /* The block of pages, with a few page edges drawn as offset shadows. */
  .book__pages {
    position: absolute;
    inset: 4px 9px 4px 2px;
    box-sizing: border-box;
    display: grid;
    align-content: start;
    gap: 6px;
    padding: 14px 12px;
    background: var(--_paper);
    border-radius: 2px 4px 4px 2px;
    box-shadow:
      2px 0 0 var(--_paper-edge),
      4px 0 0 var(--_paper),
      6px 0 0 var(--_paper-edge),
      8px 6px 16px -6px rgb(20 21 23 / 0.4);
    color: var(--_ink);
  }
  /* The ribbon bookmark. */
  .book__pages::after {
    content: "";
    position: absolute;
    right: 20px;
    bottom: -12px;
    width: 8px;
    height: 24px;
    background: var(--color-flag-red);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 78%, 0 100%);
  }
  .book__heading {
    font: 500 0.6875rem / 1.3 var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--_print);
  }
  .book__review {
    font: 600 1.0625rem / 1.15 var(--font-hand);
  }
  .book__cover {
    position: absolute;
    inset: 0;
    transform-origin: left center;
    transform-style: preserve-3d;
    transition: transform 0.85s var(--ease-out);
  }
  .book[aria-pressed="true"] > .book__cover {
    transform: rotateY(-158deg);
  }
  .book__front,
  .book__inside {
    position: absolute;
    inset: 0;
    box-sizing: border-box;
    border-radius: 3px 6px 6px 3px;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  /* The cover: its color under a spine crease and a soft highlight. */
  .book__front {
    display: grid;
    align-content: space-between;
    padding: 18px 14px 14px 18px;
    background:
      linear-gradient(90deg, rgb(0 0 0 / 0.28) 0 5px, rgb(255 255 255 / 0.14) 5px 8px, transparent 8px),
      linear-gradient(160deg, rgb(255 255 255 / 0.12), transparent 50%), var(--_cover);
    color: #fff;
  }
  /* A real cover fills the front, under the same spine crease the plain cover has. */
  .book__front:has(> .book__art) {
    padding: 0;
    overflow: hidden;
    background: var(--_cover);
  }
  .book__art {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .book__front:has(> .book__art)::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgb(0 0 0 / 0.28) 0 4px,
      rgb(255 255 255 / 0.16) 4px 6px,
      transparent 6px
    );
  }
  .book__title {
    font: 600 1.0625rem / 1.18 var(--font-sans);
  }
  .book__author {
    font: 500 0.6875rem / 1.3 var(--font-mono);
    opacity: 0.85;
  }
  .book__inside {
    display: grid;
    place-content: center;
    transform: rotateY(180deg);
    background: #efe7d3;
    border: 5px solid var(--_cover);
    font: 500 0.6875rem / 1.3 var(--font-mono);
    color: #8a826c;
  }

  @media (prefers-reduced-motion: reduce) {
    .book__cover {
      transition: none;
    }
  }
</style>
