---
import { footer, type FooterData } from "../../../config/profile";
import { getLang, useTranslations } from "../../../i18n/ui";
interface Props {
  data?: FooterData;
}
const { data = footer } = Astro.props;
const lang = getLang(Astro);
const t = useTranslations(lang);
---

<footer class="footer" id="contact" tabindex="-1">
  <div class="footer__columns">
    {data.columns.map((column) => (
      <div class="footer__column">
        <h2 class="footer__heading">{t(column.heading)}</h2>
        <ul class="footer__list">
          {column.items.map((item) => (
            <li class:list={["footer__item", { "footer__item--email": item.kind === "email" }]}>
              {item.kind === "link" ? (
                <a
                  class="footer__link"
                  href={item.link.href}
                  target={item.link.target}
                  rel={item.link.target === "_blank" ? "noopener noreferrer" : undefined}
                >
                  {t(item.link.label)}
                </a>
              ) : item.kind === "email" ? (
                <>
                  {item.address}
                  <slot name="copy-email" />
                </>
              ) : (
                item.text[lang]
              )}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <p class="footer__wordmark" aria-hidden="true" translate="no">
    {data.wordmark}
  </p>
  <div class="footer__bottom">
    <span class="footer__origin" lang={data.originLang}>
      {data.origin[lang]}
      <span class="footer__flag" aria-hidden="true">
        <i class="footer__stripe footer__stripe--yellow"></i>
        <i class="footer__stripe footer__stripe--blue"></i>
        <i class="footer__stripe footer__stripe--red"></i>
      </span>
    </span>
    <span>{data.copyright}</span>
  </div>
</footer>
<style>
  .footer {
    --_wordmark-min: 44px;
    --_wordmark-max: 168px;
    --_flag-width: 16px;
    --_flag-height: 11px;
    max-width: var(--layout-container);
    margin: var(--space-10) auto 0;
    padding: var(--space-8) 0 calc(var(--space-7) + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid var(--color-border);
    display: grid;
    gap: var(--space-8);
    color: var(--color-text);
    font: var(--font-size-body)/var(--line-height-body) var(--font-sans);
    overflow-wrap: anywhere;
  }
  .footer__columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
  }
  .footer__heading {
    margin: 0 0 var(--space-3);
    font-size: inherit;
    font-weight: 600;
  }
  .footer__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .footer__item {
    color: var(--color-text-muted);
    font-weight: 300;
  }
  .footer__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }
  .footer__link:hover {
    color: var(--color-text-accent);
  }
  .footer__link:focus-visible {
    outline: 2px solid var(--color-text-accent);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }
  .footer__item--email {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }
  .footer__wordmark {
    margin: 0;
    font-size: clamp(var(--_wordmark-min), 11.5vw, var(--_wordmark-max));
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.045em;
  }
  .footer__bottom,
  .footer__origin {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }
  .footer__bottom {
    justify-content: space-between;
    color: var(--color-text-muted);
    font-weight: 300;
  }
  .footer__flag {
    display: inline-grid;
    grid-template-rows: 2fr 1fr 1fr;
    width: var(--_flag-width);
    height: var(--_flag-height);
    border-radius: var(--radius-xs);
    overflow: hidden;
    flex: none;
  }
  .footer__stripe--yellow {
    background: var(--color-flag-yellow);
  }
  .footer__stripe--blue {
    background: var(--color-flag-blue);
  }
  .footer__stripe--red {
    background: var(--color-flag-red);
  }
  @media (max-width: 640px) {
    .footer__columns {
      grid-template-columns: 1fr 1fr;
    }
    .footer__column:last-child {
      grid-column: 1/-1;
    }
  }
</style>
