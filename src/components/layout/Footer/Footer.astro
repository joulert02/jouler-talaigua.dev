---
import { footer, localized, type FooterData } from "../../../config/profile";
import { getLang, useTranslations } from "../../../i18n/ui";
interface Props {
  data?: FooterData;
}
const { data = footer } = Astro.props;
const lang = getLang(Astro);
const t = useTranslations(lang);
---

<footer class="footer" id="contact" tabindex="-1">
  <div class="footer__columns">
    {data.columns.map((column) => (
      <div class="footer__column">
        <h2 class="footer__heading">{t(column.heading)}</h2>
        <ul class="footer__list">
          {column.items.map((item) => (
            <li class:list={["footer__item", { "footer__item--email": item.kind === "email" }]}>
              {item.kind === "link" ? (
                <a
                  class="footer__link"
                  href={localized(item.link.href, lang)}
                  download={item.link.download}
                  target={item.link.target}
                  rel={item.link.target === "_blank" ? "noopener noreferrer" : undefined}
                >
                  {t(item.link.label)}
                </a>
              ) : item.kind === "email" ? (
                <>
                  {item.address}
                  <slot name="copy-email" />
                </>
              ) : (
                item.text[lang]
              )}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <p class="footer__wordmark" aria-hidden="true" translate="no">
    {data.wordmark}
  </p>
  <div class="footer__bottom">
    <span class="footer__origin" lang={data.originLang}>
      {data.origin[lang]}
      <span class="footer__flag" aria-hidden="true">
        <i class="footer__stripe footer__stripe--yellow"></i>
        <i class="footer__stripe footer__stripe--blue"></i>
        <i class="footer__stripe footer__stripe--red"></i>
      </span>
    </span>
    <span class="footer__copyright">{data.copyright}</span>
  </div>
</footer>
<style>
  /*
   * Calm and structured (owner review, HU-04): one hairline opens the footer, the columns share one row height, then
   * the wordmark and a quiet bottom line under its own hairline. From 720px the columns sit on the layout's quarters
   * with its gap (owner review, 2026-11-23): Site and Social in the left half, Contact from the right half, where a
   * case's "Next" sits above it; the wordmark fills the container's width. Labels in mono
   * like the rest of the site's captions; links one tone below the text. Values from the space scale only.
   * `--footer-gap` lets a page end flush with it (a case: CaseNext's band sits right on the footer's hairline).
   */
  .footer {
    --_row: 44px;
    --_flag-width: 16px;
    --_flag-height: 11px;
    max-width: var(--layout-container);
    container: footer / inline-size;
    margin: var(--footer-gap, var(--space-10)) auto 0;
    padding: var(--space-8) 0 calc(var(--space-6) + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid var(--color-border);
    display: grid;
    color: var(--color-text);
    font: var(--font-size-body) / var(--line-height-compact) var(--font-sans);
    overflow-wrap: anywhere;
  }
  /* Mobile first: two columns with the last one full width; three side by side from 720px. */
  .footer__columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-7) var(--space-6);
  }
  .footer__column:last-child {
    grid-column: 1 / -1;
  }
  .footer__heading {
    margin: 0 0 var(--space-2);
    color: var(--color-text-muted);
    font: 500 var(--font-size-label) / 1.3 var(--font-mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .footer__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* One row height for every item, link or not, so the rows line up across the columns. */
  .footer__item {
    display: flex;
    align-items: center;
    min-height: var(--_row);
    color: var(--color-text-muted);
  }
  .footer__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--_row);
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }
  .footer__link:hover {
    color: var(--color-text);
  }
  .footer__link:focus-visible {
    outline: 2px solid var(--color-text-accent);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }
  .footer__item--email {
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    color: var(--color-text-secondary);
  }
  .footer__wordmark {
    margin: var(--space-9) 0 var(--space-7);
    /* The name is 6.46 times as wide as its font size: 6.5 fills the container's width edge to edge, with no overflow. */
    font-size: calc(100cqi / 6.5);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.045em;
  }
  .footer__bottom,
  .footer__origin {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }
  .footer__bottom {
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
  }
  .footer__flag {
    display: inline-grid;
    grid-template-rows: 2fr 1fr 1fr;
    width: var(--_flag-width);
    height: var(--_flag-height);
    border-radius: var(--radius-xs);
    overflow: hidden;
    flex: none;
  }
  .footer__stripe--yellow {
    background: var(--color-flag-yellow);
  }
  .footer__stripe--blue {
    background: var(--color-flag-blue);
  }
  .footer__stripe--red {
    background: var(--color-flag-red);
  }
  /* A fine pointer does not need the 44px touch row: the list tightens to a reading rhythm. */
  @media (pointer: fine) {
    .footer {
      --_row: 32px;
    }
  }
  @media (min-width: 720px) {
    .footer {
      padding-top: var(--space-9);
    }
    .footer__columns {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: var(--layout-gap);
    }
    .footer__column:last-child {
      grid-column: 3 / -1;
    }
    .footer__wordmark {
      margin: var(--space-10) 0 var(--space-9);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .footer__link {
      transition: none;
    }
  }
</style>
