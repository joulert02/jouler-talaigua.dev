---
import { languageItems, type LanguageItem } from "../../../config/profile";
import { getLang, useTranslations } from "../../../i18n/ui";
interface Props {
  /** Languages offered, each with the URL of this page in that language. */
  items?: readonly LanguageItem[];
}
const { items = languageItems } = Astro.props;
const lang = getLang(Astro);
const t = useTranslations(lang);
---

<nav class="language-switch" aria-label={t("layout.language")}>
  {items.map((item) =>
    item.lang === lang ? (
      <span class="language-switch__option" aria-current="page" lang={item.lang}>
        {t(item.label)}
      </span>
    ) : (
      <a
        class="language-switch__option"
        href={item.href}
        lang={item.lang}
        hreflang={item.lang}
        aria-label={useTranslations(item.lang)("layout.readIn")}
      >
        {t(item.label)}
      </a>
    ),
  )}
</nav>
<style>
  /* v11 segmented pill (docs/design/v11/case.css, .lang). */
  .language-switch {
    display: inline-flex;
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    font: 500 13px/1 var(--font-mono);
  }
  .language-switch__option {
    display: grid;
    place-items: center;
    min-width: 44px;
    min-height: 44px;
    border-radius: var(--radius-pill);
    color: var(--color-text-secondary);
    text-decoration: none;
  }
  .language-switch__option[aria-current] {
    background: var(--color-text);
    color: var(--color-bg);
  }
  @media (hover: hover) {
    a.language-switch__option:hover {
      background: var(--color-surface-hover);
      color: var(--color-text);
    }
  }
  a.language-switch__option:focus-visible {
    outline: 2px solid var(--color-text-accent);
    outline-offset: 2px;
  }
</style>
