---
import Icon from "../../ui/Icon/Icon.astro";
import { getLang, useTranslations } from "../../../i18n/ui";
import { contactEmail } from "../../../config/profile";
interface Props {
  /** `icon`: envelope with a tooltip (the Dock). `text`: a small "Copy" button next to the address (v11 footer). */
  variant?: "icon" | "text";
}
const { variant = "icon" } = Astro.props;
const lang = getLang(Astro);
const t = useTranslations(lang);
---

<copy-email data-email={contactEmail} data-copied={t("dock.copied")} data-failed={t("dock.failed")}>
  {variant === "text" ? (
    <button class="copy-email__text" type="button" aria-label={t("dock.copyLabel")}>
      {t("dock.copyText")}
    </button>
  ) : (
    <button
      class="copy-email__button"
      type="button"
      aria-label={t("dock.copyLabel")}
      data-tip={t("dock.copyTooltip")}
    >
      <Icon name="email" />
    </button>
  )}
  <span class="copy-email__feedback" role="status" aria-live="polite"></span>
</copy-email>
<script>
  class CopyEmail extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector("button");
      const feedback = this.querySelector<HTMLElement>(".copy-email__feedback");
      button?.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(this.dataset.email ?? "");
          if (feedback) feedback.textContent = this.dataset.copied ?? "";
        } catch {
          if (feedback) feedback.textContent = `${this.dataset.failed ?? ""}: ${this.dataset.email ?? ""}`;
        }
      });
    }
  }
  if (!customElements.get("copy-email")) customElements.define("copy-email", CopyEmail);
</script>
<style>
  copy-email {
    --_target-size: 44px;
    --_focus-width: 2px;
    --_tooltip-offset: 10px;
    --_tooltip-font-size: 12.5px;
    --_tooltip-padding-block: 7px;
    --_tooltip-padding-inline: 9px;
    --_feedback-bottom: 88px;
    --_feedback-padding-inline: 14px;

    position: relative;
    display: inline-flex;
  }
  .copy-email__button {
    --_duration: 180ms;
    position: relative;
    box-sizing: border-box;
    min-width: var(--_target-size);
    height: var(--_target-size);
    padding: 0 var(--space-3);
    border: 0;
    border-radius: var(--radius-lg);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    transition:
      background-color var(--_duration) var(--ease-out),
      color var(--_duration) var(--ease-out);
  }
  .copy-email__button:hover {
    background: var(--color-surface-hover);
    color: var(--color-text);
  }
  .copy-email__button:focus-visible {
    outline: var(--_focus-width) solid var(--color-text-accent);
    outline-offset: var(--_focus-width);
  }
  .copy-email__button::after {
    content: attr(data-tip);
    position: absolute;
    bottom: calc(100% + var(--_tooltip-offset));
    left: 50%;
    transform: translate(-50%, 4px);
    white-space: nowrap;
    background: var(--color-text);
    color: var(--color-bg);
    font: 500 var(--_tooltip-font-size)/1 var(--font-sans);
    padding: var(--_tooltip-padding-block) var(--_tooltip-padding-inline);
    border-radius: var(--radius-md);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }
  .copy-email__button:hover::after,
  .copy-email__button:focus-visible::after {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  /* v11 footer `.copy` (docs/design/v11/styles.css). */
  .copy-email__text {
    --_duration: 180ms;
    padding: 5px 8px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-text-muted);
    font: 500 12.5px/1 var(--font-mono);
    cursor: pointer;
    transition:
      color var(--_duration) var(--ease-out),
      border-color var(--_duration) var(--ease-out);
  }
  .copy-email__text:hover {
    border-color: var(--color-text-muted);
    color: var(--color-text);
  }
  .copy-email__text:focus-visible {
    outline: var(--_focus-width) solid var(--color-text-accent);
    outline-offset: var(--_focus-width);
  }
  .copy-email__feedback:not(:empty) {
    --_feedback-max: calc(100vw - 32px);
    max-width: var(--_feedback-max);
    overflow-wrap: anywhere;
    position: fixed;
    bottom: var(--_feedback-bottom);
    left: 50%;
    transform: translateX(-50%);
    white-space: normal;
    background: var(--color-text);
    color: var(--color-bg);
    font: 500 var(--font-size-small)/1 var(--font-sans);
    padding: var(--_tooltip-offset) var(--_feedback-padding-inline);
    border-radius: var(--radius-pill);
  }
  @media (max-width: 560px) {
    .copy-email__button {
      padding: 0 var(--space-2);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .copy-email__button,
    .copy-email__button::after,
    .copy-email__text {
      transition: none;
    }
  }
</style>
