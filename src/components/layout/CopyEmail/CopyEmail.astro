---
import Icon from "../../ui/Icon/Icon.astro";
import { getLang, useTranslations } from "../../../i18n/ui";
import { contactEmail } from "../../../config/profile";
interface Props {
  /** `icon`: envelope with a tooltip (the Dock). `text`: a text action under the address (the footer). */
  variant?: "icon" | "text";
}
const { variant = "icon" } = Astro.props;
const lang = getLang(Astro);
const t = useTranslations(lang);
---

<copy-email
  data-email={contactEmail}
  data-copied={t("dock.copied")}
  data-failed={variant === "text" ? t("dock.copyFailed") : `${t("dock.failed")}: ${contactEmail}`}
>
  {variant === "text" ? (
    <button class="copy-email__text" type="button" aria-label={t("dock.copyTooltip")}>
      <span class="copy-email__label">{t("dock.copyTooltip")}</span>
      {/* Shown in the label's place after a press; the status below says it. */}
      <span class="copy-email__label copy-email__label--copied" aria-hidden="true">
        {t("dock.copied")}
      </span>
      <span class="copy-email__label copy-email__label--failed" aria-hidden="true">
        {t("dock.copyFailed")}
      </span>
    </button>
  ) : (
    <button
      class="dock-control"
      type="button"
      aria-label={t("dock.copyLabel")}
      data-tip={t("dock.copyTooltip")}
    >
      <Icon name="email" />
    </button>
  )}
  <span
    class:list={["copy-email__feedback", { "copy-email__feedback--quiet": variant === "text" }]}
    role="status"
    aria-live="polite"
  ></span>
</copy-email>
<script>
  /** How long the result shows, in ms: a failure carries the address to copy by hand. */
  const SHOWN = { copied: 2000, failed: 6000 };

  /** The Clipboard API needs a secure page; without it, or if it refuses, the older copy command. */
  async function copy(text: string) {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      const field = document.createElement("textarea");
      const focused = document.activeElement;
      field.value = text;
      field.readOnly = true;
      field.style.cssText = "position: fixed; top: 0; opacity: 0; font-size: 16px";
      document.body.append(field);
      field.select();
      field.setSelectionRange(0, text.length);
      // Deprecated, and the only way to copy where the API is missing.
      const done = document.execCommand("copy");
      field.remove();
      if (focused instanceof HTMLElement) focused.focus({ preventScroll: true });
      return done;
    }
  }

  class CopyEmail extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector("button");
      const feedback = this.querySelector<HTMLElement>(".copy-email__feedback");
      let clear: ReturnType<typeof setTimeout> | undefined;
      button?.addEventListener("click", async () => {
        const result = (await copy(this.dataset["email"] ?? "")) ? "copied" : "failed";
        this.dataset["result"] = result;
        if (feedback) feedback.textContent = this.dataset[result] ?? "";
        // A new press restarts the time, so an older timer never clears the newer message.
        clearTimeout(clear);
        clear = setTimeout(() => {
          delete this.dataset["result"];
          if (feedback) feedback.textContent = "";
        }, SHOWN[result]);
      });
    }
  }
  if (!customElements.get("copy-email")) customElements.define("copy-email", CopyEmail);
</script>
<style>
  copy-email {
    --_focus-width: 2px;
    --_feedback-bottom: 88px;
    --_feedback-padding: 10px 14px;

    position: relative;
    display: inline-flex;
  }
  /* Looks like the footer's other action, a link. */
  .copy-email__text {
    display: inline-grid;
    align-items: center;
    justify-items: start;
    min-height: var(--_row, 44px);
    padding: 0;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-text-secondary);
    font: inherit;
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-out);
  }
  /* The three labels share one place, so the button keeps its width when the label changes. */
  .copy-email__label {
    grid-area: 1 / 1;
    text-decoration: underline 1px var(--color-border);
    text-underline-offset: 5px;
  }
  .copy-email__label--copied,
  .copy-email__label--failed,
  [data-result] .copy-email__label {
    visibility: hidden;
    text-decoration: none;
  }
  [data-result="copied"] .copy-email__label--copied,
  [data-result="failed"] .copy-email__label--failed {
    visibility: visible;
  }
  @media (hover: hover) {
    .copy-email__text:hover {
      color: var(--color-text-accent);
    }
  }
  .copy-email__text:focus-visible {
    outline: var(--_focus-width) solid var(--color-text-accent);
    outline-offset: var(--_focus-width);
  }
  .copy-email__feedback:not(:empty) {
    --_feedback-max: calc(100vw - 32px);
    /* The Dock, not the window, holds it (its transform): without its own width it would wrap to half the Dock. */
    width: max-content;
    max-width: var(--_feedback-max);
    overflow-wrap: anywhere;
    position: fixed;
    bottom: var(--_feedback-bottom);
    left: 50%;
    transform: translateX(-50%);
    white-space: normal;
    background: var(--color-text);
    color: var(--color-bg);
    font: 500 var(--font-size-small) / var(--line-height-compact) var(--font-sans);
    text-align: center;
    padding: var(--_feedback-padding);
    border-radius: 20px;
  }
  /* The result takes the tooltip's place. */
  copy-email[data-result] .dock-control::after {
    visibility: hidden;
  }
  /* Where the button itself shows the result, the status is only read out. */
  .copy-email__feedback--quiet,
  .copy-email__feedback--quiet:not(:empty) {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: reduce) {
    .copy-email__text {
      transition: none;
    }
  }
</style>
