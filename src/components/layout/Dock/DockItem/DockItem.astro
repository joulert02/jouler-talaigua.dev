---
import Icon from "../../../ui/Icon/Icon.astro";
import type { NavigationItem } from "../../../../config/navigation";
import { getLang, localePath, useTranslations } from "../../../../i18n/ui";
interface Props {
  item: NavigationItem;
  /** Whether this item is the current page; the Dock sets it from its own `current`. */
  current?: boolean;
}
const { item, current = false } = Astro.props;
const lang = getLang(Astro);
const label = useTranslations(lang)(item.labelKey);
---

<a
  class="dock-control dock__item"
  href={localePath(lang, item.href)}
  data-tip={label}
  aria-current={current ? "page" : undefined}
>
  <Icon name={item.icon} />
  <span class="dock__label">
    <span>{label}</span>
  </span>
</a>
<style>
  .dock__item {
    --_compact-padding: 7px;
    --_compact-label-size: var(--font-size-small);
    --_compact-icon-size: 17px;
    gap: var(--space-2);
    font: 500 var(--font-size-small)/1 var(--font-sans);
    text-decoration: none;
    white-space: nowrap;
  }
  .dock__item[aria-current="page"] {
    background: var(--color-surface-hover);
    color: var(--color-text);
  }
  @media (max-width: 560px) {
    .dock__item {
      padding: 0 var(--_compact-padding);
      gap: var(--space-1);
    }
    .dock__item span {
      font-size: var(--_compact-label-size);
    }
    .dock__item :global(svg) {
      width: var(--_compact-icon-size);
      height: var(--_compact-icon-size);
    }
  }
  @container dock (max-width: 560px) {
    .dock__item {
      padding: 0 var(--_compact-padding);
      gap: var(--space-1);
    }
    .dock__item span {
      font-size: var(--_compact-label-size);
    }
    .dock__item :global(svg) {
      width: var(--_compact-icon-size);
      height: var(--_compact-icon-size);
    }
  }
</style>
