---
import Icon from "../../../ui/Icon/Icon.astro";
import type { NavigationItem } from "../../../../config/navigation";
import { getLang, localePath, useTranslations } from "../../../../i18n/ui";
interface Props {
  item: NavigationItem;
  /** Whether this item is the current page; the Dock sets it from its own `current`. */
  current?: boolean;
}
const { item, current = false } = Astro.props;
const lang = getLang(Astro);
const label = useTranslations(lang)(item.labelKey);
---

<a
  class="dock__item"
  href={localePath(lang, item.href)}
  data-tip={label}
  aria-current={current ? "page" : undefined}
>
  <Icon name={item.icon} />
  <span class="dock__label">
    <span>{label}</span>
  </span>
</a>
<style>
  .dock__item {
    --_target-size: 44px;
    --_focus-width: 2px;
    --_compact-padding: 7px;
    --_compact-label-size: 13px;
    --_compact-icon-size: 17px;

    --_duration: 180ms;
    --_tip-gap: 10px;
    --_tip-size: 12.5px;
    --_tip-padding: 7px 9px;
    position: relative;
    box-sizing: border-box;
    min-width: var(--_target-size);
    height: var(--_target-size);
    padding: 0 var(--space-3);
    border-radius: var(--radius-lg);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    color: var(--color-text-muted);
    font: 500 var(--font-size-small)/1 var(--font-sans);
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color var(--_duration) var(--ease-out),
      color var(--_duration) var(--ease-out);
  }
  .dock__item:hover,
  .dock__item[aria-current="page"] {
    background: var(--color-surface-hover);
    color: var(--color-text);
  }
  .dock__item:focus-visible {
    outline: var(--_focus-width) solid var(--color-text-accent);
    outline-offset: var(--_focus-width);
  }
  @media (max-width: 560px) {
    .dock__item {
      padding: 0 var(--_compact-padding);
      gap: var(--space-1);
    }
    .dock__item span {
      font-size: var(--_compact-label-size);
    }
    .dock__item :global(svg) {
      width: var(--_compact-icon-size);
      height: var(--_compact-icon-size);
    }
  }
  @container dock (max-width: 560px) {
    .dock__item {
      padding: 0 var(--_compact-padding);
      gap: var(--space-1);
    }
    .dock__item span {
      font-size: var(--_compact-label-size);
    }
    .dock__item :global(svg) {
      width: var(--_compact-icon-size);
      height: var(--_compact-icon-size);
    }
  }
  .dock__item::after {
    content: attr(data-tip);
    position: absolute;
    bottom: calc(100% + var(--_tip-gap));
    left: 50%;
    transform: translate(-50%, 4px);
    white-space: nowrap;
    background: var(--color-text);
    color: var(--color-bg);
    font: 500 var(--_tip-size)/1 var(--font-sans);
    padding: var(--_tip-padding);
    border-radius: var(--radius-md);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }
  @media (prefers-reduced-motion: reduce) {
    .dock__item,
    .dock__item::after {
      transition: none;
    }
  }
</style>
