{
  "name": "jouler-talaigua-dev",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "astro dev",
    "design": "echo 'Design v11 (sealed): http://127.0.0.1:4326/design/' && python3 -m http.server 4326 --bind 0.0.0.0 --directory docs",
    "storybook": "storybook dev",
    "board:layout": "storybook dev --initial-path='/story/components-board-boardlayout--layout-editor&full=1'",
    "build-storybook": "storybook build --output-dir dist/storybook",
    "build": "node scripts/check-placeholders.mjs && astro build && node scripts/check-seo.mjs && npm run build-storybook",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "npm run format:check && npm run lint && npm run test && npm run check && npm run build",
    "test": "node --test \"scripts/*.test.mjs\"",
    "placeholders": "node scripts/check-placeholders.mjs",
    "test:a11y": "playwright test",
    "test:voiceover": "playwright test --config playwright.voiceover.config.ts",
    "voiceover:setup": "guidepup setup --macos-ignore-tcc-db && guidepup install"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/react": "^7.0.0",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/inter": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "satori": "^0.33.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/onest": "^5.3.1",
    "@guidepup/guidepup": "^0.40.0",
    "@guidepup/playwright": "^0.21.0",
    "@guidepup/setup": "^0.29.3",
    "@playwright/test": "^1.65.1",
    "@storybook-astro/framework": "^1.14.0",
    "@storybook-astro/renderer": "1.14.0",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-mcp": "^10.6.5",
    "@storybook/builder-vite": "^10.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "storybook": "^10.6.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "wrangler": "^4.155.0"
  }
}
