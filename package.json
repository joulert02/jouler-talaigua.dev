{
  "name": "jouler-talaigua-dev",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "astro dev",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --output-dir dist/storybook",
    "build": "node scripts/check-placeholders.mjs && astro build && npm run build-storybook",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "npm run format:check && npm run lint && npm run test && npm run check && npm run build",
    "test": "node --test scripts/",
    "placeholders": "node scripts/check-placeholders.mjs"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/react": "^7.0.0",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/inter": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "satori": "^0.33.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@storybook-astro/framework": "^1.14.0",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/builder-vite": "^10.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "storybook": "^10.6.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "wrangler": "^4.155.0"
  }
}
