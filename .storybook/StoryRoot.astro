---
// Root of every story, set as the project `render` in preview.js. It renders the story's component itself (not a
// decorator around it, which storybook-astro renders in a separate pass), so what it sets reaches every component:
// - the page language (the `locale` control, .storybook/locale.js), read by getLang(Astro) as the route's locale is on
//   the site;
// - links that stay in the story: a click only follows an in-page link whose target exists (SkipLink's #main).
import type { Lang } from "../src/i18n/ui";
interface Props {
  lang: Lang;
  // eslint-disable-next-line @typescript-eslint/no-explicit-any -- any Astro component
  component: any;
  props: Record<string, unknown>;
  /** Names of the story's slots (its `slots` arg), which arrive here as StoryRoot's own slots. */
  slotNames?: string[];
}
const { lang, component: Component, props, slotNames = [] } = Astro.props;
Astro.locals.lang = lang;
// The story's slot (its `slots` arg), handed to the component under the same name, e.g. Vinyl's `sleeve`. One only:
// Astro needs each slot name written out in the template (a name from a loop is out of scope there).
if (slotNames.length > 1) {
  throw new Error(`StoryRoot hands on one slot per story; this one has ${slotNames.join(", ")}.`);
}
const [slot] = slotNames;
const slotHtml = slot ? await Astro.slots.render(slot) : "";
---

<story-root>
  {slot ? (
    <Component {...props}>
      <Fragment slot={slot} set:html={slotHtml} />
    </Component>
  ) : (
    <Component {...props} />
  )}
</story-root>
<script>
  class StoryRoot extends HTMLElement {
    connectedCallback() {
      this.addEventListener("click", (event) => {
        const link = event.target instanceof Element ? event.target.closest("a[href]") : null;
        const href = link?.getAttribute("href") ?? "";
        const inPage =
          href.startsWith("#") && href.length > 1 && document.getElementById(href.slice(1)) !== null;
        if (link && !inPage) event.preventDefault();
      });
    }
  }
  if (!customElements.get("story-root")) customElements.define("story-root", StoryRoot);
</script>
<style>
  story-root {
    display: contents;
  }
</style>
